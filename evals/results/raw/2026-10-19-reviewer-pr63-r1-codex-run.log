  /**
   * Register or remove the Windows login entry.
   *
   * The arguments are decided by `planLoginItem`, which is pure and therefore
   * tested: they have to include the auto-start flag, or the app cannot tell a login
   * launch from the user opening it. Only Windows is touched — on macOS the same
   * call manages a Login Item through the system, which a development run must not
   * do to the developer's machine.
   */
  private applyLoginItem(enabled: boolean, context: string): void {
    // A forced first-run session saves nothing, the Run key included.
    if (this.firstRun.sandbox) return;
    const plan = planLoginItem({
      enabled,
      platform: process.platform,
      isPackaged: app.isPackaged,
      execPath: process.execPath,
      appPath: app.getAppPath(),
    });

    if (!plan.apply) {
      if (enabled) {
        // Worth a line in the log: the switch reads as on in Settings while nothing
        // has been registered, which is confusing unless the reason is recorded.
        this.diagnostics.log('login', `${context}: login entry not managed on ${process.platform}`);
      }
      return;
    }

    try {
      app.setLoginItemSettings(plan.settings);
    } catch (error) {
      this.diagnostics.log('login', `${context}: could not update the login entry: ${(error as Error).message}`);
      return;
    }

    // Read back with the same path and args, because that is how Electron compares
    // the stored command line. A mismatch means the write did not take (a locked-down
    // policy, or another tool rewriting the Run key), and without this check "Start
    // with Windows" would be a switch that silently does nothing.
    const registered = app.getLoginItemSettings(plan.settings).openAtLogin;
    if (registered !== plan.settings.openAtLogin) {
      this.diagnostics.log(
        'login',
        `${context}: login entry is ${registered ? 'present' : 'absent'} after asking for ${plan.settings.openAtLogin} (${plan.reason})`,
      );
    }
  }

  // ---- lifecycle ---------------------------------------------------------

  private createRecorderWindow(): void {
    // Hidden, never shown: it exists only to host Web Audio capture. It is kept
    // alive so the microphone permission grant persists and recording starts
    // instantly rather than waiting for a renderer to boot.
    this.recorderWindow = new BrowserWindow({
      show: false,
      width: 400,
      updateReady: this.updater?.ready ?? undefined,
    });
  }

  /** The tray's "Restart to update". Held while a dictation is running or waiting for retry. */
  private restartToUpdate(): void {
    const state = this.service.currentState;
    if (this.service.canRetry || state === 'recording' || state === 'transcribing' || state === 'delivering') {
      this.diagnostics.log('update', `restart held: dictation ${state}, retry pending ${this.service.canRetry}`);
      return;
    }
    void this.quit({ restartToUpdate: true });
  }

  /**
   * Asks the main window to save a note edit still inside its autosave delay, waiting at most
   * a second. Windows are destroyed right after, which fires no `pagehide`. Never throws.
   */
  private async saveRendererDrafts(): Promise<void> {
    const window = this.mainWindow;
    if (!window || window.isDestroyed()) return;
    let timer: NodeJS.Timeout | undefined;
    try {
      const outcome = await Promise.race([
        window.webContents.executeJavaScript(
          "typeof window.__uvFlushPending === 'function' ? window.__uvFlushPending() : true",
        ) as Promise<unknown>,
        new Promise<'timeout'>((resolve) => {
          timer = setTimeout(() => resolve('timeout'), 1000);
        }),
      ]);
      if (outcome === 'timeout') this.diagnostics.log('app', 'quit: note draft not saved (timed out after 1 s)');
      else if (outcome === false) this.diagnostics.log('app', 'quit: note draft not saved (the save was refused)');
    } catch (error) {
      this.diagnostics.log('app', `could not save pending note edits: ${error instanceof Error ? error.message : String(error)}`);
    } finally {
      if (timer) clearTimeout(timer);
    }
  }

  quit(options: { restartToUpdate?: boolean } = {}): Promise<void> {
    this.quitting ??= this.runQuit(options);
    return this.quitting;
  }

  private async runQuit(options: { restartToUpdate?: boolean }): Promise<void> {
    try {
      await this.service.cancel();
      await this.saveRendererDrafts();
      // Always give the data a chance to reach disk before exiting: a debounced
      // save that never fires would lose the user's last dictionary edit.
      await this.data.flush();
      await this.settings.save();
      // Never rejects (the chain catches), so a HUD drag just before Quit still lands.
      await this.hudPositionWrite;
      await this.diagnostics.flush();
    } finally {
      globalShortcut.unregisterAll();
      stopPowerShellHost();
      this.tray?.destroy();
      // `app.exit` skips the quit events electron-updater listens for, so a downloaded
      // update is handed to its installer here, on every quit.
      const restart = options.restartToUpdate === true;
      const updateReady = this.updater?.ready;
      // The data is flushed, so nothing may start a dictation or an edit while the installer
      // is checked below: close every window (the app has no window-all-closed quit).
      if (updateReady) for (const window of BrowserWindow.getAllWindows()) window.destroy();
      // Its own file, appended synchronously: diagnostics.log is rewritten by the next
      // launch, which is seconds away on both paths, and nothing async survives `app.exit`.
      // The first line goes in before the restart wait, which the installer can cut short.
      const updateLog = (line: string): void => {
        try {
          appendFileSync(path.join(app.getPath('userData'), 'update.log'), `${new Date().toISOString()} ${line}\n`);
        } catch {
          // The log is a diagnostic aid only.
        }
   */
  private async toggleDictation(requested: DictationSource): Promise<void> {
    // Once the quit has begun nothing may start recording: the flush and the window teardown
    // below would race it.
    if (this.quitting) return;
    // While the setup flow is open the hotkey dictates into the flow's own field, never
    // into the app in front.
    const source: DictationSource = requested === 'hotkey' && this.firstRun.open ? 'window' : requested;
    this.lastToggleSource = source;
    // A press while the recorder is still starting is a stop, not another start.
    const state = this.service.currentState;
    const starts = (state === 'idle' || state === 'error') && !this.service.isStarting;
    // A dictation that starts while the flow is open is the flow's practice dictation.
    if (this.firstRun.open && starts) this.practiceActive = true;
    let startedInOwnWindow: boolean | undefined;
    if (starts) this.recordingHandle = undefined;
    if (source === 'hotkey' && starts) {
      // A paste lands wherever the cursor is when the text is ready, so the window in
      // front now is not recorded as a destination. Only "did it begin in our window"
      // matters, and Electron knows that without asking Windows.
      startedInOwnWindow = BrowserWindow.getFocusedWindow() !== null;
      this.lookUpTargetApp(++this.dictationStarts);
    }
    await this.service.toggle({ source, startedInOwnWindow });
    void this.data.flush();
  }

  /** Name the app a hotkey dictation started over, without making the recorder wait for it. */
  private lookUpTargetApp(start: number): void {
    void foregroundWindow().then((target) => {
      // Another dictation has begun since, or this one is over: the answer is stale.
      if (!target || start !== this.dictationStarts) return;
      const state = this.service.currentState;
      if (state !== 'recording' && !this.service.isStarting) return;
      const label = target.title || target.processName;
      this.recordingHandle = target.handle;
      this.service.setTargetApp(label);
      if (state === 'recording') {
        this.recordingTarget = label;
        this.syncTray();
      }
    });
  }

  /**
   * Esc cancels a dictation, and is a global shortcut only while one can still be
   * cancelled (recording or transcribing). Registered for the whole session it would
   * swallow Esc in every other app.
   */
  private syncEscapeShortcut(recording: boolean): void {
    // The language picker needs Esc for itself while it is open.
    // A picker that is closing is already gone for the user, so Esc is theirs to cancel with again.
    const pickerOpen =
      this.pickerWindow !== null && !this.pickerWindow.isDestroyed() && this.pickerWindow.isVisible() && !this.pickerClosing;
    recording = recording && !pickerOpen;
    if (recording && !this.escapeRegistered) {
      this.escapeRegistered = globalShortcut.register('Escape', () => void this.cancelDictation());
      if (!this.escapeRegistered) this.diagnostics.log('hotkey', 'could not register Escape');
    } else if (!recording && this.escapeRegistered) {
      globalShortcut.unregister('Escape');
      this.escapeRegistered = false;
    }
  }

  /**
   * Cancel whatever is running. During delivery the sink stops before the paste if it
   * still can; a paste that already went out is not undone, and the dictation finishes
   * as delivered (the user can still press Ctrl+Z in the app).
   */
  private async cancelDictation(): Promise<void> {
    await this.service.cancel();
  }

  /**
   * Put the text where the user is working.
   *
   * The contract: the text is ALWAYS available afterwards, either pasted or on the
   * clipboard. The macOS version restored the previous clipboard contents on a
   * timer that could fire before the paste landed, destroying the dictation — so
   * the restore here is gated (see `decideClipboardRestore`): the keystroke went out,
   * focus stayed, and the clipboard still holds our text. Otherwise the text stays on
   * the clipboard.
   *
   * The ordering rules (never paste after an abort, when to restore) live in
   * `deliverText`, so they are testable without Electron; this only supplies the ports.
   */
  private deliver(request: DeliveryRequest): Promise<DeliveryResult> {
    return deliverText(request, {
      writeText: (text) => clipboard.writeText(text),
      snapshot: snapshotClipboard,
      restore: restoreClipboard,
      holdsText: clipboardHoldsText,
      foregroundWindow,
      pasteKeystroke: (signal) => pasteClipboard(signal),
      // Synchronous: one of our windows has focus. The HUD is not focusable, so it never counts.
      ownWindowInFront: () => BrowserWindow.getFocusedWindow() !== null,
      delay,
      log: (category, message) => this.diagnostics.log(category, message),
    });
  }

  /** The newest dictation still in the history, so a deleted one is never copied back. */
  private copyLastTranscript(): void {
    const newest = this.data.history[0];
    if (!newest) return;
    clipboard.writeText(newest.text);
  }

  // ---- windows and IPC ---------------------------------------------------

  /**
   * Bring everything the OS draws in line with the resolved theme, and tell the pages.
   *
   * Runs on `nativeTheme` 'updated', which fires both when the user changes the
   * Appearance setting (`themeSource`) and when Windows flips between light and dark
   * while the setting is System.
   */
  private syncTheme(): void {
    const theme = resolvedTheme();
    const window = this.mainWindow;
    if (window && !window.isDestroyed()) {
      window.setBackgroundColor(canvasColor(theme));
      // Documented for win32 and linux only, where the overlay exists.
      if (process.platform !== 'darwin') window.setTitleBarOverlay(titleBarOverlayFor(theme));
    }
    this.broadcast('app:theme', theme);
  }

  private broadcast(channel: string, payload?: unknown): void {
    for (const window of [this.mainWindow, this.recorderWindow, this.hudWindow, this.pickerWindow]) {
      if (window && !window.isDestroyed()) {
        window.webContents.send(channel, payload);
      }
    }
  }


