export interface TrayHandlers {
  onToggleDictation: () => void;
  onOpenWindow: (page: string) => void;
  onQuit: () => void;
  onRetry: () => void;
  onCopyLast: () => void;
  onCancel: () => void;
  /** A language was picked in the Language submenu. */
  onSetLanguage: (code: string) => void;
  onSetFormatting: (enabled: boolean) => void;
