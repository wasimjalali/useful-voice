   900	/** Whitespace-separated tokens, which is what "24 words" means in the done line. */
   901	export function countWords(text: string): number {
   902	  return text.split(/\s+/).filter((token) => token.length > 0).length;
   903	}
   904	
   905	function defaultId(): string {
   906	  return globalThis.crypto.randomUUID();
   907	}
   908	
   909	/**
   910	 * Turn a recording failure into something the user can act on.
   911	 *
   912	 * The macOS build surfaced the raw `localizedDescription` of an unlocalized enum,
   913	 * so users saw "The operation couldn't be completed. (UsefulVoiceCore.
   914	 * AudioRecorderError error 4.)" — a message that names neither the cause nor the
   915	 * remedy.
   916	 */
   917	export function classifyRecordingFailure(error: unknown): DictationError {
   918	  // Every way the microphone can fail to start is fixed in the same place.
   919	  return { kind: 'micUnavailable', message: describeRecordingFailure(error), fix: 'openMicrophoneSettings' };
   920	}
   921	
   922	export function describeRecordingFailure(error: unknown): string {
   923	  const raw = describe(error).toLowerCase();
   924	  if (raw.includes('permission') || raw.includes('denied') || raw.includes('notallowed')) {
   925	    return 'Microphone access is blocked. Turn it on in Windows Settings > Privacy & security > Microphone.';
   926	  }
   927	  if (raw.includes('notfound') || raw.includes('devicenotfound')) {
   928	    return 'No microphone was found. Connect one and check Windows Settings > System > Sound > Input.';
   929	  }
   930	  if (raw.includes('notreadable') || raw.includes('trackstarterror')) {
   931	    return 'The microphone is in use by another app. Close it, or pick a different input device.';
   932	  }
   933	  return `Recording could not start: ${describe(error)}`;
   934	}
   935	
   936	/** Turn a transcription failure into a typed error with the fix the UI should offer. */
   937	export function classifyTranscriptionFailure(error: unknown): DictationError {
   938	  const message = transcriptionFailureMessage(error);
   939	  if (error instanceof ProviderError) {
   940	    switch (error.kind) {
   941	      case 'unauthorized':
   942	        return { kind: 'keyRejected', message, fix: 'openEngineSettings' };
   943	      case 'outOfCredits':
   944	        return { kind: 'outOfCredits', message, fix: 'openEngineSettings' };
   945	      case 'transport':
   946	        return { kind: 'offline', message, fix: 'retry' };
   947	      case 'timedOut':
   948	        return { kind: 'timedOut', message, fix: 'retry' };
   949	      // A request the provider rejected fails identically forever, so it gets no retry.
   950	      case 'badRequest':
   951	        return { kind: 'providerFailed', message };
   952	      case 'rateLimited':
   953	      case 'serverError':
   954	      case 'malformedResponse':
   955	      case 'cancelled':
   956	        return { kind: 'providerFailed', message, fix: 'retry' };
   957	    }
   958	  }
   959	  return { kind: 'providerFailed', message, fix: 'retry' };
   960	}
   961	
   962	/** Turn a transcription failure into something the user can act on. */
   963	export function describeTranscriptionFailure(error: unknown): string {
   964	  return transcriptionFailureMessage(error);
   965	}
   966	
   967	function transcriptionFailureMessage(error: unknown): string {
   968	  if (error instanceof ProviderError) {
   969	    switch (error.kind) {
   970	      case 'unauthorized':
   971	        return 'Deepgram rejected your API key. Check it in Settings.';
   972	      case 'rateLimited':
   973	        return 'Deepgram is rate limiting requests. Try again in a moment.';
   974	      case 'timedOut':
   975	        return 'Transcription timed out. Check your internet connection and try again.';
   976	      case 'transport':
   977	        return 'Could not reach Deepgram. Check your internet connection.';
   978	      case 'badRequest':
   979	        // The provider's message is already bounded and has the key redacted.
   980	        return error.message;
   981	      case 'outOfCredits':
