   440	async function runPowerShell(
   441	  script: string,
   442	  timeoutMs = 8000,
   443	  signal?: AbortSignal,
   444	): Promise<{ stdout: string; stderr: string }> {
   445	  const result = await execFileAsync(
   446	    'powershell.exe',
   447	    ['-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-Command', script],
   448	    // `signal` kills the child when it aborts, so a script that has not run yet never does.
   449	    { timeout: timeoutMs, windowsHide: true, maxBuffer: 1024 * 1024, signal },
   450	  );
   451	  return { stdout: result.stdout ?? '', stderr: result.stderr ?? '' };
   452	}

