    94	/** The few clipboard operations the restore needs, so it runs against a fake in tests. */
    95	export interface ClipboardPort {
    96	  clear(): void;
    97	  write(entry: { text?: string; html?: string; rtf?: string }): void;
    98	  readText(): string;
    99	  readHTML(): string;
   100	  readRTF(): string;
   101	}
   102	
   103	export type RestoreOutcome =
   104	  /** The clipboard holds the original again. */
   105	  | 'restored'
   106	  /** Nothing restorable was captured; the clipboard was not touched. */
   107	  | 'nothing-to-restore'
   108	  /** The restore failed, and the dictation was put back so it is not lost. */
   109	  | 'failed-kept-dictation'
   110	  /** The restore failed and the dictation could not be put back either. */
   111	  | 'failed-lost';
