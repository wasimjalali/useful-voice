   113	/**
   114	 * Put a snapshot back, and never leave the clipboard worse than the dictation.
   115	 *
   116	 * `clear()` is not atomic with the write that follows, so a failed write would leave
   117	 * the clipboard empty and lose both the user's data and the dictation. When the write
   118	 * fails or reads back wrong, the dictation text is written back instead.
   119	 */
   120	export function restoreSnapshotTo(
   121	  port: ClipboardPort,
   122	  snapshot: ClipboardContents,
   123	  dictationText: string,
   124	): RestoreOutcome {
   125	  const entry: { text?: string; html?: string; rtf?: string } = {};
   126	  if (snapshot.text.length > 0) entry.text = snapshot.text;
   127	  if (snapshot.html.length > 0) entry.html = snapshot.html;
   128	  if (snapshot.rtf.length > 0) entry.rtf = snapshot.rtf;
   129	  if (Object.keys(entry).length === 0) return 'nothing-to-restore';
   130	
   131	  try {
   132	    port.clear();
   133	    port.write(entry);
   134	    const verified =
   135	      snapshot.text.length > 0
   136	        ? port.readText() === snapshot.text
   137	        : snapshot.html.length > 0
   138	          ? port.readHTML().length > 0
   139	          : port.readRTF().length > 0;
   140	    if (verified) return 'restored';
   141	  } catch {
   142	    // Fall through: the clipboard may be empty or half written.
   143	  }
   144	
   145	  try {
   146	    port.clear();
   147	    port.write({ text: dictationText });
   148	    return 'failed-kept-dictation';
   149	  } catch {
   150	    return 'failed-lost';
   151	  }
   152	}

