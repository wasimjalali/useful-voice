   416	/**
   417	 * Start the long-lived PowerShell host. Call at app ready: the first hotkey press then
   418	 * finds the C# already compiled. Resolves false (and the app keeps using one-shot
   419	 * processes) off Windows or when the host cannot start.
   420	 */
   421	export async function startPowerShellHost(log?: (message: string) => void): Promise<boolean> {
   422	  if (process.platform !== 'win32') return false;
   423	  if (!host) {
   424	    host = new PowerShellHost({
   425	      spawn: () =>
   426	        spawn('powershell.exe', hostArguments(), { windowsHide: true, stdio: ['pipe', 'pipe', 'pipe'] }),
   427	      setupScript: HOST_SETUP,
   428	      log,
   429	    });
   430	  }
   431	  return host.start();
