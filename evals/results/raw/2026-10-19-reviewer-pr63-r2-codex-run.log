   457	  }
   458	
   459	  /** Retry the last failure, re-uploading the retained audio. The result is copied, never pasted. */
   460	  async retryLast(): Promise<void> {
   461	    const failed = this.lastFailed;
   462	    if (!failed) return;
   463	    if (this.isBusy || this.session !== null || this.starting) return;
   464	    this.lastFailed = null;
   465	    // The window it came from may be long gone, so a retry always saves and copies.
   466	    const session: Session = { source: 'window', rawMode: false, delivered: false, stopping: true, settled: false };
   467	    this.session = session;
   468	    await this.run(session, () => this.process(session, failed.audio, failed.language));
   469	  }
   470	
   471	  /** Forget the audio kept for a retry, for instance when the history is cleared. */
   472	  discardRetained(): void {
   473	    this.lastFailed = null;
   474	  }
   475	
   476	  /**
   477	   * Feed one input level sample (the 0 to 1 meter level) while recording.
   478	   *
   479	   * Updates what the silence watchdog has heard and forwards the level to the window
   480	   * and HUD at no more than ~30 Hz. Ignored unless a recording is running.
   481	   */
   482	  reportLevel(level: number): void {
   483	    if (!this.isRecordingLive() || !this.watchdog || !Number.isFinite(level)) return;
   484	    this.lastLevel = Math.max(0, Math.min(1, level));
   485	    this.watchdog.observe(this.lastLevel / LEVEL_METER_GAIN, this.clock.elapsedSeconds());
   486	    this.emitTelemetry();
   487	  }
   488	
   489	  /**
   490	   * The recorder reported an error while a recording was live (the device was
   491	   * unplugged, access was revoked). Ends the dictation as a microphone problem.
   492	   * Ignored when no recording is live: a stop reports its own failure.
   493	   */
   494	  async recorderFailed(error: unknown): Promise<void> {
   495	    const session = this.session;
   496	    if (!this.isRecordingLive() || !session) return;
   497	    session.stopping = true;
   498	    this.stopMonitoring();
   499	    this.clock.stop();
   500	    await this.deps.recorder.cancel().catch(() => undefined);
   501	    this.fail(session, classifyRecordingFailure(error));
   502	  }
   503	
   504	  /**
   505	   * Run the pipeline so that nothing a callback throws can leave the session stuck in
   506	   * transcribing or delivering. Whatever escapes ends the dictation as an error.
   507	   */
   508	  private async run(session: Session, work: () => Promise<void>): Promise<void> {
   509	    const task = (async () => {
   510	      try {
   511	        await work();
   512	      } catch (error) {
   513	        this.deps.onDiagnostic?.('dictation', `unexpected failure: ${describe(error)}`);
   514	        try {
   515	          this.fail(
   516	            session,
   517	            session.delivered
   518	              ? // The text is already where it was going. Only the bookkeeping failed.
   519	                { kind: 'saveFailed', message: 'Delivered, but it could not be saved to your history.' }
   520	              : { kind: 'providerFailed', message: `The dictation failed unexpectedly: ${describe(error)}` },
   521	          );
   522	        } catch (listenerError) {
   523	          // The status listener threw as well. The state is already released.
   524	          this.deps.onDiagnostic?.('dictation', `status listener failed: ${describe(listenerError)}`);
   525	        }
   526	      }
   527	    })();
   528	    this.processing = task;
   529	    try {
   530	      await task;
   531	    } finally {
   532	      if (this.processing === task) this.processing = null;
   533	    }
   534	  }
   535	
   536	  private isRecordingLive(): boolean {
   537	    return this.state === 'recording' && this.session !== null && !this.session.stopping;
   538	  }
   539	
   540	  private startMonitoring(silenceTimeoutSeconds: number): void {
   541	    this.stopMonitoring();
   542	    this.watchdog = new SilenceWatchdog({ timeoutSeconds: silenceTimeoutSeconds });
   543	    this.lastLevel = 0;
   544	    this.lastTelemetryAt = null;
   545	    this.ticker = setInterval(() => this.tick(), this.deps.tickMs ?? DEFAULT_TICK_MS);
   546	    this.ticker.unref?.();
   547	  }
   548	
   549	  private stopMonitoring(): void {
   550	    if (this.ticker) clearInterval(this.ticker);
   551	    this.ticker = null;
   552	    this.watchdog = null;
   553	  }
   554	
   555	  /**
   556	   * Enforce the two limits from the clock, not from audio frames: a device that stops
   557	   * delivering buffers must still hit the silence limit and the hard cap.
   558	   */
   559	  private tick(): void {
   560	    if (!this.isRecordingLive() || !this.watchdog) return;
   561	    if (this.clock.isOverLimit()) {
   562	      void this.forceStop('The recording limit was reached and the recording could not be saved.').catch((error) =>
   563	        this.deps.onDiagnostic?.('dictation', `max-length stop failed: ${describe(error)}`),
   564	      );
   565	      return;
   566	    }
   567	    if (this.watchdog.isExpired(this.clock.elapsedSeconds())) {
   568	      void this.stopAndProcess().catch((error) =>
   569	        this.deps.onDiagnostic?.('dictation', `silence stop failed: ${describe(error)}`),
   570	      );
   571	      return;
   572	    }
   573	    this.emitTelemetry();
   574	  }
   575	
   576	  private emitTelemetry(): void {
   577	    if (!this.deps.onTelemetry || !this.watchdog) return;
   578	    const now = this.nowFn()();
   579	    if (this.lastTelemetryAt !== null && now - this.lastTelemetryAt < TELEMETRY_MIN_INTERVAL_MS) return;
   580	    this.lastTelemetryAt = now;
   581	
   582	    const elapsed = this.clock.elapsedSeconds();
   583	    const telemetry: DictationTelemetry = { level: this.lastLevel, elapsedSeconds: elapsed };
   584	
   585	    // Silence counts down only once it has actually started, so a short limit does
   586	    // not show a countdown to someone who is speaking.
   587	    const untilSilenceStop = this.watchdog.secondsUntilStop(elapsed);
   588	    if (
   589	      untilSilenceStop !== null &&
   590	      untilSilenceStop <= COUNTDOWN_SECONDS &&
   591	      this.watchdog.silenceSeconds(elapsed) >= 1
   592	    ) {
   593	      telemetry.silenceRemaining = untilSilenceStop;
   594	    }
   595	    const untilMaxStop = Math.ceil(this.clock.remainingSeconds());
   596	    if (untilMaxStop <= COUNTDOWN_SECONDS) telemetry.maxRemaining = untilMaxStop;
   597	
   598	    this.deps.onTelemetry(telemetry);
   599	  }
   600	
   601	  private async process(session: Session, captured: CapturedAudio, language: MemoryLanguage): Promise<void> {
   602	    // The raw-mode flag belongs to the session, so it cannot outlive its dictation.
   603	    // The macOS version cleared a shared flag only on the success path, so every
   604	    // early return (too short, no provider, empty transcript) left it set and the
   605	    // NEXT dictation silently skipped formatting with no explanation.
   606	    const rawMode = session.rawMode;
   607	    const current = (): boolean => this.session === session;
   608	
   609	    const settings = this.deps.settings();
   610	
   611	    if (captured.wav.byteLength < MINIMUM_AUDIO_BYTES) {
   612	      this.fail(session, { kind: 'tooShort', message: 'Recording was too short. Hold the hotkey a moment longer.' });
   613	      return;
   614	    }
   615	    // A silent clip can make a speech model echo its prompt bias back as a fake
   616	    // transcript, so it is rejected before any upload.
   617	    if (!captured.hadSpeech) {
   618	      this.fail(session, { kind: 'noSpeech', message: 'No speech detected. Check your microphone level and try again.' });
   619	      return;
   620	    }
   621	
   622	    const apiKey = await this.deps.apiKey();
   623	    if (!current()) return;
   624	    if (!apiKey) {
   625	      this.retain(captured, language);
   626	      this.fail(session, {
   627	        kind: 'noProvider',
   628	        message: 'No Deepgram API key is set. Add one in Settings to start dictating.',
   629	        fix: 'openEngineSettings',
   630	      });
   631	      return;
   632	    }
   633	
   634	    const snapshot = this.deps.memory();
   635	    const selection = selectKeyterms({
   636	      terms: snapshot.terms,
   637	      replacements: snapshot.replacements,
   638	      snippets: snapshot.snippets,
   639	      language,
   640	      budget: settings.dictionaryBiasBudget,
   641	    });
   642	
   643	    this.abortController = new AbortController();
   644	    this.setState('transcribing', undefined, session.targetApp);
   645	
   646	    let transcript: Transcript;
   647	    try {
   648	      transcript = await this.deps.transcriber.transcribe(
   649	        {
   650	          audio: captured.wav,
   651	          language,
   652	          keyterms: selection.terms,
   653	          smartFormat: settings.formattingEnabled,
   654	          spokenPunctuation: settings.spokenPunctuationEnabled,
   655	        },
   656	        this.abortController.signal,
   657	      );
   658	    } catch (error) {
   659	      // A cancelled upload ends here without a word: the cancel already reported it.
   660	      if (!current()) return;
   661	      // Keep the audio so Retry does not make the user dictate again.
   662	      this.retain(captured, language);
   663	      this.fail(session, classifyTranscriptionFailure(error));
   664	      return;
   665	    }
   666	    if (!current()) return;
   667	
   668	    const rawText = transcript.text.trim();
   669	    if (rawText.length === 0) {
   670	      this.fail(session, { kind: 'noSpeech', message: 'No speech was recognised in that recording.' });
   671	      return;
   672	    }
   673	
   674	    // What Deepgram detected decides the processing language — validated through
   675	    // the catalogue so a returned `de-CH` keeps its region while `de-DE` scopes
   676	    // as `de`. History stores the raw code, trimmed and stripped to tag
   677	    // characters so a hostile or malformed value cannot forge a shareable log
   678	    // line or a strange history row: an unknown detection is processed as
   679	    // `auto` (permissive rather than wrong-language) but recorded as reported,
   680	    // and is never sent back to the provider.
   681	    const rawDetected =
   682	      transcript.detectedLanguage
   683	        ?.trim()
   684	        .replace(/[^A-Za-z-]/g, '')
   685	        .slice(0, 35) || null;
   686	    const effectiveLanguage = rawDetected ? resolveDetectedLanguage(rawDetected) : language;
   687	    const storedLanguage = rawDetected ?? language;
   688	
   689	    // A detected code Nova-3 does not speak natively means the provider fell
   690	    // back down the model chain, which silently drops `keyterm` — and the
   691	    // symptom (the user's own terminology misspelled) reads as a dictionary
   692	    // fault, so it is worth a log line. Only the code is recorded, never
   693	    // transcript text or the key.
   694	    if (rawDetected && !detectionStayedOnNova3(rawDetected)) {
   695	      this.deps.onDiagnostic?.(
   696	        'dictation',
   697	        `detected language '${rawDetected}' is outside Nova-3, so the provider may have fallen back to a lower model and keyterms may have been dropped`,
   698	      );
   699	    }
   700	
   701	    // Deterministic memory pass: never skipped, even in raw mode. Raw mode means
   702	    // "do not run the formatter", not "do not apply the user's dictionary".
   703	    const memoryResult = applyMemory(rawText, snapshot, effectiveLanguage);
   704	
   705	    let finalText = memoryResult.text;
   706	    let mode: 'raw' | 'formatted' = 'raw';
   707	    if (!rawMode && settings.formattingEnabled && this.deps.formatter) {
   708	      try {
   709	        const formatted = await this.deps.formatter(memoryResult.text, effectiveLanguage);
   710	        if (formatted.trim().length > 0) {
   711	          const reApplied = applyMemory(formatted, snapshot, effectiveLanguage);
   712	          finalText = reApplied.text;
   713	          mode = 'formatted';
   714	        }
   715	      } catch {
   716	        // A formatter failure must never lose the dictation: fall back to the
   717	        // unformatted text, which is already correct.
   718	        mode = 'raw';
   719	      }
   720	      if (!current()) return;
   721	    }
   722	
   723	    if (finalText.trim().length === 0) {
   724	      this.fail(session, { kind: 'noSpeech', message: 'The transcript came back empty.' });
   725	      return;
   726	    }
   727	
   728	    // A hotkey dictation is pasted into the app it started in. Everything else (a
   729	    // window dictation, any retry) is saved and copied only.
   730	    const deliveryMode = session.source === 'hotkey' ? 'paste' : 'copy';
   731	    this.setState('delivering', undefined, session.targetApp);
   732	    const delivered = await this.deliver(finalText, deliveryMode, session);
   733	    if (!current()) return;
   734	    session.delivered = !delivered.cancelled && (delivered.delivered || delivered.clipboardFallback);
   735	    if (delivered.cancelled) {
   736	      // Esc arrived and the sink stopped before it pasted: nothing went out, so this
   737	      // dictation is abandoned and not recorded.
   738	      this.abortController = null;
   739	      this.emitOutcome(session, { kind: 'cancelled' });
   740	      this.session = null;
   741	      this.setState('idle');
   742	      return;
   743	    }
   744	
   745	    const outcome: DictationOutcome = {
   746	      id: (this.deps.idFactory ?? defaultId)(),
   747	      text: finalText,
   748	      rawText,
   749	      intermediateText: memoryResult.text,
   750	      language: storedLanguage,
   751	      appName: deliveryMode === 'paste' ? (session.targetApp ?? 'Unknown') : '',
   752	      durationSeconds: transcript.durationSeconds ?? captured.durationSeconds,
   753	      mode,
   754	      createdAt: new Date(this.nowFn()()).toISOString(),
   755	      replacementRuleIds: memoryResult.appliedRuleIds,
   756	      memoryHitIds: memoryResult.memoryHitIds,
   757	      snippetIds: memoryResult.appliedSnippetIds,
   758	    };
   759	    this.lastFailed = null;
   760	    this.abortController = null;
   761	    this.deps.onCompleted?.(outcome);
   762	
   763	    if (deliveryMode === 'copy') {
   764	      if (!delivered.delivered) {
   765	        // The text is safe in history, but it did not reach the clipboard, and saying
   766	        // "Saved and copied" would be a lie.
   767	        this.fail(session, {
   768	          kind: 'deliveryFailed',
   769	          message: 'Your dictation is saved in your history, but copying it to the clipboard failed.',
   770	        });
   771	        return;
   772	      }
   773	      this.finish(session, finalText, 'copied');
   774	      return;
   775	    }
   776	    if (delivered.delivered) {
   777	      this.finish(session, finalText, 'pasted', session.targetApp);
   778	      return;
   779	    }
   780	    if (delivered.clipboardFallback) {
   781	      this.finish(session, finalText, 'copiedNotPasted', session.targetApp, 'Copied to your clipboard. Press Ctrl+V to paste it.');
   782	      return;
   783	    }
   784	    // Neither pasted nor on the clipboard: only a broken sink reports this.
   785	    this.fail(session, {
   786	      kind: 'deliveryFailed',
   787	      message: 'Your dictation is saved in your history, but it could not be delivered.',
   788	    });
   789	  }
   790	
   791	  /** End a dictation that was delivered: outcome first, then idle. */
   792	  private finish(
   793	    session: Session,
   794	    text: string,
   795	    result: DictationDelivery,
   796	    appName?: string,
   797	    idleMessage?: string,
   798	  ): void {
   799	    const event: DictationOutcomeEvent = { kind: 'delivered', words: countWords(text), result };
   800	    if (appName !== undefined) event.appName = appName;
   801	    this.emitOutcome(session, event);
   802	    this.session = null;
   803	    this.setState('idle', idleMessage);
   804	  }
   805	
   806	  /**
   807	   * End a dictation with an error. A typed error also reaches the UI as `status.error`;
   808	   * a bare message (a broken sink, which only a bug can cause) has no kind to offer.
   809	   * Callers have already checked the session is still current.
   810	   */
   811	  private fail(session: Session, error: DictationError | string): void {
   812	    if (this.session !== session) return;
   813	    this.stopMonitoring();
   814	    this.abortController = null;
   815	    this.session = null;
   816	    this.setState('error', error);
   817	  }
   818	
   819	  private emitOutcome(session: Session, event: DictationOutcomeEvent): void {
   820	    if (session.settled) return;
   821	    session.settled = true;
   822	    this.deps.onOutcome?.(event);
   823	  }
   824	
   825	  /**
   826	   * Deliver with a bounded wait.
   827	   *
   828	   * The macOS build returned the state to idle ONLY when the sink called back. A
   829	   * lost callback therefore left the app in `delivering` forever and the hotkey
   830	   * stopped working until relaunch. The timeout makes the contract total: the
   831	   * state is always released, and the dictation is left on the clipboard either
   832	   * way.
   833	   */
   834	  private async deliver(text: string, mode: 'paste' | 'copy', session: Session): Promise<DeliveryResult> {
   835	    const timeoutMs = this.deps.deliveryTimeoutMs ?? DEFAULT_DELIVERY_TIMEOUT_MS;
   836	    // The sink gets its own signal, so the timeout can stop it as well as the user's
   837	    // cancel. Without that, a timeout that wins leaves the sink running, and it goes on
   838	    // to press Ctrl+V after the dictation was reported as only copied.
   839	    const delivery = new AbortController();
   840	    const sessionSignal = this.abortController?.signal;
   841	    const onSessionAbort = (): void => delivery.abort(sessionSignal?.reason);
   842	    if (sessionSignal?.aborted) onSessionAbort();
   843	    else sessionSignal?.addEventListener('abort', onSessionAbort, { once: true });
   844	    let timer: NodeJS.Timeout | null = null;
   845	    try {
   846	      const request: DeliveryRequest =
   847	        mode === 'paste'
   848	          ? {
   849	              text,
   850	              mode,
   851	              targetApp: session.targetApp,
   852	              startedInOwnWindow: session.startedInOwnWindow,
   853	              signal: delivery.signal,
   854	            }
   855	          : { text, mode, signal: delivery.signal };
   856	      const result = await Promise.race([
   857	        this.deps.sink.deliver(request),
   858	        new Promise<DeliveryResult>((resolve) => {
   859	          timer = setTimeout(() => {
   860	            delivery.abort(DELIVERY_TIMED_OUT);
   861	            resolve({ delivered: false, clipboardFallback: true });
   862	          }, timeoutMs);
   863	          timer.unref?.();
   864	        }),
   865	      ]);
   866	      return result;
   867	    } catch {
   868	      // The sink itself failed. The text is on the clipboard, so nothing is lost.
   869	      return { delivered: false, clipboardFallback: true };
   870	    } finally {
   871	      if (timer) clearTimeout(timer);
   872	      sessionSignal?.removeEventListener('abort', onSessionAbort);
   873	    }
   874	  }
   875	
   876	  private retain(captured: CapturedAudio, language: MemoryLanguage): void {
   877	    this.lastFailed = { audio: captured, language };
   878	  }
   879	
   880	  private setState(state: DictationState, error?: DictationError | string, targetApp?: string): void {
   881	    this.state = state;
   882	    const status: DictationStatus = { state };
   883	    if (typeof error === 'string') {
   884	      status.message = error;
   885	    } else if (error !== undefined) {
   886	      status.message = error.message;
   887	      status.error = error;
   888	    }
   889	    if (targetApp !== undefined) status.targetApp = targetApp;
   890	    if (this.session) status.delivery = this.session.source === 'hotkey' ? 'paste' : 'copy';
   891	    if (state === 'recording') status.elapsedSeconds = this.clock.elapsedSeconds();
   892	    this.deps.onStatus(status);
   893	  }
   894	
   895	  private nowFn(): () => number {
   896	    return this.deps.now ?? (() => Date.now());
   897	  }
   898	}
