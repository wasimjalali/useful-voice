    27	  readonly stderr = new EventEmitter() as EventEmitter & HostChild['stderr'];
    28	  readonly written: Array<{ script: string; id: string }> = [];
    29	  killed = false;
    30	  /** Called for each request line; the test decides what the "script" prints. */
    31	  onRequest: (request: { script: string; id: string }, child: FakeChild) => void = () => undefined;
    32	
    33	  readonly stdin = Object.assign(new EventEmitter(), {
    34	    write: (data: string): void => {
    35	      const [encoded, id] = data.trimEnd().split('|') as [string, string];
    36	      const request = { script: Buffer.from(encoded, 'base64').toString('utf8'), id: id };
    37	      this.written.push(request);
    38	      this.onRequest(request, this);
    39	    },
    40	  });
