    60	 * HTML or RTF without plain text still counts, because that is a real document.
    61	 */
    62	export function hasRestorableContent(contents: ClipboardContents): boolean {
    63	  return contents.text.trim().length > 0 || contents.html.length > 0 || contents.rtf.length > 0;
