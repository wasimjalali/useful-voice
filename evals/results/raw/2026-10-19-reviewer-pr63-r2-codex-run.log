     2	 * The clipboard half of the delivery contract, as pure logic.
     3	 *
     4	 * Delivery must never lose a dictation: after every attempt the text is either
     5	 * pasted into the user's app or still on the clipboard. Whether the previous clipboard
     6	 * may be put back is therefore a *decision*, and the rules are deliberately strict:
     7	 *
     8	 *   After a SENT paste the previous clipboard is never put back. No API tells us that
     9	 *   the target consumed Ctrl+V (it never clears the clipboard, and an app that stalls
    10	 *   past any delay we pick would then paste the OLD clipboard, losing the dictation).
    11	 *   The dictation stays on the clipboard and the paste is reported as delivered. If
    12	 *   the keystroke could not be sent, it stays too and the person is told to paste.
    13	 *
    14	 *   Before the paste (a cancel arrived first) the previous clipboard goes back only
    15	 *   when the clipboard still holds exactly our text, so a newer copy is never
    16	 *   overwritten, and the snapshot is complete and has something worth restoring.
    17	 *
    18	 * This module is deliberately pure: the observations arrive as data, so the policy is
    19	 * testable without Electron on any platform. The clipboard access itself lives in
    20	 * `src/main/windowsPlatform.ts`.
    21	 */
    22	
    23	/** The peer window a paste is aimed at. */
    24	export interface PasteTarget {
    25	  /** Process name, e.g. "notepad.exe". */
    26	  processName: string;
    27	  /**
    28	   * The window handle.
    29	   *
    30	   * Identity is taken from the handle and not from the title: titles change while
    31	   * the user types, and two windows of the same app can carry the same title.
    32	   */
    33	  handle: number;
    34	}
