     1	/**
     2	 * Whether a hotkey dictation should be copied instead of pasted.
     3	 *
     4	 * The text is pasted wherever the cursor is when it is ready, even if the user moved to
     5	 * another field or window while it was transcribing. The one exception: one of Useful
     6	 * Voice's own windows came to the front after the dictation started elsewhere (stopped
     7	 * from the dock), where a paste would land nowhere useful, so it is copied instead.
     8	 * A dictation started in our own window (a note) still pastes there.
     9	 *
    10	 * Both facts are synchronous reads (`BrowserWindow.getFocusedWindow() !== null`), so
    11	 * neither the start nor the delivery waits on a query to Windows for them.
    12	 */
    13	export function pasteLandsInOwnWindow(startedInOwnWindow: boolean, ownWindowInFront: boolean): boolean {
    14	  return ownWindowInFront && !startedInOwnWindow;
    15	}

