    73	export function mayRestoreAfterCancel(snapshot: ClipboardContents, clipboardHoldsOurText: boolean): boolean {
    74	  return clipboardHoldsOurText && !snapshot.incomplete && hasRestorableContent(snapshot);
    75	}
    76	
    77	/** The clipboard formats a snapshot can put back faithfully: plain text, HTML and RTF. */
    78	export const RESTORABLE_FORMATS: readonly string[] = ['text/plain', 'text/html', 'text/rtf'];
    79	
    80	/**
    81	 * Whether the clipboard held anything the restore cannot reproduce.
    82	 *
    83	 * An image, a file list or a proprietary type is written back by nobody, so a snapshot
    84	 * of a clipboard that holds one is incomplete however faithful its text part is.
    85	 * Claiming otherwise replaced a copied image with its caption.
    86	 */
    87	export function hasUnrestorableFormat(formats: readonly string[]): boolean {
    88	  return formats.some((format) => {
    89	    const normalised = format.toLowerCase();
    90	    return !RESTORABLE_FORMATS.some((known) => normalised === known || normalised.startsWith(`${known};`));
    91	  });
