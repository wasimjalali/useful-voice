    69	  "$ErrorActionPreference = 'Stop'",
    70	  '[Console]::OutputEncoding = New-Object System.Text.UTF8Encoding($false)',
    71	  'while ($true) {',
    72	  '  $line = [Console]::In.ReadLine()',
    73	  '  if ($null -eq $line) { break }',
    74	  "  $parts = $line.Split('|')",
    75	  '  try { Invoke-Expression ([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($parts[0]))) }',
    76	  "  catch { Write-Output ('UVERR:' + $_.Exception.Message) }",
    77	  "  Write-Output ('UVEND:' + $parts[1])",
    78	  '  [Console]::Out.Flush()',
    79	  '}',
    80	].join('\n');
    81	
    82	/** The arguments that start the host. */
