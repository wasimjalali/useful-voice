    84	  return [
    85	    '-NoProfile',
    86	    '-NonInteractive',
    87	    '-ExecutionPolicy',
    88	    'Bypass',
    89	    '-EncodedCommand',
    90	    Buffer.from(HOST_BOOTSTRAP, 'utf16le').toString('base64'),
    91	  ];
    92	}
