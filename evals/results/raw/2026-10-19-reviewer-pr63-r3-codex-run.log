    64	export interface PasteFlowPorts<S extends ClipboardContents> {
    65	  writeText(text: string): void;
    66	  snapshot(): S;
    67	  restore(snapshot: S, dictationText: string): RestoreOutcome;
    68	  holdsText(text: string): boolean;
    69	  pasteKeystroke(request: KeystrokeRequest): Promise<KeystrokeResult>;
    70	  /** One of our own windows has focus right now. A synchronous read. */
    71	  ownWindowInFront(): boolean;
    72	  /**
    73	   * A text field of ours has focus (not a password box, not read-only), so a paste has
    74	   * somewhere to land. Bounded and false on any failure.
    75	   */
    76	  ownFieldAcceptsPaste(): Promise<boolean>;
    77	  log(category: string, message: string): void;
    78	}
