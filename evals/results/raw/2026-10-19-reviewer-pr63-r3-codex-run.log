    91	   * "copied", so the dictation has to be on the clipboard; a cancel is reported as
    92	   * cancelled, so the person's own clipboard goes back, but only when that is safe: it
    93	   * still holds exactly our text (a newer copy is theirs) and the snapshot is complete
    94	   * and worth restoring.
    95	   */
    96	  const stopBeforePaste = (snapshot: S | null): PasteFlowResult => {
    97	    if (timedOut()) {
    98	      ports.writeText(text);
    99	      return { delivered: false, clipboardFallback: true };
   100	    }
   101	    if (snapshot && mayRestoreAfterCancel(snapshot, ports.holdsText(text))) ports.restore(snapshot, text);
