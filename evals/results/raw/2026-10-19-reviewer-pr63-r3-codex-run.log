   246	  const dataBytes = samples.length * 2;
   247	  const buffer = Buffer.alloc(44 + dataBytes);
   248	  buffer.write('RIFF', 0, 'ascii');
   249	  buffer.writeUInt32LE(36 + dataBytes, 4);
   250	  buffer.write('WAVE', 8, 'ascii');
   251	  buffer.write('fmt ', 12, 'ascii');
   252	  buffer.writeUInt32LE(16, 16);
   253	  buffer.writeUInt16LE(1, 20);
   254	  buffer.writeUInt16LE(1, 22);
   255	  buffer.writeUInt32LE(sampleRate, 24);
   256	  buffer.writeUInt32LE(sampleRate * 2, 28);
   257	  buffer.writeUInt16LE(2, 32);
   258	  buffer.writeUInt16LE(16, 34);
   259	  buffer.write('data', 36, 'ascii');
   260	  buffer.writeUInt32LE(dataBytes, 40);
   261	  samples.forEach((sample, index) => {
   262	    const clamped = Math.max(-1, Math.min(1, sample));
   263	    buffer.writeInt16LE(Math.round(clamped < 0 ? clamped * 0x8000 : clamped * 0x7fff), 44 + index * 2);
   264	  });
   265	  return buffer;
   266	}
