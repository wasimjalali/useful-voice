   109	    // dictation simply becomes the clipboard.
   110	    ports.writeText(text);
   111	    return { delivered: true, clipboardFallback: false };
   112	  }
   113	
   114	  const copyBecauseOwnWindow = (why: string): PasteFlowResult => {
   115	    // One of our windows is in front and a paste would land nowhere useful (the person
   116	    // stopped from the dock, or no text field has focus). Leave it on the clipboard.
   117	    ports.log('delivery', `${why}; copied instead of pasting`);
   118	    ports.writeText(text);
   119	    return { delivered: false, clipboardFallback: true };
   120	  };
   121	
   122	  // Our own window in front. A dictation started elsewhere is copied. One that started in
   123	  // our window pastes only into a focused text field; a button, the page, a password box
   124	  // or the language picker would swallow the keystroke.
   125	  let ownFieldChecked = false;
   126	  if (ports.ownWindowInFront()) {
   127	    if (!startedInOwnWindow) return copyBecauseOwnWindow('Useful Voice is in front');
   128	    ownFieldChecked = await ports.ownFieldAcceptsPaste();
   129	    if (aborted()) return stopBeforePaste(null);
   130	    if (!ownFieldChecked) return copyBecauseOwnWindow('no text field of Useful Voice has focus');
   131	  }
   132	
   133	  const snapshot = ports.snapshot();
   134	  ports.writeText(text);
   135	
   136	  if (aborted()) return stopBeforePaste(snapshot);
   137	
   138	  // Why the port was last refused, so a `blocked` answer can be told apart.
   139	  const refusal: { reason: 'own' | 'clipboard' | null } = { reason: null };
   140	  const canSend = (): boolean => {
   141	    if (ports.ownWindowInFront() && !(startedInOwnWindow && ownFieldChecked)) {
   142	      refusal.reason = 'own';
   143	      return false;
   144	    }
   145	    if (!ports.holdsText(text)) {
   146	      refusal.reason = 'clipboard';
   147	      return false;
   148	    }
   149	    return true;
   150	  };
   151	
   152	  const keystroke = await ports.pasteKeystroke({ text, signal, canSend, allowOwnWindow: startedInOwnWindow });
   153	
   154	  if (keystroke === 'sent' || keystroke === 'indeterminate') {
   155	    // The key may have gone out, so this is delivered whatever the signal says now: no
   156	    // cancel, no "Press Ctrl+V", no restore. The dictation stays on the clipboard.
   157	    return { delivered: true, clipboardFallback: false };
   158	  }
   159	  if (keystroke === 'failed') return { delivered: false, clipboardFallback: true };
   160	
   161	  // Blocked, so nothing was sent. A cancel or timeout wins over the reason it was blocked.
   162	  if (aborted()) return stopBeforePaste(snapshot);
   163	  if (keystroke === 'blocked-clipboard' || (keystroke === 'blocked' && refusal.reason === 'clipboard')) {
   164	    // The person (or another app) copied something after the dictation was written. Their
   165	    // newer copy is left alone and nothing is claimed: the caller reports an error.
   166	    ports.log('delivery', 'not pasted: the clipboard changed while waiting');
   167	    return { delivered: false, clipboardFallback: false, clipboardChanged: true };
   168	  }
   169	  return copyBecauseOwnWindow('Useful Voice came to the front');
   170	}
     1	/**
