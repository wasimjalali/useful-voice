    98	  /** Default per-request limit, from enqueue to the sentinel. */
    99	  requestTimeoutMs?: number;
   100	  /** How long the setup script may take on a cold start. */
   101	  startupTimeoutMs?: number;
   102	  /** Unexpected deaths allowed within `restartWindowMs` before the host is given up on. */
   103	  maxRestarts?: number;
   104	  restartWindowMs?: number;
   105	  now?: () => number;
   106	  newId?: () => string;
   107	  log?: (message: string) => void;
   108	}
   109	
   110	export interface RunOptions {
   111	  /** The limit on the run itself: its clock starts when the request is written to the host. */
   112	  timeoutMs?: number;
   113	  /**
