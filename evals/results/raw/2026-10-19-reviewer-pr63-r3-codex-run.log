     3	 *
     4	 * A delivery has two very different phases, and the limits treat them differently:
     5	 *
     6	 *  - BEFORE the keystroke request is written to PowerShell, the sink may be waiting for
     7	 *    the host to start (up to `HOST_STARTUP_TIMEOUT_MS`) and for requests queued ahead of
     8	 *    it. Nothing has been sent, so the service may interrupt it at any time: the signal
     9	 *    aborts, the queued request is dropped, and the dictation is reported as copied.
    10	 *  - ONCE the request is written, the keystroke may have gone out. It can no longer be
    11	 *    taken back, and a timeout or an abort proves nothing about whether it ran. From
    12	 *    there the dictation counts as delivered whatever happens (see `pasteFlow.ts`), so
    13	 *    the service must wait for the sink's own verdict instead of overruling it.
    14	 */
    15	
    16	/** Reading which window is in front (the HUD label and the language picker; not delivery). */
    17	export const FOREGROUND_QUERY_TIMEOUT_MS = 2500;
    18	
    19	/** Sending Ctrl+V once the request is written, per attempt. */
    20	export const PASTE_KEYSTROKE_TIMEOUT_MS = 2500;
    21	
    22	/** How long a cold PowerShell host may take to compile its types and answer. */
    23	export const HOST_STARTUP_TIMEOUT_MS = 20_000;
    24	
    25	/** Snapshotting, writing and checking the clipboard: synchronous, but not free. */
