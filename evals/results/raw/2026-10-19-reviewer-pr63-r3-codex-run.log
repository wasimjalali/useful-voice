   221	/**
   222	 * Short two-tone cues, generated rather than shipped as assets.
   223	 *
   224	 * Start rises, stop falls, error is a single low tone — the same information the
   225	 * macOS build conveys with its synthesized chimes.
   226	 */
   227	function buildCue(kind: 'start' | 'stop' | 'error'): Buffer {
   228	  const sampleRate = 22_050;
   229	  const tones: Record<typeof kind, Array<{ hz: number; ms: number }>> = {
   230	    start: [{ hz: 660, ms: 70 }, { hz: 990, ms: 90 }],
   231	    stop: [{ hz: 990, ms: 70 }, { hz: 660, ms: 90 }],
   232	    error: [{ hz: 320, ms: 180 }],
   233	  };
   234	
   235	  const samples: number[] = [];
   236	  for (const tone of tones[kind]) {
   237	    const count = Math.round((tone.ms / 1000) * sampleRate);
   238	    for (let i = 0; i < count; i += 1) {
   239	      // Short fade at each end so the cue does not click.
   240	      const progress = i / count;
   241	      const envelope = Math.min(1, progress * 12, (1 - progress) * 12);
   242	      samples.push(Math.sin((2 * Math.PI * tone.hz * i) / sampleRate) * 0.25 * envelope);
   243	    }
   244	  }
