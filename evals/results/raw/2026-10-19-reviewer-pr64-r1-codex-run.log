    21	 * and each one would consume a slot in the token budget that a user's own term
    22	 * should have. A third-party product name has also been removed: it shipped to
    23	 * every user, spent budget, and biased recognition toward a brand the user never
    24	 * said.
    25	 */
    26	export const BASE_VOCABULARY: readonly string[] = [
    27	  'Next.js',
    28	  'Vercel',
    29	  'Stripe',
    30	  'Bedrock',
    31	  'Tailwind',
    32	  'TypeScript',
    33	  'JavaScript',
    34	  'SwiftUI',
    35	  'Xcode',
    36	  'GitHub',
    37	  'GitLab',
    38	  'Supabase',
    39	  'Postgres',
    40	  'PostgreSQL',
    41	  'Kubernetes',
    42	  'Docker',
    43	  'Terraform',
    44	  'GraphQL',
    45	  'WebSocket',
    46	  'OAuth',
    47	  'JSON',
    48	  'YAML',
    49	  'CLI',
    50	  'SDK',
    51	  'API',
    52	  'localhost',
    53	  'npm',
    54	  'pnpm',
    55	  'Vite',
    56	  'Vitest',
    57	];
    58	
    59	export interface KeytermSelection {
    60	  terms: string[];
    61	  estimatedTokens: number;
    62	  /**
    63	   * Valid entries left out because they did not fit the count or token budget.
    64	   * Only this is something the user can act on.
    65	   */
    66	  droppedCount: number;
    67	  /** Entries the provider cannot use at all (too long, no alphanumerics). */
    68	  rejectedCount: number;
    69	  /** Entries skipped because an equivalent term was already selected. */
    70	  duplicateCount: number;
    71	  limit: number;
    72	}
    73	
    74	/** Everything that did not make it into the request. */
    75	export function omittedCount(selection: KeytermSelection): number {
    76	  return selection.droppedCount + selection.rejectedCount;
    77	}
    78	
    79	export function isOverCapacity(selection: KeytermSelection): boolean {
    80	  return selection.droppedCount > 0;
    81	}
    82	
    83	export interface BiasInput {
    84	  terms: readonly MemoryTerm[];
    85	  replacements?: readonly ReplacementRule[];
    86	  snippets?: readonly MemorySnippet[];
    87	  baseVocabulary?: readonly string[];
    88	  language: MemoryLanguage;
    89	  /** Maximum number of keyterm strings, in addition to the token ceiling. */
    90	  budget: number;
    91	}
    92	
    93	/**
    94	 * Choose the keyterms for one transcription request.
    95	 *
    96	 * Only CORRECT forms are ever sent. Pronunciations are misheard forms, and a
    97	 * keyterm biases the model toward that exact string, so sending one would make
    98	 * the mistake it was recorded to fix more likely. Aliases are alternate correct
    99	 * spellings and are safe.
   100	 *
   101	 * Admission requires fitting both the count budget and the token ceiling, and a
   102	 * term that does not fit is dropped rather than truncated: half a term as a
   103	 * keyterm would bias the model toward a wrong string.
   104	 */
   105	export function selectKeyterms(input: BiasInput): KeytermSelection {
   106	  const { language, budget } = input;
   107	  const baseVocabulary = input.baseVocabulary ?? BASE_VOCABULARY;
   108	
   109	  if (budget <= 0) {
   110	    return {
   111	      terms: [],
   112	      estimatedTokens: 0,
   113	      droppedCount: 0,
   114	      rejectedCount: 0,
   115	      duplicateCount: 0,
   116	      limit: TOKEN_BUDGET,
   117	    };
   118	  }
   119	
   120	  const sortedTerms = [...input.terms]
   121	    .filter((term) => languageMatches(term.language, language))
   122	    .sort(compareTerms);
   123	
   124	  const seen = new Set<string>();
   125	  const terms: string[] = [];
   126	  let spentTokens = 0;
   127	  let droppedCount = 0;
   128	  let rejectedCount = 0;
   129	  let duplicateCount = 0;
   130	
   131	  const append = (value: string): void => {
   132	    const trimmed = value.trim();
   133	    if (!isSendableKeyterm(trimmed)) {
   134	      rejectedCount += 1;
   135	      return;
   136	    }
   137	    const key = canonical(trimmed);
   138	    if (key.length === 0) {
   139	      rejectedCount += 1;
   140	      return;
   141	    }
   142	    if (seen.has(key)) {
   143	      duplicateCount += 1;
   144	      return;
   145	    }
   146	    if (terms.length >= budget) {
   147	      droppedCount += 1;
   148	      return;
   149	    }
   150	    const cost = estimateTokens(trimmed);
   151	    if (spentTokens + cost > TOKEN_BUDGET) {
   152	      droppedCount += 1;
   153	      return;
   154	    }
   155	    seen.add(key);
   156	    terms.push(trimmed);
   157	    spentTokens += cost;
   158	  };
   159	
   160	  // 1. Personal dictionary phrases, then their alternate correct spellings.
   161	  for (const term of sortedTerms) {
   162	    append(term.phrase);
   163	    for (const alias of term.aliases) append(alias);
   164	  }
   165	
   166	  // 2. Auto-correction targets: what the model should produce.
   167	  const sortedReplacements = [...(input.replacements ?? [])]
   168	    .filter((rule) => rule.isEnabled && languageMatches(rule.language, language))
   169	    .sort((a, b) => b.usageCount - a.usageCount);
   170	  for (const rule of sortedReplacements) append(rule.replacement);
   171	
   172	  // 3. Snippet triggers, so spoken shortcuts survive transcription.
   173	  for (const snippet of input.snippets ?? []) {
   174	    if (!snippet.isEnabled || !languageMatches(snippet.language, language)) continue;
   175	    append(snippet.trigger);
   176	  }
   177	
   178	  // 4. Shipped vocabulary fills whatever budget is left.
   179	  for (const word of baseVocabulary) append(word);
   180	
   181	  return {
   182	    terms,
   183	    estimatedTokens: spentTokens,
   184	    droppedCount,
   185	    rejectedCount,
   186	    duplicateCount,
   187	    limit: TOKEN_BUDGET,
   188	  };
   189	}
   190	
   191	/** Ranking within the same priority: most used first, then most recently edited. */
   192	function compareTerms(a: MemoryTerm, b: MemoryTerm): number {
   193	  const rankDelta = priorityRank(a.priority) - priorityRank(b.priority);
   194	  if (rankDelta !== 0) return rankDelta;
   195	  if (a.usageCount !== b.usageCount) return b.usageCount - a.usageCount;
   196	  const updated = b.updatedAt.localeCompare(a.updatedAt);
   197	  if (updated !== 0) return updated;
   198	  // Total order: without this the result depends on the input array's order,
   199	  // which made the keyterm list (and therefore transcripts) non-reproducible.
   200	  return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
   201	}
   202	
   203	/** Convenience: the plain keyterm list for a snapshot. */
   204	export function biasList(snapshot: LanguageMemorySnapshot, language: MemoryLanguage, budget: number): string[] {
   205	  return selectKeyterms({
   206	    terms: snapshot.terms,
   207	    replacements: snapshot.replacements,
   208	    snippets: snapshot.snippets,
   209	    language,
   210	    budget,
   211	  }).terms;
   212	}
   213	
   214	export type { MemoryPriority };
  await keyRow(win, 'elevenlabs').getByRole('button', { name: 'Remove ElevenLabs key' }).click();
  await expect(scribe).toHaveAttribute('aria-disabled', 'true');
  expect((await currentSettings(win)).keys.elevenlabs).toBe(false);
});

test('a model with no key says which key to add, and adding it makes the dictation work', async () => {
  const { win } = await start('models-missing-key');
  await choose(win, { voiceModelId: 'gemini-audio:gemini-3.8-flash' });

  await dictate(win);
  const error = (await log(win)).states.filter((state) => state.state === 'error').at(-1)?.error;
  expect(error).toMatchObject({ kind: 'noProvider', fix: 'openEngineSettings', message: 'Add your Gemini key in Settings.' });
  await expect(dockStatus(win)).toContainText('Add your Gemini key in Settings.');
  await expect(win.locator('.banner')).toContainText('No Gemini key.');

  // The fix opens Models, where the row is waiting for the key.
  await win.locator('.dock').getByRole('button', { name: 'Open settings' }).click();
  await expect(win.locator('#settings-models')).toBeVisible();
  await win.getByRole('radio', { name: /^Gemini 3.8 Flash,/ }).first().click({ force: true });
  await expect(win.getByLabel('Gemini API key')).toBeFocused();
  await saveKeyInRow(win, 'gemini', 'Gemini', 'valid-gemini');
  await expect(win.locator('.banner')).toHaveCount(0);

  await dictate(win);
  const saved = await lastDictation(run!.userData, 1);
  expect(saved.text).toBe('Hello from Gemini, the voice model.');
});

test('AI formatting delivers the formatter\'s text, keeps what was heard, and never blocks a dictation', async () => {
  const { win, userData } = await start('models-formatter');
  for (const [provider, key] of [['deepgram', 'valid-deepgram'], ['gemini', 'valid-gemini'], ['anthropic', 'valid-anthropic']] as const) {
    await setKey(win, provider, key);
  }
  await win.reload();
  await win.waitForSelector('.dock');
  await collect(win);

  // Off: the plain transcript.
  await dictate(win);
  expect((await lastDictation(userData, 1)).text).toBe('Hello from Useful Voice.');

  // Gemini on: its text is what was delivered; the history keeps the raw transcript.
  await choose(win, { formatterId: 'gemini:gemini-3.8-flash' });
  await dictate(win);
  const gemini = await lastDictation(userData, 2);
  expect(gemini).toMatchObject({ text: 'Hello from Useful Voice. (formatted by Gemini)', rawText: 'Hello from Useful Voice.', mode: 'formatted' });
  await expect(dockStatus(win)).toContainText('Saved and copied');

  // Anthropic on.
  await choose(win, { formatterId: 'anthropic:claude-sonnet-5-5' });
  await dictate(win);
  expect((await lastDictation(userData, 3)).text).toBe('Hello from Useful Voice. (formatted by Anthropic)');

  // Off again.
  await choose(win, { formatterId: null });
  await dictate(win);
  expect((await lastDictation(userData, 4))).toMatchObject({ text: 'Hello from Useful Voice.', mode: 'raw' });

  // A refused formatter key: the dictation still arrives, unformatted.
  await setKey(win, 'gemini', 'bad-gemini');
  await choose(win, { formatterId: 'gemini:gemini-3.8-flash' });
  await dictate(win);
  expect((await lastDictation(userData, 5))).toMatchObject({ text: 'Hello from Useful Voice.', mode: 'raw' });
  expect((await log(win)).states.filter((state) => state.state === 'error')).toHaveLength(0);
  const diagnostics = await fs.readFile(path.join(userData, 'diagnostics.log'), 'utf8').catch(() => '');
  expect(diagnostics).not.toContain('bad-gemini');
  expect(diagnostics).not.toContain('Hello from Useful Voice');

  // A dead network to the formatter: the same.
  await setKey(win, 'gemini', 'offline-gemini');
  await dictate(win);
  expect((await lastDictation(userData, 6))).toMatchObject({ text: 'Hello from Useful Voice.', mode: 'raw' });
});

test('each voice model reaches its own provider, and the formatter works on top of it', async () => {
  const { win, userData } = await start('models-providers');
  for (const [provider, key] of [['deepgram', 'valid-deepgram'], ['elevenlabs', 'valid-eleven'], ['gemini', 'valid-gemini'], ['anthropic', 'valid-anthropic']] as const) {
    await setKey(win, provider, key);
  }
  await win.reload();
  await win.waitForSelector('.dock');
  await collect(win);

  const cases: Array<[string, string]> = [
    ['deepgram:nova-3', 'Hello from Useful Voice.'],
    ['deepgram:nova-3-medical', 'Hello from Useful Voice.'],
    ['elevenlabs:scribe_v2', 'Hello from Scribe, the ElevenLabs model.'],
    ['gemini-audio:gemini-3.8-flash', 'Hello from Gemini, the voice model.'],
  ];
  let count = 0;
  for (const [model, text] of cases) {
    await choose(win, { voiceModelId: model });
    await dictate(win);
    count += 1;
    expect((await lastDictation(userData, count)).text, model).toBe(text);
  }

  // Scribe heard it, Claude formatted it.
  await choose(win, { voiceModelId: 'elevenlabs:scribe_v2', formatterId: 'anthropic:claude-haiku-5-5' });
  await dictate(win);
  count += 1;
  expect((await lastDictation(userData, count)).text).toBe('Hello from Scribe, the ElevenLabs model. (formatted by Anthropic)');

  // The app asked each provider exactly for the model chosen: no other host was called for a voice model.
  const requests = await fs.readFile(path.join(userData, 'e2e.log'), 'utf8');
  expect(requests).toMatch(/deepgram POST .*model=nova-3-medical/);
  expect(requests).toMatch(/elevenlabs POST https:\/\/api\.elevenlabs\.io\/v1\/speech-to-text/);
  expect(requests).toMatch(/gemini POST .*gemini-3\.8-flash:generateContent/);
  expect(requests).not.toContain('key=');
});

test('Nova-3 Medical refuses a language it does not speak before anything is sent', async () => {
  const { win, userData } = await start('models-medical-german');
  await setKey(win, 'deepgram', 'valid-deepgram');
  await choose(win, { voiceModelId: 'deepgram:nova-3-medical', languagePin: 'de' });
  await dictate(win);
  const error = (await log(win)).states.filter((state) => state.state === 'error').at(-1)?.error;
  expect(error?.message).toBe('Nova-3 Medical only speaks English. Pick another voice model or switch the language to English.');
  const requests = await fs.readFile(path.join(userData, 'e2e.log'), 'utf8');
  expect(requests).not.toContain('nova-3-medical');
});

test('a local model starts its download when picked and becomes the voice model when it is ready', async () => {
  const { app, win } = await start('models-local');
  await setKey(win, 'deepgram', 'valid-deepgram');
  await win.reload();
  await win.waitForSelector('.dock');
  await openSettings(win);

  // The stub reports every Parakeet model as not downloaded: the row offers the download.
  const parakeet = voiceList(win).getByRole('radio', { name: /^Parakeet,/ });
  await expect(voiceList(win).getByRole('button', { name: 'Download Parakeet', exact: true })).toBeVisible();
  await parakeet.click();
  // Not switched yet: nothing is on this PC to dictate with.
  await expect(parakeet).toHaveAttribute('aria-checked', 'false');
  expect((await currentSettings(win)).voiceModelId).toBe('deepgram:nova-3');

  // Main reports progress, then the finished model.
  const states = (v2: unknown) => ({ v2, v3: { status: 'notDownloaded' } });
  await sendToMain(app, 'parakeet:changed', states({ status: 'downloading', progress: 0.4 }));
  const bar = voiceList(win).getByRole('progressbar', { name: 'Downloading Parakeet' });
  await expect(bar).toHaveAttribute('aria-valuenow', '40');
  await expect(voiceList(win).getByRole('button', { name: 'Cancel' })).toBeVisible();
  await sendToMain(app, 'parakeet:changed', states({ status: 'ready', sizeBytes: 482_000_000 }));
  await expect(parakeet).toHaveAttribute('aria-checked', 'true');
  await expect(voiceList(win).getByRole('button', { name: 'Delete Parakeet' })).toBeVisible();
  expect((await currentSettings(win)).voiceModelId).toBe('parakeet:v2');

  // A failed download offers a retry, and does not switch anything.
  const multilingual = voiceList(win).getByRole('radio', { name: /^Parakeet Multilingual,/ });
  await multilingual.click();
  await sendToMain(app, 'parakeet:changed', { v2: { status: 'ready', sizeBytes: 482_000_000 }, v3: { status: 'failed', message: 'offline' } });
  await expect(voiceList(win).getByRole('button', { name: 'Retry Parakeet Multilingual' })).toBeVisible();
  await expect(multilingual).toHaveAttribute('aria-checked', 'false');
  expect((await currentSettings(win)).voiceModelId).toBe('parakeet:v2');
});

test('Settings > Models in light and dark, wide and narrow (screenshots)', async () => {
  const { win } = await start('models-screens');
  await setKey(win, 'deepgram', 'valid-deepgram');
  await setKey(win, 'elevenlabs', 'valid-eleven');
  await setKey(win, 'gemini', 'valid-gemini');
  for (const appearance of ['light', 'dark'] as const) {
    await saveSettings(win, { appearance, voiceModelId: 'elevenlabs:scribe_v2', formatterId: 'gemini:gemini-3.8-flash' });
    await win.reload();
    await win.waitForSelector('.dock');
    for (const [label, width, height] of [['wide', 1280, 900], ['narrow', 420, 900]] as const) {
      await win.setViewportSize({ width, height });
      await openSettings(win);
      await win.locator('#settings-models').scrollIntoViewIfNeeded();
      await shot(win, `models-${appearance}-${label}`);
      await win.locator('#settings-keys').scrollIntoViewIfNeeded();
      await shot(win, `keys-${appearance}-${label}`);
    }
  }
});
import { describe, expect, it, vi } from 'vitest';
import { createTranscriber, currentVoiceModel, missingKeyMessage, voiceCredential } from '../src/main/transcriberRouter.js';
import { ProviderError, type Transcript } from '../src/core/transcription/deepgramProvider.js';
import type { KeyProvider } from '../src/core/models/catalog.js';

// The provider chosen for the voice model is the one that runs, and a model that can't run
// says why. Nothing falls back to another provider.

const request = { audio: new Uint8Array(64_000), language: 'auto', keyterms: ['Convex'], smartFormat: true, spokenPunctuation: false };
const ok = (body: unknown): Response => new Response(JSON.stringify(body), { status: 200 });

function setup(modelId: string, keys: Partial<Record<KeyProvider, string>> = {}) {
  const urls: string[] = [];
  const fetchImpl = vi.fn(async (url: string) => {
    urls.push(url);
    if (url.includes('deepgram')) return ok({ results: { channels: [{ alternatives: [{ transcript: 'from deepgram' }] }] } });
    if (url.includes('elevenlabs')) return ok({ text: 'from scribe', language_code: 'eng' });
    return ok({ candidates: [{ content: { parts: [{ text: 'from gemini' }] } }] });
  });
  const parakeet = { transcribe: vi.fn(async (): Promise<Transcript> => ({ text: 'from parakeet', durationSeconds: null, detectedLanguage: null })) };
  const transcriber = createTranscriber({ voiceModelId: () => modelId, key: (provider) => keys[provider] ?? null, parakeet, fetchImpl: fetchImpl as never });
  return { transcriber, urls, parakeet, fetchImpl };
}

async function failure(promise: Promise<unknown>): Promise<ProviderError> {
  try {
    await promise;
  } catch (error) {
    return error as ProviderError;
  }
  throw new Error('expected a failure');
}

describe('a model whose key is missing', () => {
  it.each([
    ['deepgram:nova-3', 'Deepgram'],
    ['deepgram:nova-3-medical', 'Deepgram'],
    ['elevenlabs:scribe_v2', 'ElevenLabs'],
    ['gemini-audio:gemini-3.8-flash', 'Gemini'],
  ])('%s says "Add your %s key in Settings." and sends nothing', async (modelId, name) => {
    const ctx = setup(modelId);
    const error = await failure(ctx.transcriber.transcribe(request));
    expect(error.kind).toBe('notConfigured');
    expect(error.message).toBe(`Add your ${name} key in Settings.`);
    expect(ctx.fetchImpl).not.toHaveBeenCalled();
    expect(ctx.parakeet.transcribe).not.toHaveBeenCalled();
    expect(missingKeyMessage(currentVoiceModel(modelId))).toBe(error.message);
  });

  it('does not use another provider\'s key', async () => {
    const ctx = setup('elevenlabs:scribe_v2', { deepgram: 'dg', gemini: 'gm' });
    expect((await failure(ctx.transcriber.transcribe(request))).kind).toBe('notConfigured');
    expect(ctx.fetchImpl).not.toHaveBeenCalled();
  });
});

describe('provider selection', () => {
  it.each([
    ['deepgram:nova-3', 'deepgram', 'from deepgram'],
    ['elevenlabs:scribe_v2', 'elevenlabs', 'from scribe'],
    ['gemini-audio:gemini-3.8-flash', 'generativelanguage', 'from gemini'],
  ])('%s calls only its own host', async (modelId, host, text) => {
    const ctx = setup(modelId, { deepgram: 'a', elevenlabs: 'b', gemini: 'c' });
    expect((await ctx.transcriber.transcribe(request)).text).toBe(text);
    expect(ctx.urls).toHaveLength(1);
    expect(ctx.urls[0]).toContain(host);
  });

  it('sends the Deepgram model string from the catalog', async () => {
    const ctx = setup('deepgram:nova-3-medical', { deepgram: 'a' });
    await ctx.transcriber.transcribe({ ...request, language: 'en' });
    expect(new URL(ctx.urls[0] as string).searchParams.get('model')).toBe('nova-3-medical');
  });

  it('runs Parakeet locally with the version and the language pin, no key and no network', async () => {
    const ctx = setup('parakeet:v3');
    const controller = new AbortController();
    expect((await ctx.transcriber.transcribe({ ...request, language: 'de' }, controller.signal)).text).toBe('from parakeet');
    expect(ctx.parakeet.transcribe).toHaveBeenCalledWith(request.audio, 'v3', controller.signal, 'de');
    expect(ctx.fetchImpl).not.toHaveBeenCalled();
  });

  it('refuses a language Parakeet does not speak before running it', async () => {
    const v2 = setup('parakeet:v2');
    const error = await failure(v2.transcriber.transcribe({ ...request, language: 'de' }));
    expect(error.message).toMatch(/only speaks English/);
    expect(v2.parakeet.transcribe).not.toHaveBeenCalled();
    const v3 = setup('parakeet:v3');
    expect((await failure(v3.transcriber.transcribe({ ...request, language: 'ja' }))).message).toMatch(/Japanese/);
  });

  it('passes a Parakeet "not downloaded" error through untouched', async () => {
    const ctx = setup('parakeet:v2');
    ctx.parakeet.transcribe.mockRejectedValueOnce(new ProviderError('notConfigured', 'Parakeet is not downloaded. Download it in Settings to use it.'));
    expect((await failure(ctx.transcriber.transcribe(request))).message).toBe('Parakeet is not downloaded. Download it in Settings to use it.');
  });

  it('treats a stale model id as the default, Nova-3', () => {
    expect(currentVoiceModel('whisper:large-v3').id).toBe('deepgram:nova-3');
  });
});

describe('the credential check before a dictation', () => {
  it('needs the key for a cloud model and nothing for a local one', () => {
    const keys: Partial<Record<KeyProvider, string>> = { gemini: 'g' };
    const key = (provider: KeyProvider): string | null => keys[provider] ?? null;
    expect(voiceCredential(currentVoiceModel('gemini-audio:gemini-3.8-flash'), key)).toBe('g');
    expect(voiceCredential(currentVoiceModel('elevenlabs:scribe_v2'), key)).toBeNull();
    expect(voiceCredential(currentVoiceModel('parakeet:v2'), key)).toBe('local');
  });
});

