    49	/** The English name of a pinned language, or null for auto and the modes. */
    50	export function pinnedLanguageName(pin: string): string | null {
    51	  if (pin === 'auto' || pin === 'multi') return null;
    52	  return DEEPGRAM_LANGUAGES.find((language) => language.code === pin)?.name ?? null;
    53	}
    54	
    55	export function buildRequest(audio: Uint8Array, hint: TranscriptionHint, config: GeminiTranscribeConfig): GeminiTranscribeRequest {
    56	  if (base64Length(audio.byteLength) > MAX_INLINE_BODY_BYTES) {
    57	    throw new ProviderError('badRequest', TOO_LONG_MESSAGE, { provider: PROVIDER });
    58	  }
    59	  const parts: Array<Record<string, unknown>> = [
    60	    { inlineData: { mimeType: 'audio/wav', data: Buffer.from(audio).toString('base64') } },
    61	  ];
