   373	    const snapshot = this.states();
   374	    for (const listener of [...this.listeners]) listener(snapshot);
   375	  }
   376	
   377	  // MARK: download
   378	
   379	  private async runDownload(version: ParakeetVersion, signal: AbortSignal): Promise<void> {
   380	    const root = this.modelsRoot();
   381	    const partial = this.partialPath(version);
   382	    const tmp = path.join(root, `.parakeet-${version}.extract`);
   383	    this.set(version, { status: 'downloading', progress: null });
   384	    try {
   385	      await fsp.mkdir(root, { recursive: true });
   386	      await this.fetchArchive(version, partial, signal);
   387	      // Progress stays at the end while the archive unpacks.
   388	      await fsp.rm(tmp, { recursive: true, force: true });
   389	      await fsp.mkdir(tmp);
   390	      try {
   391	        await this.extractImpl(partial, tmp, signal);
   392	      } catch (e) {
   393	        if (signal.aborted) throw new Cancelled();
   394	        await fsp.rm(partial, { force: true });
   395	        throw new Error(`The download is damaged and was removed. Try again. (${errorMessage(e)})`);
   396	      }
   397	      if (signal.aborted) throw new Cancelled();
   398	      const source = await this.findModelFolder(tmp);
   399	      const manifest = await this.verify(source, version);
   400	      await fsp.writeFile(path.join(source, MANIFEST), JSON.stringify(manifest), 'utf8');
   401	      const final = this.modelDir(version);
   402	      await fsp.rm(final, { recursive: true, force: true });
   403	      await fsp.rename(source, final);
   404	      await fsp.rm(tmp, { recursive: true, force: true });
   405	      await fsp.rm(partial, { force: true });
   406	      this.set(version, readState(final, version));
   407	      this.preload(version);
   408	    } catch (error) {
   409	      await fsp.rm(tmp, { recursive: true, force: true }).catch(() => undefined);
   410	      if (error instanceof Cancelled || signal.aborted) {
   411	        this.set(version, readState(this.modelDir(version), version));
   412	      } else {
   413	        this.set(version, { status: 'failed', message: errorMessage(error) });
   414	      }
   415	    }
   416	  }
   417	
   418	  private async fetchArchive(version: ParakeetVersion, partial: string, signal: AbortSignal): Promise<void> {
   419	    let have = 0;
   420	    try {
   421	      have = (await fsp.stat(partial)).size;
   422	    } catch {
   423	      have = 0;
   424	    }
   425	    let response: Response;
   426	    try {
   427	      response = await this.fetchImpl(parakeetArchiveUrl(version), {
   428	        signal,
   429	        headers: have > 0 ? { Range: `bytes=${have}-` } : {},
   430	      });
   431	    } catch (e) {
   432	      if (signal.aborted) throw new Cancelled();
   433	      throw new Error(`Couldn't reach the download server. Check your connection and try again. (${errorMessage(e)})`);
   434	    }
   435	    if (response.status === 416 && have > 0) {
   436	      // The partial file is not usable for this archive; start over.
   437	      await fsp.rm(partial, { force: true });
   438	      return this.fetchArchive(version, partial, signal);
   439	    }
   440	    if (response.status !== 200 && response.status !== 206) {
   441	      throw new Error(`The download failed (HTTP ${response.status}). Try again later.`);
   442	    }
   443	    const resumed = response.status === 206 && have > 0;
   444	    if (!resumed) have = 0;
   445	    const length = Number(response.headers.get('content-length'));
   446	    const total = Number.isFinite(length) && length > 0 ? have + length : null;
   447	    if (!response.body) throw new Error('The download server sent no data.');
   448	
   449	    const handle = await fsp.open(partial, resumed ? 'a' : 'w');
   450	    let received = have;
   451	    let lastEmit = 0;
   452	    try {
   453	      const reader = response.body.getReader();
   454	      for (;;) {
   455	        const { done, value } = await reader.read();
   456	        if (done) break;
   457	        await handle.write(value);
   458	        received += value.byteLength;
   459	        const now = Date.now();
   460	        if (now - lastEmit >= 200) {
   461	          lastEmit = now;
   462	          this.set(version, { status: 'downloading', progress: total ? Math.min(1, received / total) : null });
   463	        }
   464	      }
   465	    } catch (e) {
   466	      if (signal.aborted) throw new Cancelled();
   467	      throw new Error(`The download was interrupted. Try again to continue. (${errorMessage(e)})`);
   468	    } finally {
   469	      await handle.close();
   470	    }
   471	    if (total !== null && received !== total) {
   472	      throw new Error('The download was cut short. Try again to continue.');
   473	    }
   474	    this.set(version, { status: 'downloading', progress: 1 });
   475	  }
   476	
   477	  /** The archive holds one folder; accept the files at the top level too. */
   478	  private async findModelFolder(tmp: string): Promise<string> {
   479	    const candidates = [tmp];
   480	    for (const entry of await fsp.readdir(tmp, { withFileTypes: true })) {
   481	      if (entry.isDirectory()) candidates.push(path.join(tmp, entry.name));
   482	    }
   483	    for (const dir of candidates) {
   484	      if (fs.existsSync(path.join(dir, PARAKEET_FILES[0]))) return dir;
   485	    }
   486	    throw new Error('The download is missing model files. Try again.');
   487	  }
   488	
   489	  private async verify(dir: string, version: ParakeetVersion): Promise<Manifest> {
   490	    const files: Record<string, number> = {};
   491	    for (const name of PARAKEET_FILES) {
   492	      let size = 0;
   493	      try {
   494	        size = (await fsp.stat(path.join(dir, name))).size;
   495	      } catch {
   496	        size = 0;
   497	      }
   498	      if (size <= 0) throw new Error(`The download is missing ${name}. Try again.`);
   499	      files[name] = size;
   500	    }
   501	    return { version, files };
   502	  }
   503	}
     1	/**
     2	 * Runs Parakeet recognition inside an Electron utilityProcess so the 600+ MB model never
     3	 * blocks the main process. Started by parakeet.ts; one request at a time, answered in order.
     4	 */
     5	import { createRequire } from 'node:module';
     6	import os from 'node:os';
     7	import path from 'node:path';
     8	import type { ParakeetWorkerRequest, ParakeetWorkerResponse } from '../core/models/parakeetProtocol.js';
     9	
    10	interface Port {
    11	  on(event: 'message', listener: (event: { data: unknown }) => void): void;
    12	  postMessage(message: unknown): void;
    13	}
    14	
    15	interface Recognizer {
    16	  createStream(): { acceptWaveform(w: { sampleRate: number; samples: Float32Array }): void };
    17	  decode(stream: unknown): void;
    18	  getResult(stream: unknown): { text: string };
    19	}
    20	
    21	const loadModule = createRequire(import.meta.url);
    22	const port = (process as unknown as { parentPort?: Port }).parentPort;
    23	
    24	let loaded: { dir: string; recognizer: Recognizer } | null = null;
    25	
    26	function recognizerFor(dir: string): Recognizer {
    27	  if (loaded?.dir === dir) return loaded.recognizer;
    28	  loaded = null;
    29	  const sherpa = loadModule('sherpa-onnx-node') as {
    30	    OfflineRecognizer: new (config: unknown) => Recognizer;
    31	  };
    32	  const recognizer = new sherpa.OfflineRecognizer({
    33	    featConfig: { sampleRate: 16000, featureDim: 80 },
    34	    modelConfig: {
    35	      transducer: {
    36	        encoder: path.join(dir, 'encoder.int8.onnx'),
    37	        decoder: path.join(dir, 'decoder.int8.onnx'),
    38	        joiner: path.join(dir, 'joiner.int8.onnx'),
    39	      },
    40	      tokens: path.join(dir, 'tokens.txt'),
    41	      numThreads: Math.max(1, Math.min(4, os.cpus().length)),
    42	      provider: 'cpu',
    43	      debug: 0,
    44	      modelType: 'nemo_transducer',
    45	    },
    46	  });
    47	  loaded = { dir, recognizer };
    48	  return recognizer;
    49	}
    50	
    51	function handle(request: ParakeetWorkerRequest): ParakeetWorkerResponse {
    52	  try {
    53	    const t0 = Date.now();
    54	    const recognizer = recognizerFor(request.modelDir);
    55	    const t1 = Date.now();
    56	    if (request.loadOnly) return { id: request.id, ok: true, text: '', loadMs: t1 - t0, decodeMs: 0 };
    57	    const stream = recognizer.createStream();
    58	    stream.acceptWaveform({ sampleRate: request.sampleRate, samples: request.samples });
    59	    recognizer.decode(stream);
    60	    const text = recognizer.getResult(stream).text.trim();
    61	    return { id: request.id, ok: true, text, loadMs: t1 - t0, decodeMs: Date.now() - t1 };
    62	  } catch (error) {
    63	    return { id: request.id, ok: false, error: error instanceof Error ? error.message : String(error) };
    64	  }
    65	}
    66	
    67	if (port) {
    68	  port.on('message', (event) => {
    69	    port.postMessage(handle(event.data as ParakeetWorkerRequest));
    70	  });
    71	}

