    13	export const MAX_VOCABULARY_WORDS = 100;
    14	export const DEFAULT_DEADLINE_MS = 6000;
    15	/** The slower models get longer. */
    16	const DEADLINE_MS_BY_MODEL: Record<string, number> = { 'claude-sonnet-5-5': 10_000 };
