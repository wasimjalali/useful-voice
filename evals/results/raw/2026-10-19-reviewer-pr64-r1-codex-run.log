   159	  /** Starts or resumes a download. Failures land in the `failed` state; this doesn't throw for them. */
   160	  download(version: ParakeetVersion): Promise<void> {
   161	    const running = this.active.get(version);
   162	    if (running) return running.promise;
   163	    if (this.current[version].status === 'ready') return Promise.resolve();
   164	    const controller = new AbortController();
   165	    const promise = this.runDownload(version, controller.signal).finally(() => this.active.delete(version));
   166	    this.active.set(version, { controller, promise });
   167	    return promise;
   168	  }
   169	
   170	  /** Stops a download. The partial file is kept so the next download resumes. */
   171	  cancel(version: ParakeetVersion): void {
   172	    this.active.get(version)?.controller.abort();
   173	  }
   174	
   175	  async remove(version: ParakeetVersion): Promise<void> {
   176	    const running = this.active.get(version);
   177	    if (running) {
   178	      running.controller.abort();
   179	      await running.promise;
   180	    }
   181	    this.stopWorker();
   182	    await fsp.rm(this.modelDir(version), { recursive: true, force: true });
   183	    await fsp.rm(this.partialPath(version), { force: true });
