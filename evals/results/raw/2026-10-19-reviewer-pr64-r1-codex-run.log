    22	export type FormatterFailureKind = 'noKey' | 'cancelled' | 'timedOut' | 'transport' | 'http' | 'malformed' | 'guard';
    23	
    24	/** Why a format attempt produced nothing. `message` never holds the key or the dictation text. */
    25	export class FormatterError extends Error {
    26	  constructor(
    27	    readonly kind: FormatterFailureKind,
    28	    message: string,
    29	    readonly status?: number,
    30	  ) {
    31	    super(message);
    32	    this.name = 'FormatterError';
    33	  }
    34	}
    35	
    36	export function deadlineMsFor(model: CatalogModel): number {
    37	  return DEADLINE_MS_BY_MODEL[model.apiModel] ?? DEFAULT_DEADLINE_MS;
    38	}
    39	
    40	/** The user message: the dictionary words (at most 100) and the dictation. */
    41	export function buildUserMessage(text: string, vocabulary: readonly string[]): string {
    42	  const words = vocabulary.map((word) => word.trim()).filter((word) => word.length > 0).slice(0, MAX_VOCABULARY_WORDS);
    43	  const vocab = words.length > 0 ? `<vocabulary>${words.join(', ')}</vocabulary>\n` : '';
    44	  return `${vocab}<dictation>\n${text}\n</dictation>`;
