    45	function readState(dir: string, version: ParakeetVersion): ParakeetState {
    46	  try {
    47	    const manifest = JSON.parse(fs.readFileSync(path.join(dir, MANIFEST), 'utf8')) as Manifest;
    48	    if (manifest.version !== version) return { status: 'notDownloaded' };
    49	    let total = 0;
    50	    for (const name of PARAKEET_FILES) {
    51	      const expected = manifest.files?.[name];
    52	      const actual = fs.statSync(path.join(dir, name)).size;
    53	      if (typeof expected !== 'number' || expected <= 0 || actual !== expected) return { status: 'notDownloaded' };
    54	      total += actual;
    55	    }
    56	    return { status: 'ready', sizeBytes: total };
    57	  } catch {
    58	    return { status: 'notDownloaded' };
    59	  }
    60	}
