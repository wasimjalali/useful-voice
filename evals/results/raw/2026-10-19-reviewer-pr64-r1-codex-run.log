    41	/** A few ISO 639-3 codes Scribe answers with, mapped to the 639-1 codes the app stores. */
    42	const ISO3_TO_ISO1: Record<string, string> = {
    43	  eng: 'en', deu: 'de', fra: 'fr', spa: 'es', ita: 'it', por: 'pt', nld: 'nl', pol: 'pl', rus: 'ru', ukr: 'uk',
    44	  tur: 'tr', ara: 'ar', hin: 'hi', jpn: 'ja', kor: 'ko', zho: 'zh', cmn: 'zh', swe: 'sv', dan: 'da', nor: 'no',
    45	  fin: 'fi', ces: 'cs', ell: 'el', heb: 'he', hun: 'hu', ind: 'id', ron: 'ro', bul: 'bg', hrv: 'hr', slk: 'sk',
    46	  slv: 'sl', cat: 'ca', fas: 'fa', vie: 'vi', tha: 'th', lit: 'lt', lav: 'lv', est: 'et', msa: 'ms', ben: 'bn',
    47	};
    48	
    49	export function normaliseDetectedLanguage(code: unknown): string | null {
    50	  if (typeof code !== 'string') return null;
    51	  const lower = code.trim().toLowerCase().replace(/[^a-z-]/g, '');
    52	  if (lower.length === 0) return null;
    53	  return ISO3_TO_ISO1[lower] ?? lower;
    54	}
