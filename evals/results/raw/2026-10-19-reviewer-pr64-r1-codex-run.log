    68	/** Windows' own bsdtar reads .tar.bz2; elsewhere `tar` does the same. */
    69	export function defaultExtract(archive: string, destDir: string, signal: AbortSignal): Promise<void> {
    70	  const windowsTar = path.join(process.env.SystemRoot ?? 'C:\\Windows', 'System32', 'tar.exe');
    71	  const exe = process.platform === 'win32' && fs.existsSync(windowsTar) ? windowsTar : 'tar';
    72	  return new Promise((resolve, reject) => {
    73	    // Relative names and cwd keep a drive letter out of the arguments.
    74	    const child = spawn(exe, ['-xjf', path.basename(archive), '-C', path.basename(destDir)], {
    75	      cwd: path.dirname(archive),
    76	      windowsHide: true,
    77	      stdio: ['ignore', 'ignore', 'pipe'],
    78	    });
    79	    let stderr = '';
    80	    child.stderr.on('data', (d: Buffer) => (stderr = (stderr + d.toString()).slice(-500)));
    81	    const onAbort = () => child.kill();
    82	    signal.addEventListener('abort', onAbort, { once: true });
    83	    child.on('error', (e) => {
    84	      signal.removeEventListener('abort', onAbort);
    85	      reject(new Error(`Couldn't start tar: ${e.message}`));
    86	    });
    87	    child.on('close', (code) => {
    88	      signal.removeEventListener('abort', onAbort);
    89	      if (signal.aborted) reject(new Cancelled());
    90	      else if (code === 0) resolve();
    91	      else reject(new Error(`tar failed (${code}): ${stderr.trim()}`));
    92	    });
    93	  });
    94	}
