   790	function switchControl(label: string, checked: boolean, onChange: (value: boolean) => Promise<boolean>): HTMLElement {
   791	  const button = el('button', {
   792	    class: 'switch',
   793	    type: 'button',
   794	    role: 'switch',
   795	    'aria-checked': checked ? 'true' : 'false',
   796	    'aria-label': label,
   797	  } as never);
   798	  button.addEventListener('click', () => {
   799	    const next = button.getAttribute('aria-checked') !== 'true';
   800	    button.setAttribute('aria-checked', next ? 'true' : 'false');
   801	    void onChange(next).then((ok) => {
   802	      if (!ok) button.setAttribute('aria-checked', next ? 'false' : 'true');
