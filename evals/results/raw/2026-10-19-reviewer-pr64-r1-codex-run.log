   148	
   149	  states(): Record<ParakeetVersion, ParakeetState> {
   150	    return { v2: { ...this.current.v2 }, v3: { ...this.current.v3 } };
   151	  }
   152	
   153	  /** Called with every state change (download progress included). Returns an unsubscribe. */
   154	  onChange(listener: (states: Record<ParakeetVersion, ParakeetState>) => void): () => void {
   155	    this.listeners.add(listener);
   156	    return () => this.listeners.delete(listener);
   157	  }
