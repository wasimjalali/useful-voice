    fs.appendFileSync(path.join(model, 'encoder.int8.onnx'), 'x');
    expect(new ParakeetModels(dir).states().v2.status).toBe('notDownloaded');
  });

  it('is ready with the total size when every file matches', () => {
    seedReady('v2');
    const total = FILES.reduce((n, f) => n + `data-${f}`.length, 0);
    expect(new ParakeetModels(dir).states().v2).toEqual({ status: 'ready', sizeBytes: total });
  });

  it('transcribe refuses a model that is not downloaded', async () => {
    await expect(new ParakeetModels(dir).transcribe(wav(), 'v2')).rejects.toMatchObject({ kind: 'notConfigured' });
  });
});

describe('download', () => {
  const body = new Uint8Array(40).map((_, i) => i);

  it('fails with a readable message on an HTTP error and on a dead network', async () => {
    const http = new ParakeetModels(dir, { fetch: fetchOf(body, { status: 404 }).impl, extract: extractorWith(FILES) });
    await http.download('v2');
    expect(http.states().v2).toEqual({ status: 'failed', message: expect.stringContaining('HTTP 404') });

    const dead = new ParakeetModels(dir, {
      fetch: (async () => {
        throw new TypeError('fetch failed');
      }) as unknown as typeof fetch,
    });
    await dead.download('v2');
    expect(dead.states().v2).toMatchObject({ status: 'failed', message: expect.stringContaining('Check your connection') });
  });

  it('keeps the partial file when the connection drops, then resumes with a Range request', async () => {
    const first = new ParakeetModels(dir, { fetch: fetchOf(body, { failAfter: 16 }).impl, extract: extractorWith(FILES) });
    await first.download('v2');
    expect(first.states().v2.status).toBe('failed');
    const partial = path.join(dir, 'models', 'parakeet-v2.partial');
    expect(fs.statSync(partial).size).toBe(16);
    expect(first.states().v2.status).not.toBe('ready');

    const second = fetchOf(body);
    const models = new ParakeetModels(dir, { fetch: second.impl, extract: extractorWith(FILES) });
    await models.download('v2');
    expect(second.calls[0]?.range).toBe('bytes=16-');
    expect(models.states().v2.status).toBe('ready');
    expect(fs.existsSync(partial)).toBe(false);
  });

  it('restarts when the server ignores Range and sends the whole file', async () => {
    fs.mkdirSync(path.join(dir, 'models'), { recursive: true });
    fs.writeFileSync(path.join(dir, 'models', 'parakeet-v2.partial'), new Uint8Array(10));
    let archiveBytes = 0;
    const models = new ParakeetModels(dir, {
      fetch: (async () => fetchOf(body).impl('', {})) as unknown as typeof fetch,
      extract: async (archive, dest) => {
        archiveBytes = fs.statSync(archive).size;
        await extractorWith(FILES)(archive, dest);
      },
    });
    await models.download('v2');
    expect(archiveBytes).toBe(40);
    expect(models.states().v2.status).toBe('ready');
  });

  it('drops a damaged partial that the server rejects with 416 and starts over', async () => {
    fs.mkdirSync(path.join(dir, 'models'), { recursive: true });
    fs.writeFileSync(path.join(dir, 'models', 'parakeet-v2.partial'), new Uint8Array(99));
    let n = 0;
    const ok = fetchOf(body).impl;
    const models = new ParakeetModels(dir, {
      fetch: (async (u: unknown, o?: RequestInit) => (n++ === 0 ? new Response('', { status: 416 }) : ok(u as string, o))) as typeof fetch,
      extract: extractorWith(FILES),
    });
    await models.download('v2');
    expect(models.states().v2.status).toBe('ready');
  });

  it('rejects an archive with a missing file, never moves it into place and removes the bad partial', async () => {
    const models = new ParakeetModels(dir, {
      fetch: fetchOf(body).impl,
      extract: extractorWith(FILES.filter((f) => f !== 'tokens.txt')),
    });
    await models.download('v2');
    expect(models.states().v2).toEqual({ status: 'failed', message: expect.stringContaining('tokens.txt') });
    expect(fs.existsSync(path.join(dir, 'models', 'parakeet-v2'))).toBe(false);
    expect(fs.existsSync(path.join(dir, 'models', '.parakeet-v2.extract'))).toBe(false);
  });

  it('rejects an empty model file', async () => {
    const models = new ParakeetModels(dir, {
      fetch: fetchOf(body).impl,
      extract: async (_a, dest) => {
        fs.mkdirSync(path.join(dest, 'x'));
        for (const n of FILES) fs.writeFileSync(path.join(dest, 'x', n), n === 'decoder.int8.onnx' ? '' : 'ok');
      },
    });
    await models.download('v2');
    expect(models.states().v2).toMatchObject({ status: 'failed', message: expect.stringContaining('decoder.int8.onnx') });
  });

  it('turns a failing extractor into a failed state and deletes the corrupt archive', async () => {
    const models = new ParakeetModels(dir, {
      fetch: fetchOf(body).impl,
      extract: async () => {
        throw new Error('bzip2: data error');
      },
    });
    await models.download('v2');
    expect(models.states().v2).toMatchObject({ status: 'failed', message: expect.stringContaining('damaged') });
    expect(fs.existsSync(path.join(dir, 'models', 'parakeet-v2.partial'))).toBe(false);
    expect(
      parseGeminiResponse({
        candidates: [{ content: { parts: [{ text: 'thinking...', thought: true }, { text: 'Hello ' }, { text: 'there.' }] } }, { content: { parts: [{ text: 'ignored' }] } }],
      }),
    ).toBe('Hello there.');
  });
  it('treats a blocked prompt or garbage as empty', () => {
    expect(parseGeminiResponse({ promptFeedback: { blockReason: 'SAFETY' } })).toBe('');
    expect(parseGeminiResponse(null)).toBe('');
    expect(parseGeminiResponse({ candidates: [{}] })).toBe('');
  });
  it('joins only the Anthropic text blocks, not content[0]', () => {
    expect(
      parseAnthropicResponse({ content: [{ type: 'thinking', thinking: 'hmm' }, { type: 'text', text: 'Hello ' }, { type: 'text', text: 'there.' }] }),
    ).toBe('Hello there.');
    expect(parseAnthropicResponse({ content: [] })).toBe('');
  });
});

function reply(body: unknown, status = 200): Response {
  return new Response(typeof body === 'string' ? body : JSON.stringify(body), { status });
}
const geminiOk = (text: string) => reply({ candidates: [{ content: { parts: [{ text }] } }] });
const anthropicOk = (text: string) => reply({ content: [{ type: 'text', text }] });
const base = { text: SPOKEN, vocabulary: [] as string[] };

async function failure(promise: Promise<string>): Promise<FormatterError> {
  try {
    await promise;
  } catch (error) {
    expect(error).toBeInstanceOf(FormatterError);
    return error as FormatterError;
  }
  throw new Error('expected a failure');
}

describe('formatWithModel', () => {
  it('returns the guarded text from Gemini', async () => {
    const fetchImpl = vi.fn(async () => geminiOk('Send the report on Wednesday.'));
    const result = await formatWithModel({ ...base, model: gemini, apiKey: 'K', fetchImpl: fetchImpl as never });
    expect(result).toBe('Send the report on Wednesday.');
    expect(fetchImpl).toHaveBeenCalledOnce();
  });

  it('returns the guarded text from Anthropic', async () => {
    const fetchImpl = vi.fn(async () => anthropicOk('Send the report on Wednesday.'));
    expect(await formatWithModel({ ...base, model: haiku, apiKey: 'K', fetchImpl: fetchImpl as never })).toBe('Send the report on Wednesday.');
  });

  it('retries once without the thinking field when a 400 mentions thinking', async () => {
    const bodies: Array<Record<string, unknown>> = [];
    const fetchImpl = vi.fn(async (_url: string, init: RequestInit) => {
      bodies.push(JSON.parse(init.body as string) as Record<string, unknown>);
      return bodies.length === 1
        ? reply({ error: { type: 'invalid_request_error', message: 'thinking.type: disabled is not supported' } }, 400)
        : anthropicOk('Send the report on Wednesday.');
    });
    expect(await formatWithModel({ ...base, model: sonnet, apiKey: 'K', fetchImpl: fetchImpl as never })).toBe('Send the report on Wednesday.');
    expect(bodies[0]).toHaveProperty('thinking');
    expect(bodies[1]).not.toHaveProperty('thinking');
  });

  it('does not retry a 400 that is not about thinking', async () => {
    const fetchImpl = vi.fn(async () => reply({ error: { message: 'max_tokens too large' } }, 400));
    const error = await failure(formatWithModel({ ...base, model: haiku, apiKey: 'K', fetchImpl: fetchImpl as never }));
    expect(error.kind).toBe('http');
    expect(error.status).toBe(400);
    expect(fetchImpl).toHaveBeenCalledOnce();
  });

  it('fails with the guard reason when the answer is refused', async () => {
    const fetchImpl = vi.fn(async () => geminiOk("Sure, here's your text."));
    const error = await failure(formatWithModel({ ...base, model: gemini, apiKey: 'K', fetchImpl: fetchImpl as never }));
    expect(error.kind).toBe('guard');
  });

  it('fails on an HTTP error, and the message never holds the key', async () => {
    const fetchImpl = vi.fn(async () => reply('{"error":"bad key SECRETKEY"}', 401));
    const error = await failure(formatWithModel({ ...base, model: gemini, apiKey: 'SECRETKEY', fetchImpl: fetchImpl as never }));
    expect(error.kind).toBe('http');
    expect(error.message).not.toContain('SECRETKEY');
  });

  it('fails on a dead network without leaking the key', async () => {
    const fetchImpl = vi.fn(async () => {
      throw new TypeError('fetch failed for https://x/?key=SECRETKEY');
    });
    const error = await failure(formatWithModel({ ...base, model: haiku, apiKey: 'SECRETKEY', fetchImpl: fetchImpl as never }));
    expect(error.kind).toBe('transport');
    expect(error.message).not.toContain('SECRETKEY');
  });

  it('fails on a body that is not JSON', async () => {
    const fetchImpl = vi.fn(async () => reply('<html>', 200));
    expect((await failure(formatWithModel({ ...base, model: gemini, apiKey: 'K', fetchImpl: fetchImpl as never }))).kind).toBe('malformed');
  });

  it('times out at the deadline', async () => {
    const fetchImpl = vi.fn(
      (_url: string, init: RequestInit) =>
        new Promise<Response>((_resolve, reject) => {
          init.signal?.addEventListener('abort', () => reject(new DOMException('aborted', 'AbortError')));
        }),
    );
    const error = await failure(formatWithModel({ ...base, model: gemini, apiKey: 'K', fetchImpl: fetchImpl as never, deadlineMs: 30 }));
    expect(error.kind).toBe('timedOut');
  });

  it('is cancelled by the dictation cancel', async () => {
    const controller = new AbortController();
    const fetchImpl = vi.fn(
      (_url: string, init: RequestInit) =>
        new Promise<Response>((_resolve, reject) => {
          init.signal?.addEventListener('abort', () => reject(new DOMException('aborted', 'AbortError')));
        }),
    );
    const pending = failure(formatWithModel({ ...base, model: gemini, apiKey: 'K', fetchImpl: fetchImpl as never, signal: controller.signal }));
    controller.abort();
    expect((await pending).kind).toBe('cancelled');
  });
});
