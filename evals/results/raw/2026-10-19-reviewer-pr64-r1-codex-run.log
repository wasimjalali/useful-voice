     1	import { appendFileSync } from 'node:fs';
     2	import path from 'node:path';
     3	
     4	/**
     5	 * Provider stand-ins for the Playwright suite. Installed only when the app was launched
     6	 * with `--e2e` (see `index.ts`), so a shipped build never reaches this file's code path.
     7	 *
     8	 * Each answers every request to its provider's host from the key in the request, so the suite
     9	 * can walk the real key checks and the real dictation pipeline:
    10	 *   - a key that starts with `valid`: 200 with a fixture answer
    11	 *   - a key that starts with `slow`: the same, after 1.5 s (a check that is still running)
    12	 *   - a key that starts with `offline`: the request fails like a dead network
    13	 *   - any other key: 401, as the provider answers a wrong key
    14	 * Hosts: api.deepgram.com, api.elevenlabs.io, generativelanguage.googleapis.com (Gemini voice
    15	 * and formatting) and api.anthropic.com (formatting). Each request is appended to
    16	 * `<userData>/e2e.log` (URL only, never the key, audio or text), so a spec can assert which
    17	 * model the app asked for.
    18	 */
    19	
    20	export const E2E_TRANSCRIPT = 'Hello from Useful Voice.';
    21	export const E2E_ELEVENLABS_TRANSCRIPT = 'Hello from Scribe, the ElevenLabs model.';
    22	export const E2E_GEMINI_TRANSCRIPT = 'Hello from Gemini, the voice model.';
    23	
    24	/** What the formatter stubs make of a dictation: the text, marked with who formatted it. */
    25	export function e2eFormatted(text: string, provider: 'Gemini' | 'Anthropic'): string {
    26	  return `${text.trim()} (formatted by ${provider})`;
    27	}
    28	
    29	type StubHost = 'deepgram' | 'elevenlabs' | 'gemini' | 'anthropic';
    30	
    31	const HOSTS: Array<[string, StubHost]> = [
    32	  ['https://api.deepgram.com/', 'deepgram'],
    33	  ['https://api.elevenlabs.io/', 'elevenlabs'],
    34	  ['https://generativelanguage.googleapis.com/', 'gemini'],
    35	  ['https://api.anthropic.com/', 'anthropic'],
    36	];
    37	
    38	function keyOf(host: StubHost, headers: Headers): string {
    39	  switch (host) {
    40	    case 'deepgram':
    41	      return (headers.get('authorization') ?? '').replace(/^Token\s+/i, '');
    42	    case 'elevenlabs':
    43	      return headers.get('xi-api-key') ?? '';
    44	    case 'gemini':
    45	      return headers.get('x-goog-api-key') ?? '';
    46	    case 'anthropic':
    47	      return headers.get('x-api-key') ?? '';
    48	  }
    49	}
    50	
    51	const json = (body: unknown, status = 200): Response =>
    52	  new Response(JSON.stringify(body), { status, headers: { 'content-type': 'application/json' } });
    53	
    54	const refused = (host: StubHost): Response => {
    55	  switch (host) {
    56	    case 'deepgram':
    57	      return json({ err_code: 'INVALID_AUTH', err_msg: 'Invalid credentials.' }, 401);
    58	    case 'elevenlabs':
    59	      return json({ detail: { status: 'invalid_api_key', message: 'Invalid API key' } }, 401);
    60	    case 'gemini':
    61	      return json({ error: { code: 400, status: 'INVALID_ARGUMENT', message: 'API key not valid. API_KEY_INVALID' } }, 400);
    62	    case 'anthropic':
    63	      return json({ type: 'error', error: { type: 'authentication_error', message: 'invalid x-api-key' } }, 401);
    64	  }
    65	};
    66	
    67	/** The dictation text out of the formatter's user message. */
    68	function dictationIn(userMessage: string): string {
    69	  return /<dictation>\n([\s\S]*)\n<\/dictation>/.exec(userMessage)?.[1] ?? userMessage;
    70	}
    71	
    72	async function answer(host: StubHost, init: RequestInit | undefined): Promise<Response> {
    73	  const method = (init?.method ?? 'GET').toUpperCase();
    74	  if (host === 'deepgram') {
    75	    return json({ results: { channels: [{ alternatives: [{ transcript: E2E_TRANSCRIPT }] }], duration: 1 } });
    76	  }
    77	  if (host === 'elevenlabs') {
    78	    if (method === 'GET') return json({ models: [] });
    79	    return json({ text: E2E_ELEVENLABS_TRANSCRIPT, language_code: 'eng', audio_duration_secs: 1 });
    80	  }
    81	  const body = typeof init?.body === 'string' ? (JSON.parse(init.body) as Record<string, unknown>) : {};
    82	  if (host === 'gemini') {
    83	    if (method === 'GET') return json({ name: 'models/gemini-3.8-flash' });
    84	    const contents = body.contents as Array<{ parts: Array<{ text?: string; inlineData?: unknown }> }> | undefined;
    85	    const parts = contents?.[0]?.parts ?? [];
    86	    // Audio in: this is the voice model. Text in: this is the formatter.
    87	    const text = parts.some((part) => part.inlineData !== undefined)
    88	      ? E2E_GEMINI_TRANSCRIPT
    89	      : e2eFormatted(dictationIn(parts.map((part) => part.text ?? '').join('')), 'Gemini');
    90	    return json({ candidates: [{ content: { role: 'model', parts: [{ text }] } }] });
    91	  }
    92	  if (method === 'GET') return json({ data: [] });
    93	  const messages = body.messages as Array<{ content?: string }> | undefined;
    94	  return json({ content: [{ type: 'text', text: e2eFormatted(dictationIn(messages?.[0]?.content ?? ''), 'Anthropic') }] });
    95	}
    96	
    97	export function installProviderStubs(userData: string): void {
    98	  const real = globalThis.fetch.bind(globalThis);
    99	  const log = (host: StubHost, line: string): void => {
   100	    try {
   101	      appendFileSync(path.join(userData, 'e2e.log'), `${new Date().toISOString()} ${host} ${line}\n`);
   102	    } catch {
   103	      // The log is a diagnostic aid only.
   104	    }
   105	  };
   106	  globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {
   107	    const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
   108	    const host = HOSTS.find(([prefix]) => url.startsWith(prefix))?.[1];
   109	    if (!host) return real(input, init);
   110	    const key = keyOf(host, new Headers(init?.headers));
   111	    log(host, `${(init?.method ?? 'GET').toUpperCase()} ${url}`);
   112	    if (key.startsWith('offline')) throw new TypeError('fetch failed');
   113	    if (key.startsWith('slow')) await new Promise((resolve) => setTimeout(resolve, 1500));
   114	    if (!key.startsWith('valid') && !key.startsWith('slow')) return refused(host);
   115	    return answer(host, init);
   116	  }) as typeof fetch;
   117	}
{
  "name": "useful-voice-windows",
  "productName": "Useful Voice",
  "version": "0.1.0",
  "description": "Voice-to-text dictation for Windows, powered by Deepgram Nova-3.",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "author": {
    "name": "Useful Build"
  },
  "license": "SEE LICENSE IN ../LICENSE",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:icon": "node scripts/make-icon.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build && electron .",
    "self-test": "npm run build && electron . --self-test --report=self-test-report.txt",
    "e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm test && npm run build && npm run self-test",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.2",
    "electron": "43.7.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "ai.useful.voice",
    "productName": "Useful Voice",
    "copyright": "Copyright © Useful Build",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/sherpa-onnx-darwin-*/**",
      "!node_modules/sherpa-onnx-linux-*/**",
      "!node_modules/sherpa-onnx-win-ia32/**"
    ],
    "extraResources": [
      {
        "from": "build/tray",
        "to": "tray"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "wasimjalali",
        "repo": "useful-voice-releases",
        "releaseType": "release"
      }
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "publisherName": "Useful Build"
      },
      "legalTrademarks": "Useful Voice",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "guid": "cfa29547-fa82-5f74-b344-dfe1c5823243",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Useful Voice",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-x64/**"
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "sherpa-onnx-node": "1.13.8"
  }
}
