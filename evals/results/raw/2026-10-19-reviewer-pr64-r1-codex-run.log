   354	  }
   355	
   356	  // MARK: paths and state
   357	
   358	  private modelsRoot(): string {
   359	    return path.join(this.dataDir, 'models');
   360	  }
   361	
   362	  private modelDir(version: ParakeetVersion): string {
   363	    return path.join(this.modelsRoot(), `parakeet-${version}`);
   364	  }
   365	
   366	  private partialPath(version: ParakeetVersion): string {
   367	    return path.join(this.modelsRoot(), `parakeet-${version}.partial`);
   368	  }
   369	
   370	  private set(version: ParakeetVersion, state: ParakeetState): void {
   371	    this.current = { ...this.current, [version]: state };
