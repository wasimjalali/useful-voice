   209	async function safeText(response: Response): Promise<string> {
   210	  try {
   211	    return await response.text();
   212	  } catch {
   213	    return '';
   214	  }
   215	}
     1	/**
     2	 * The guard between a language model's answer and the user's document.
     3	 *
     4	 * A formatter that answers the dictation, adds a preamble or drops half the text must never
     5	 * reach the paste. Pure, so every rejection rule is unit-tested.
     6	 */
     7	
     8	export type GuardResult = { ok: true; text: string } | { ok: false; reason: string };
     9	
    10	const PREAMBLE = /^(here is|here's|sure|certainly|i've|i have|of course)\b/i;
    11	
    12	/** Words in a dictation at or under this count are not sent to a model at all. */
    13	export const MIN_FORMATTER_WORDS = 3;
    14	
    15	function stripWrappingFence(text: string): string {
    16	  const match = /^```[^\n`]*\n([\s\S]*?)\n?```$/.exec(text);
    17	  return match ? (match[1] ?? '').trim() : text;
    18	}
    19	
    20	function stripWrappingDictationTag(text: string): string {
    21	  const match = /^<dictation>([\s\S]*)<\/dictation>$/i.exec(text);
    22	  return match ? (match[1] ?? '').trim() : text;
    23	}
    24	
    25	/** Check a model's output against the text it was given. Returns the cleaned text or the reason it was refused. */
    26	export function guardFormatted(input: string, output: string): GuardResult {
    27	  let text = output.trim();
    28	  text = stripWrappingFence(text);
    29	  text = stripWrappingDictationTag(text);
    30	  text = text.trim();
    31	
    32	  if (text.length === 0) return { ok: false, reason: 'empty output' };
    33	  if (text.length > input.length * 2 + 40) return { ok: false, reason: 'output much longer than the input' };
    34	  if (input.length >= 20 && text.length < input.length * 0.4) return { ok: false, reason: 'output much shorter than the input' };
    35	  // A dictation that really starts "I have to go" must not be refused for sounding like a preamble.
    36	  if (PREAMBLE.test(text) && !PREAMBLE.test(input.trim())) {
    37	    return { ok: false, reason: 'output starts with an assistant preamble' };
    38	  }
    39	  return { ok: true, text };
    40	}
    41	
    42	/** Whether a transcript is long enough to be worth formatting. */
    43	export function worthFormatting(text: string): boolean {
    44	  return text.split(/\s+/).filter((token) => token.length > 0).length >= MIN_FORMATTER_WORDS;
    45	}
