   128	export interface FormatOptions {
   129	  model: CatalogModel;
   130	  apiKey: string;
   131	  text: string;
   132	  vocabulary: readonly string[];
   133	  /** The dictation's cancel. */
   134	  signal?: AbortSignal;
   135	  /** Injected for tests. */
   136	  fetchImpl?: typeof fetch;
   137	  /** Overrides the model's deadline; tests. */
   138	  deadlineMs?: number;
   139	}
