   100	interface GeminiResponse {
   101	  candidates?: Array<{ content?: { parts?: Array<{ text?: unknown; thought?: unknown }> } }>;
   102	}
   103	
   104	/** The joined non-thought text parts of the first candidate. Empty when there are none (a blocked prompt). */
   105	export function parseGeminiResponse(payload: unknown): string {
