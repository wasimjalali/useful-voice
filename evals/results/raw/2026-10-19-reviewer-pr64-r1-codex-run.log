   186	
   187	  /**
   188	   * Transcribe a 16 kHz mono 16-bit WAV. Throws ProviderError('notConfigured') when the model
   189	   * isn't downloaded. Honors `signal`. `language` is the person's pin ('auto' or a code); a
   190	   * language the model doesn't speak fails before any work.
   191	   */
   192	  async transcribe(
   193	    wav: Uint8Array,
   194	    version: ParakeetVersion,
   195	    signal?: AbortSignal,
   196	    language?: string,
   197	  ): Promise<Transcript> {
   198	    const pin = checkParakeetLanguage(version, language);
   199	    if (this.current[version].status !== 'ready') {
   200	      throw new ProviderError('notConfigured', 'Parakeet is not downloaded. Download it in Settings to use it.');
   201	    }
   202	    if (signal?.aborted) throw new ProviderError('cancelled', 'Transcription was cancelled.');
   203	    const audio = parseWavToFloat32(wav);
   204	    if (audio.samples.length === 0) return { text: '', durationSeconds: 0, detectedLanguage: pin };
   205	
   206	    // A preload in flight loads the model once; wait for it rather than loading twice.
   207	    if (this.preloading) await this.preloading;
   208	    const response = await this.exchange(version, audio.samples, audio.sampleRate, audio.durationSeconds, signal, false);
   209	    if (!response.ok) {
   210	      throw new ProviderError('transport', `Parakeet couldn't transcribe: ${response.error}`);
   211	    }
   212	    return { text: response.text, durationSeconds: audio.durationSeconds, detectedLanguage: pin };
   213	  }
   214	
   215	  /**
   216	   * Start the worker and load the model in the background when it is downloaded and not loaded.
   217	   * A no-op otherwise. Never throws; failures are logged.
   218	   */
   219	  preload(version: ParakeetVersion): void {
   220	    if (this.disposed || this.preloading || this.current[version].status !== 'ready') return;
   221	    if (this.worker && this.workerVersion === version) return;
   222	    const task = this.exchange(version, new Float32Array(0), 16000, 0, undefined, true)
   223	      .then((r) => {
   224	        if (!r.ok) console.warn(`Parakeet ${version} preload failed: ${r.error}`);
   225	      })
   226	      .catch((e: unknown) => console.warn(`Parakeet ${version} preload failed: ${errorMessage(e)}`))
   227	      .finally(() => {
   228	        if (this.preloading === task) this.preloading = null;
   229	      });
   230	    this.preloading = task;
   231	  }
   232	
   233	  /** The pinned version's worker is never stopped by the idle timer. Null unpins. */
   234	  setPinned(version: ParakeetVersion | null): void {
   235	    this.pinned = version;
   236	    this.armIdle();
   237	  }
   238	
   239	  private async exchange(
   240	    version: ParakeetVersion,
   241	    samples: Float32Array,
   242	    sampleRate: number,
   243	    seconds: number,
   244	    signal: AbortSignal | undefined,
   245	    loadOnly: boolean,
   246	  ): Promise<ParakeetWorkerResponse> {
   247	    const worker = await this.ensureWorker();
   248	    if (signal?.aborted) throw new ProviderError('cancelled', 'Transcription was cancelled.');
   249	    this.clearIdle();
   250	
   251	    const id = this.nextId++;
   252	    return new Promise<ParakeetWorkerResponse>((resolve, reject) => {
   253	      let timer: ReturnType<typeof setTimeout> | undefined;
   254	      const finish = () => {
   255	        if (timer) clearTimeout(timer);
   256	        signal?.removeEventListener('abort', onAbort);
   257	        this.pending.delete(id);
   258	      };
   259	      // The result of a cancelled request is dropped, the process keeps its loaded model.
   260	      const onAbort = () => {
   261	        finish();
   262	        reject(new ProviderError('cancelled', 'Transcription was cancelled.'));
   263	      };
   264	      this.pending.set(id, (r) => {
   265	        finish();
   266	        if (r instanceof Error) reject(r);
   267	        else {
   268	          if (r.ok && this.worker === worker) this.workerVersion = version;
   269	          resolve(r);
   270	        }
   271	      });
   272	      signal?.addEventListener('abort', onAbort, { once: true });
   273	      timer = setTimeout(() => {
   274	        finish();
   275	        // A stuck recognition can't be interrupted, so the process goes and the next request restarts it.
   276	        this.stopWorker();
   277	        reject(new ProviderError('timedOut', 'Parakeet took too long to transcribe. Try again.'));
   278	      }, this.timeoutFor(seconds));
   279	      try {
   280	        worker.postMessage({ id, modelDir: this.modelDir(version), samples, sampleRate, loadOnly });
   281	      } catch (e) {
   282	        finish();
   283	        reject(new ProviderError('transport', `Parakeet couldn't start: ${errorMessage(e)}`));
   284	      }
   285	    }).finally(() => this.armIdle());
   286	  }
   287	
   288	  /** Stop any worker process and downloads. Called at quit. */
   289	  dispose(): void {
   290	    this.disposed = true;
   291	    for (const { controller } of this.active.values()) controller.abort();
   292	    this.stopWorker();
   293	    this.listeners.clear();
   294	  }
   295	
   296	  // MARK: worker
   297	
   298	  private async ensureWorker(): Promise<ParakeetWorkerHandle> {
   299	    if (this.disposed) throw new ProviderError('cancelled', 'Parakeet is shutting down.');
   300	    if (this.worker) return this.worker;
   301	    this.starting ??= this.spawnWorker()
   302	      .then((w) => {
   303	        w.onMessage((m) => this.pending.get(m.id)?.(m));
   304	        w.onExit((reason) => {
   305	          if (this.worker !== w) return;
   306	          this.worker = null;
   307	          this.workerVersion = null;
   308	          this.clearIdle();
   309	          this.failPending(reason);
   310	        });
   311	        if (this.disposed) {
   312	          w.kill();
   313	          throw new ProviderError('cancelled', 'Parakeet is shutting down.');
   314	        }
   315	        this.worker = w;
   316	        return w;
   317	      })
   318	      .catch((e: unknown) => {
   319	        throw e instanceof ProviderError
   320	          ? e
   321	          : new ProviderError('transport', `Couldn't start the Parakeet engine: ${errorMessage(e)}`);
   322	      })
   323	      .finally(() => {
   324	        this.starting = null;
   325	      });
   326	    return this.starting;
   327	  }
   328	
   329	  private failPending(reason: string): void {
   330	    const error = new ProviderError('transport', `The Parakeet engine stopped unexpectedly (${reason}). Try again.`);
   331	    for (const resolve of [...this.pending.values()]) resolve(error);
   332	  }
   333	
   334	  private stopWorker(): void {
   335	    this.clearIdle();
   336	    const worker = this.worker;
   337	    this.worker = null;
   338	    this.workerVersion = null;
   339	    if (worker) worker.kill();
   340	    if (this.pending.size > 0) this.failPending('stopped');
   341	  }
   342	
   343	  private armIdle(): void {
   344	    this.clearIdle();
   345	    if (!this.worker || this.pending.size > 0) return;
   346	    if (this.pinned !== null && this.pinned === this.workerVersion) return;
   347	    this.idleTimer = setTimeout(() => this.stopWorker(), this.idleMs);
   348	    this.idleTimer.unref?.();
   349	  }
   350	
   351	  private clearIdle(): void {
