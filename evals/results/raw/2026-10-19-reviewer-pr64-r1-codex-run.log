   147	/**
   148	 * Format `text` with the model. Resolves to the guarded text, or throws a FormatterError
   149	 * saying why the caller should fall back to the unformatted transcript.
   150	 */
   151	export async function formatWithModel(options: FormatOptions): Promise<string> {
   152	  const { model, apiKey, text, signal } = options;
   153	  const doFetch = options.fetchImpl ?? fetch;
   154	  const userMessage = buildUserMessage(text, options.vocabulary);
   155	  const deadlineMs = options.deadlineMs ?? deadlineMsFor(model);
   156	  const timeout = AbortSignal.timeout(deadlineMs);
   157	  const combined = signal ? AbortSignal.any([signal, timeout]) : timeout;
   158	
   159	  const send = async (spec: HttpRequestSpec): Promise<Response> => {
   160	    try {
   161	      return await doFetch(spec.url, {
   162	        method: 'POST',
   163	        headers: spec.headers,
   164	        body: JSON.stringify(spec.body),
   165	        signal: combined,
   166	      });
   167	    } catch (error) {
   168	      if (signal?.aborted) throw new FormatterError('cancelled', 'the dictation was cancelled');
   169	      if (timeout.aborted) throw new FormatterError('timedOut', `no answer within ${deadlineMs / 1000} s`);
   170	      throw new FormatterError('transport', redact(error instanceof Error ? error.message : String(error), apiKey));
   171	    }
   172	  };
