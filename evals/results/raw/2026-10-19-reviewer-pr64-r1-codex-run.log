   174	  let response: Response;
   175	  if (model.provider === 'gemini') {
   176	    response = await send(buildGeminiRequest(model, apiKey, userMessage));
   177	  } else if (model.provider === 'anthropic') {
   178	    response = await send(buildAnthropicRequest(model, apiKey, userMessage));
