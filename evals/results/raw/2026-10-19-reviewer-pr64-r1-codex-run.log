   185	        throw new FormatterError('http', `HTTP 400 ${redact(body, apiKey)}`.trim(), 400);
   186	      }
   187	    }
   188	  } else {
   189	    throw new FormatterError('http', `${model.provider} is not a formatter`);
   190	  }
   191	
   192	  if (!response.ok) {
   193	    const body = await safeText(response);
   194	    throw new FormatterError('http', `HTTP ${response.status} ${redact(body, apiKey)}`.trim(), response.status);
   195	  }
   196	
   197	  let payload: unknown;
   198	  try {
   199	    payload = await response.json();
   200	  } catch {
   201	    throw new FormatterError('malformed', 'the answer was not JSON');
   202	  }
   203	  const raw = model.provider === 'gemini' ? parseGeminiResponse(payload) : parseAnthropicResponse(payload);
   204	  const guarded = guardFormatted(text, raw);
   205	  if (!guarded.ok) throw new FormatterError('guard', guarded.reason);
   206	  return guarded.text;
   207	}
