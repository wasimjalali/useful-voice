   133	  /** `dataDir` is the app's data folder; models live in `<dataDir>/models/parakeet-<version>/`. */
   134	  constructor(
   135	    readonly dataDir: string,
   136	    deps: ParakeetDeps = {},
   137	  ) {
   138	    this.fetchImpl = deps.fetch ?? fetch;
   139	    this.extractImpl = deps.extract ?? defaultExtract;
   140	    this.spawnWorker = deps.spawnWorker ?? defaultSpawnWorker;
   141	    this.idleMs = deps.idleMs ?? IDLE_MS;
   142	    this.timeoutFor = deps.requestTimeoutMs ?? ((seconds) => 30_000 + Math.ceil(seconds) * 1000);
