    67	    url: `${config.endpoint ?? GEMINI_ENDPOINT}/${config.model}:generateContent`,
    68	    headers: { 'x-goog-api-key': config.apiKey, 'content-type': 'application/json' },
    69	    body: {
    70	      systemInstruction: { parts: [{ text: GEMINI_TRANSCRIBE_PROMPT }] },
    71	      contents: [{ role: 'user', parts }],
    72	      generationConfig: { thinkingConfig: { thinkingLevel: geminiThinkingLevel(config.model) } },
    73	    },
    74	    deadlineSeconds: Math.max(MIN_DEADLINE_SECONDS, deadlineForAudioBytes(audio.byteLength)),
    75	  };
    76	}
