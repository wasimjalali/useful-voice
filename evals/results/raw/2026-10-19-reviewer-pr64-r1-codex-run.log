    56	export interface ScribeConfig {
    57	  apiKey: string;
    58	  /** The catalog's apiModel. Defaults to `scribe_v2`. */
    59	  model?: string;
    60	  /** Overrides the endpoint; tests. */
    61	  endpoint?: string;
    62	}
    63	
    64	export interface ScribeRequest {
    65	  url: string;
    66	  headers: Record<string, string>;
    67	  form: FormData;
    68	  deadlineSeconds: number;
    69	}
    70	
    71	/** The pin as Scribe wants it (ISO 639-1), or null for auto. */
    72	function languageCodeFor(pin: string): string | null {
    73	  if (pin === 'auto' || pin === 'multi') return null;
    74	  // Regional tags (zh-TW, de-CH) collapse to the base language Scribe knows.
    75	  return pin.split('-')[0] ?? null;
    76	}
    77	
    78	export function buildRequest(audio: Uint8Array, hint: TranscriptionHint, config: ScribeConfig): ScribeRequest {
    79	  const form = new FormData();
    80	  form.append('model_id', config.model ?? 'scribe_v2');
    81	  form.append('file', new Blob([new Uint8Array(audio)], { type: 'audio/wav' }), 'dictation.wav');
    82	  const language = languageCodeFor(hint.language);
    83	  if (language) form.append('language_code', language);
    84	  form.append('tag_audio_events', 'false');
    85	  for (const term of selectKeyterms(hint.keyterms)) form.append('keyterms', term);
    86	  return {
    87	    url: config.endpoint ?? ELEVENLABS_ENDPOINT,
    88	    headers: { 'xi-api-key': config.apiKey },
    89	    form,
    90	    deadlineSeconds: deadlineForAudioBytes(audio.byteLength),
    91	  };
    92	}
    93	
    94	export function parseResponse(payload: unknown): Transcript {
    95	  if (typeof payload !== 'object' || payload === null) {
    96	    throw new ProviderError('malformedResponse', 'ElevenLabs returned an unexpected response.', { provider: PROVIDER });
    97	  }
    98	  const body = payload as { text?: unknown; language_code?: unknown; audio_duration_secs?: unknown };
    99	  const duration = typeof body.audio_duration_secs === 'number' && Number.isFinite(body.audio_duration_secs) ? body.audio_duration_secs : null;
   100	  return {
   101	    text: typeof body.text === 'string' ? body.text.trim() : '',
   102	    durationSeconds: duration,
   103	    detectedLanguage: normaliseDetectedLanguage(body.language_code),
   104	  };
   105	}
   106	
   107	export function classifyHttpError(status: number, body: string, apiKey?: string): ProviderError {
   108	  const detail = describeErrorBody(body, apiKey);
   109	  const suffix = detail.length > 0 ? `: ${detail}` : '';
   110	  const options = { status, provider: PROVIDER };
   111	  if (status === 401 || status === 403) {
   112	    return new ProviderError('unauthorized', `The ElevenLabs API key was rejected${suffix}`, options);
   113	  }
   114	  if (status === 402) {
   115	    return new ProviderError('outOfCredits', `Your ElevenLabs account is out of credits (HTTP 402)${suffix}`, options);
   116	  }
   117	  if (status === 429) return new ProviderError('rateLimited', `ElevenLabs rate limit reached${suffix}`, options);
   118	  if (status >= 500) return new ProviderError('serverError', `ElevenLabs is having trouble (HTTP ${status})${suffix}`, options);
   119	  if (status === 408) return new ProviderError('transport', `ElevenLabs could not read the whole upload (HTTP 408)${suffix}`, options);
   120	  return new ProviderError('badRequest', `Transcription failed (HTTP ${status})${suffix}`, options);
   121	}
   122	
   123	export interface TranscribeOptions {
   124	  audio: Uint8Array;
   125	  hint: TranscriptionHint;
   126	  config: ScribeConfig;
   127	  fetchImpl?: typeof fetch;
   128	  signal?: AbortSignal;
   129	  maxAttempts?: number;
   130	  sleep?: (ms: number) => Promise<void>;
   131	}
   132	
   133	const MAX_ATTEMPTS = 3;
   134	
   135	/** Transcribe a WAV with Scribe. Transient failures retry with backoff, like Deepgram's. */
   136	export async function transcribe(options: TranscribeOptions): Promise<Transcript> {
   137	  const doFetch = options.fetchImpl ?? fetch;
   138	  const sleep = options.sleep ?? ((ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms)));
   139	  const maxAttempts = Math.max(1, options.maxAttempts ?? MAX_ATTEMPTS);
   140	
   141	  let lastError: ProviderError | undefined;
   142	  for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
   143	    if (options.signal?.aborted) throw new ProviderError('cancelled', 'Transcription was cancelled.', { provider: PROVIDER });
   144	    // A fresh form each time: a body that was sent once cannot be sent again.
   145	    const request = buildRequest(options.audio, options.hint, options.config);
   146	    try {
   147	      return await attemptOnce(request, doFetch, options.signal, options.config.apiKey);
   148	    } catch (error) {
   149	      const providerError =
   150	        error instanceof ProviderError
   151	          ? error
   152	          : new ProviderError('transport', error instanceof Error ? error.message : String(error), { provider: PROVIDER });
   153	      lastError = providerError;
   154	      if (!providerError.isTransient || attempt === maxAttempts) throw providerError;
   155	      const delaySeconds = Math.min(providerError.retryAfterSeconds ?? 0.5 * 3 ** (attempt - 1), 8);
   156	      await sleep(delaySeconds * 1000);
   157	    }
   158	  }
   159	  throw lastError ?? new ProviderError('transport', 'Transcription failed.', { provider: PROVIDER });
   160	}
   161	
   162	async function attemptOnce(
   163	  request: ScribeRequest,
   164	  doFetch: typeof fetch,
   165	  signal: AbortSignal | undefined,
   166	  apiKey: string,
   167	): Promise<Transcript> {
   168	  const timeoutSignal = AbortSignal.timeout(request.deadlineSeconds * 1000);
   169	  const combined = signal ? AbortSignal.any([signal, timeoutSignal]) : timeoutSignal;
   170	
   171	  let response: Response;
   172	  try {
   173	    response = await doFetch(request.url, { method: 'POST', headers: request.headers, body: request.form, signal: combined });
   174	  } catch (error) {
   175	    if (signal?.aborted) throw new ProviderError('cancelled', 'Transcription was cancelled.', { provider: PROVIDER });
   176	    if (timeoutSignal.aborted) {
   177	      throw new ProviderError('timedOut', `Transcription timed out after ${request.deadlineSeconds}s.`, { provider: PROVIDER });
   178	    }
   179	    const reason = error instanceof Error ? error.message : String(error);
   180	    throw new ProviderError('transport', `Could not reach ElevenLabs: ${reason.split(apiKey).join('[redacted]')}`, { provider: PROVIDER });
   181	  }
   182	
   183	  if (!response.ok) {
   184	    const body = await response.text().catch(() => '');
   185	    const error = classifyHttpError(response.status, body, apiKey);
   186	    if (error.kind === 'rateLimited') {
   187	      const retryAfter = parseRetryAfter(response.headers.get('retry-after'));
   188	      throw new ProviderError('rateLimited', error.message, {
   189	        status: response.status,
   190	        provider: PROVIDER,
   191	        ...(retryAfter !== undefined ? { retryAfterSeconds: retryAfter } : {}),
   192	      });
   193	    }
   194	    throw error;
   195	  }
   196	
   197	  let payload: unknown;
   198	  try {
   199	    payload = await response.json();
   200	  } catch {
   201	    throw new ProviderError('malformedResponse', 'ElevenLabs returned invalid JSON.', { provider: PROVIDER });
   202	  }
   203	  return parseResponse(payload);
   204	}
