    18	export const GEMINI_ENDPOINT = 'https://generativelanguage.googleapis.com/v1beta/models';
    19	export const ANTHROPIC_ENDPOINT = 'https://api.anthropic.com/v1/messages';
    20	export const ANTHROPIC_VERSION = '2023-06-01';
