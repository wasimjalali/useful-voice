   108	
   109	const MAX_ATTEMPTS = 3;
   110	
   111	export async function transcribe(options: TranscribeOptions): Promise<Transcript> {
   112	  const doFetch = options.fetchImpl ?? fetch;
   113	  const sleep = options.sleep ?? ((ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms)));
   114	  const maxAttempts = Math.max(1, options.maxAttempts ?? MAX_ATTEMPTS);
   115	  const request = buildRequest(options.audio, options.hint, options.config);
   116	  const body = JSON.stringify(request.body);
   117	
   118	  let lastError: ProviderError | undefined;
   119	  for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
   120	    if (options.signal?.aborted) throw new ProviderError('cancelled', 'Transcription was cancelled.', { provider: PROVIDER });
   121	    try {
   122	      return await attemptOnce(request, body, doFetch, options.signal, options.config.apiKey);
   123	    } catch (error) {
   124	      const providerError =
   125	        error instanceof ProviderError
   126	          ? error
   127	          : new ProviderError('transport', error instanceof Error ? error.message : String(error), { provider: PROVIDER });
   128	      lastError = providerError;
   129	      if (!providerError.isTransient || attempt === maxAttempts) throw providerError;
   130	      const delaySeconds = Math.min(providerError.retryAfterSeconds ?? 0.5 * 3 ** (attempt - 1), 8);
   131	      await sleep(delaySeconds * 1000);
   132	    }
   133	  }
   134	  throw lastError ?? new ProviderError('transport', 'Transcription failed.', { provider: PROVIDER });
   135	}
   136	
   137	async function attemptOnce(
   138	  request: GeminiTranscribeRequest,
   139	  body: string,
   140	  doFetch: typeof fetch,
   141	  signal: AbortSignal | undefined,
   142	  apiKey: string,
   143	): Promise<Transcript> {
   144	  const timeoutSignal = AbortSignal.timeout(request.deadlineSeconds * 1000);
   145	  const combined = signal ? AbortSignal.any([signal, timeoutSignal]) : timeoutSignal;
   146	
   147	  let response: Response;
   148	  try {
   149	    response = await doFetch(request.url, { method: 'POST', headers: request.headers, body, signal: combined });
   150	  } catch (error) {
   151	    if (signal?.aborted) throw new ProviderError('cancelled', 'Transcription was cancelled.', { provider: PROVIDER });
   152	    if (timeoutSignal.aborted) {
   153	      throw new ProviderError('timedOut', `Transcription timed out after ${request.deadlineSeconds}s.`, { provider: PROVIDER });
   154	    }
   155	    const reason = error instanceof Error ? error.message : String(error);
   156	    throw new ProviderError('transport', `Could not reach Gemini: ${reason.split(apiKey).join('[redacted]')}`, { provider: PROVIDER });
   157	  }
   158	
   159	  if (!response.ok) {
   160	    const text = await response.text().catch(() => '');
   161	    const error = classifyHttpError(response.status, text, apiKey);
   162	    if (error.kind === 'rateLimited') {
   163	      const retryAfter = parseRetryAfter(response.headers.get('retry-after'));
   164	      throw new ProviderError('rateLimited', error.message, {
   165	        status: response.status,
   166	        provider: PROVIDER,
   167	        ...(retryAfter !== undefined ? { retryAfterSeconds: retryAfter } : {}),
   168	      });
   169	    }
   170	    throw error;
   171	  }
   172	
   173	  let payload: unknown;
   174	  try {
   175	    payload = await response.json();
   176	  } catch {
   177	    throw new ProviderError('malformedResponse', 'Gemini returned invalid JSON.', { provider: PROVIDER });
   178	  }
   179	  return parseResponse(payload);
   180	}

