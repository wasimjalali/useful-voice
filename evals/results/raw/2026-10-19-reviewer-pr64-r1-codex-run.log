    50	/** Read our 16 kHz mono 16-bit PCM WAV into Float32 samples in [-1, 1). */
    51	export function parseWavToFloat32(bytes: Uint8Array): ParsedWav {
    52	  const bad = (m: string) => new ProviderError('badRequest', `Can't read the recording: ${m}`);
    53	  if (bytes.length < 12) throw bad('the audio is too short to be a WAV file.');
    54	  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
    55	  const tag = (o: number) => String.fromCharCode(bytes[o]!, bytes[o + 1]!, bytes[o + 2]!, bytes[o + 3]!);
    56	  if (tag(0) !== 'RIFF' || tag(8) !== 'WAVE') throw bad('it is not a WAV file.');
    57	
    58	  let format: { code: number; channels: number; rate: number; bits: number } | null = null;
    59	  let offset = 12;
    60	  while (offset + 8 <= bytes.length) {
    61	    const id = tag(offset);
    62	    const declared = view.getUint32(offset + 4, true);
    63	    const body = offset + 8;
    64	    if (id === 'fmt ') {
    65	      if (body + 16 > bytes.length) throw bad('the format header is cut off.');
    66	      format = {
    67	        code: view.getUint16(body, true),
    68	        channels: view.getUint16(body + 2, true),
    69	        rate: view.getUint32(body + 4, true),
    70	        bits: view.getUint16(body + 14, true),
    71	      };
    72	    } else if (id === 'data') {
    73	      if (!format) throw bad('the data comes before the format header.');
    74	      if (format.code !== 1 || format.bits !== 16) throw bad('only 16-bit PCM audio is supported.');
    75	      if (format.channels !== 1) throw bad('only mono audio is supported.');
    76	      if (format.rate !== 16000) throw bad('only 16 kHz audio is supported.');
    77	      // A streamed file can declare 0 or too large a size; trust the bytes that are there.
    78	      const available = bytes.length - body;
    79	      const length = Math.min(declared === 0 ? available : declared, available) & ~1;
    80	      const count = length / 2;
    81	      const samples = new Float32Array(count);
    82	      for (let i = 0; i < count; i += 1) samples[i] = view.getInt16(body + i * 2, true) / 32768;
    83	      return { samples, sampleRate: format.rate, durationSeconds: count / format.rate };
    84	    }
    85	    offset = body + declared + (declared % 2);
    86	  }
    87	  throw bad('it has no audio data.');
    88	}
