   312	test('a local model downloads when picked (no network) and becomes the voice model when it is ready', async () => {
   313	  const { win, userData } = await start('models-local');
   314	  await setKey(win, 'deepgram', 'valid-deepgram');
   315	  await win.reload();
   316	  await win.waitForSelector('.dock');
   317	  await openSettings(win);
   318	
   319	  // Nothing is on this PC yet: the row offers the download.
   320	  const parakeet = voiceList(win).getByRole('radio', { name: /^Parakeet,/ });
   321	  await expect(voiceList(win).getByRole('button', { name: 'Download Parakeet', exact: true })).toBeVisible();
   322	  await parakeet.click();
   323	
   324	  // Under --e2e the download is answered by a stub inside the app: the real lifecycle runs
   325	  // (downloading, unpacking, ready) and the choice follows it.
   326	  await expect(parakeet).toHaveAttribute('aria-checked', 'true', { timeout: 20 * SECOND });
   327	  await expect(voiceList(win).getByRole('button', { name: 'Delete Parakeet' })).toBeVisible();
   328	  expect((await currentSettings(win)).voiceModelId).toBe('parakeet:v2');
   329	  const states = await win.evaluate(() => (window as unknown as { usefulVoice: { parakeetStates(): Promise<Record<string, { status: string; sizeBytes?: number }>> } }).usefulVoice.parakeetStates());
   330	  // Four one-byte files from the stub: the real 480 MB archive was never fetched.
   331	  expect(states.v2).toMatchObject({ status: 'ready', sizeBytes: 4 });
   332	  const requests = await fs.readFile(path.join(userData, 'e2e.log'), 'utf8');
   333	  expect(requests).toMatch(/parakeet GET https:\/\/github\.com\//);
   334	  // Every request the app made for the model went to the in-app stub, and no other host was asked.
   335	  expect(requests.split('\n').filter((line) => / parakeet GET /.test(line)).length).toBe(1);
   336	
   337	  // A failed download offers a retry, and does not switch anything.
   338	  const multilingual = voiceList(win).getByRole('radio', { name: /^Parakeet Multilingual,/ });
   339	  await sendToMain(run!.app, 'parakeet:changed', { v2: states.v2, v3: { status: 'failed', message: 'offline' } });
   340	  await expect(voiceList(win).getByRole('button', { name: 'Retry Parakeet Multilingual' })).toBeVisible();
   341	  await expect(multilingual).toHaveAttribute('aria-checked', 'false');
   342	  expect((await currentSettings(win)).voiceModelId).toBe('parakeet:v2');
   343	});
