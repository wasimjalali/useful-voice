   217	  }
   218	
   219	  /**
   220	   * Start the worker and load the model in the background when it is downloaded and not loaded.
   221	   * A no-op otherwise. Never throws; failures are logged.
   222	   */
   223	  preload(version: ParakeetVersion): void {
   224	    if (this.disposed || this.preloading || this.current[version].status !== 'ready') return;
   225	    if (this.worker && this.workerVersion === version) return;
   226	    const task = this.exchange(version, new Float32Array(0), 16000, 0, undefined, true)
   227	      .then((r) => {
   228	        if (!r.ok) console.warn(`Parakeet ${version} preload failed: ${r.error}`);
   229	      })
   230	      .catch((e: unknown) => console.warn(`Parakeet ${version} preload failed: ${errorMessage(e)}`))
   231	      .finally(() => {
   232	        if (this.preloading === task) this.preloading = null;
   233	      });
   234	    this.preloading = task;
   235	  }
   236	
   237	  /** The pinned version's worker is never stopped by the idle timer. Null unpins. */
   238	  setPinned(version: ParakeetVersion | null): void {
   239	    this.pinned = version;
   240	    this.armIdle();
   241	  }
   242	
   243	  private async exchange(
   244	    version: ParakeetVersion,
   245	    samples: Float32Array,
   246	    sampleRate: number,
   247	    seconds: number,
   248	    signal: AbortSignal | undefined,
   249	    loadOnly: boolean,
   250	  ): Promise<ParakeetWorkerResponse> {
   251	    const worker = await this.ensureWorker();
   252	    if (signal?.aborted) throw new ProviderError('cancelled', 'Transcription was cancelled.', PARAKEET_PROVIDER);
   253	    this.clearIdle();
   254	
   255	    const id = this.nextId++;
   256	    this.inflight.set(id, version);
   257	    return new Promise<ParakeetWorkerResponse>((resolve, reject) => {
   258	      let timer: ReturnType<typeof setTimeout> | undefined;
   259	      const finish = () => {
   260	        if (timer) clearTimeout(timer);
   261	        signal?.removeEventListener('abort', onAbort);
   262	        this.pending.delete(id);
   263	        this.inflight.delete(id);
   264	      };
   265	      // The result of a cancelled request is dropped, the process keeps its loaded model.
   266	      const onAbort = () => {
   267	        finish();
   268	        reject(new ProviderError('cancelled', 'Transcription was cancelled.', PARAKEET_PROVIDER));
   269	      };
   270	      this.pending.set(id, (r) => {
   271	        finish();
   272	        if (r instanceof Error) reject(r);
   273	        else {
   274	          if (r.ok && this.worker === worker) this.workerVersion = version;
   275	          resolve(r);
   276	        }
   277	      });
   278	      signal?.addEventListener('abort', onAbort, { once: true });
   279	      timer = setTimeout(() => {
   280	        finish();
   281	        // A stuck recognition can't be interrupted, so the process goes and the next request restarts it.
   282	        this.stopWorker();
   283	        reject(new ProviderError('timedOut', 'Parakeet took too long. Try again.', PARAKEET_PROVIDER));
   284	      }, this.timeoutFor(seconds));
   285	      try {
   286	        worker.postMessage({ id, modelDir: this.modelDir(version), samples, sampleRate, loadOnly });
   287	      } catch (e) {
   288	        finish();
   289	        reject(new ProviderError('transport', `Parakeet couldn't start: ${errorMessage(e)}`, PARAKEET_PROVIDER));
   290	      }
   291	    }).finally(() => this.armIdle());
   292	  }
   293	
   294	  /** Stop any worker process and downloads. Called at quit. */
   295	  dispose(): void {
   296	    this.disposed = true;
   297	    for (const { controller } of this.active.values()) controller.abort();
   298	    this.stopWorker();
   299	    this.listeners.clear();
   300	  }
   301	
   302	  // MARK: worker
   303	
   304	  private async ensureWorker(): Promise<ParakeetWorkerHandle> {
   305	    if (this.disposed) throw new ProviderError('cancelled', 'Parakeet is shutting down.', PARAKEET_PROVIDER);
   306	    if (this.worker) return this.worker;
   307	    this.starting ??= this.spawnWorker()
   308	      .then((w) => {
   309	        w.onMessage((m) => this.pending.get(m.id)?.(m));
   310	        w.onExit((reason) => {
   311	          if (this.worker !== w) return;
   312	          this.worker = null;
   313	          this.workerVersion = null;
   314	          this.clearIdle();
   315	          this.failPending(reason);
   316	        });
   317	        if (this.disposed) {
   318	          w.kill();
   319	          throw new ProviderError('cancelled', 'Parakeet is shutting down.', PARAKEET_PROVIDER);
   320	        }
   321	        this.worker = w;
   322	        return w;
   323	      })
   324	      .catch((e: unknown) => {
   325	        throw e instanceof ProviderError
   326	          ? e
   327	          : new ProviderError('transport', `Couldn't start the Parakeet engine: ${errorMessage(e)}`, PARAKEET_PROVIDER);
   328	      })
   329	      .finally(() => {
   330	        this.starting = null;
   331	      });
