    97	/**
    98	 * Parakeet's download under `--e2e`: no request leaves the machine. The "server" answers a tiny
    99	 * archive, the "extraction" writes four one-byte files, and each URL asked for lands in e2e.log.
   100	 */
   101	export function parakeetE2eDeps(userData: string): {
   102	  fetch: typeof fetch;
   103	  extract: (archive: string, destDir: string) => Promise<void>;
   104	  spawnWorker: () => Promise<never>;
   105	} {
   106	  return {
   107	    fetch: (async (input: RequestInfo | URL) => {
   108	      const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
   109	      try {
   110	        appendFileSync(path.join(userData, 'e2e.log'), `${new Date().toISOString()} parakeet GET ${url}\n`);
   111	      } catch {
   112	        // The log is a diagnostic aid only.
   113	      }
   114	      return new Response(new Uint8Array(64), { status: 200, headers: { 'content-length': '64' } });
   115	    }) as typeof fetch,
   116	    extract: async (_archive, destDir) => {
   117	      for (const name of ['encoder.int8.onnx', 'decoder.int8.onnx', 'joiner.int8.onnx', 'tokens.txt']) {
   118	        writeFileSync(path.join(destDir, name), 'x');
   119	      }
   120	    },
   121	    // The one-byte "model" can't be loaded: no recognition process under --e2e.
   122	    spawnWorker: async () => {
   123	      throw new Error('no recognition worker under --e2e');
   124	    },
   125	  };
   126	}
   127	
   128	export function installProviderStubs(userData: string): void {
   129	  const real = globalThis.fetch.bind(globalThis);
   130	  const log = (host: StubHost, line: string): void => {
   131	    try {
   132	      appendFileSync(path.join(userData, 'e2e.log'), `${new Date().toISOString()} ${host} ${line}\n`);
   133	    } catch {
   134	      // The log is a diagnostic aid only.
   135	    }
   136	  };
   137	  globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {
   138	    const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
   139	    const host = HOSTS.find(([prefix]) => url.startsWith(prefix))?.[1];
   140	    if (!host) return real(input, init);
   141	    const key = keyOf(host, new Headers(init?.headers));
   142	    log(host, `${(init?.method ?? 'GET').toUpperCase()} ${url}`);
   143	    if (key.startsWith('offline')) throw new TypeError('fetch failed');
   144	    if (key.startsWith('slow')) await new Promise((resolve) => setTimeout(resolve, 1500));
   145	    if (!key.startsWith('valid') && !key.startsWith('slow')) return refused(host);
   146	    return answer(host, init);
   147	  }) as typeof fetch;
   148	}
