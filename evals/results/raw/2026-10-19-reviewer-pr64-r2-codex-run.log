   274	 *    key puts the field in the danger edge and shows the message.
   275	 */
   276	function keyRow(provider: KeyProvider, host: ModelsHost): HTMLElement {
   277	  const name = KEY_PROVIDER_INFO[provider].name;
   278	  const keyUrl = KEY_PROVIDER_INFO[provider].keyUrl;
   279	  const container = el('div', { class: 's-row s-row-key', dataset: { provider } });
   280	  let editing = false;
   281	  let status: { kind: 'ok' | 'bad' | 'busy'; text: string } | null = null;
   282	
   283	  const pill = (): HTMLElement | null =>
   284	    status
   285	      ? el(
   286	          'span',
   287	          { class: `status-pill ${status.kind === 'ok' ? 'ok' : status.kind === 'bad' ? 'bad' : ''}`, role: 'status' } as never,
   288	          el('span', { class: 'status-dot' }),
   289	          status.text,
   290	        )
   291	      : null;
   292	
   293	  const getKey = (variant: 'btn-ghost' | 'btn-secondary'): HTMLElement =>
   294	    el('button', { class: `btn ${variant}`, type: 'button', 'aria-label': `Get a ${name} key`, onclick: () => void api.openExternal(keyUrl) } as never, 'Get a key');
   295	
   296	  const draw = (): void => {
   297	    const hasKey = keys()[provider];
   298	    const label = el('div', { class: 's-label' }, el('span', {}, `${name} key`));
   299	    const control = el('div', { class: 's-control s-key-control' });
   300	
   301	    if (!hasKey && !editing) {
   302	      control.append(
   303	        el('span', { class: 'muted' }, 'No key added'),
   304	        el('button', { class: 'btn btn-primary', type: 'button', 'aria-label': `Add ${name} key`, onclick: () => { editing = true; draw(); } } as never, 'Add key'),
   305	        getKey('btn-secondary'),
   306	      );
   307	    } else if (editing) {
   308	      label.append(el('span', { class: 's-hint' }, 'Stored encrypted with your Windows account.'));
   309	      const input = el('input', {
   310	        class: `field-input ${status?.kind === 'bad' ? 'err' : ''}`,
   311	        type: 'password',
   312	        placeholder: hasKey ? 'Paste a new key' : 'Paste your key',
   313	        'aria-label': `${name} API key`,
   314	        autocomplete: 'off',
   315	      } as never);
   316	      const submit = (): void => void saveKey(input.value);
   317	      input.addEventListener('keydown', (event) => {
   318	        if (event.key === 'Enter') submit();
   319	      });
   320	      control.append(
   321	        input,
   322	        el(
   323	          'div',
   324	          { class: 's-buttons' },
   325	          el('button', { class: 'btn btn-primary', type: 'button', onclick: submit } as never, 'Save key'),
   326	          hasKey ? el('button', { class: 'btn btn-secondary', type: 'button', onclick: () => { editing = false; status = null; draw(); } } as never, 'Cancel') : null,
   327	          getKey('btn-ghost'),
   328	        ),
   329	        ...(status ? [pill() as HTMLElement] : []),
   330	      );
   331	      queueMicrotask(() => input.focus());
   332	    } else {
   333	      control.append(
   334	        ...(status ? [pill() as HTMLElement] : []),
   335	        el('button', { class: 'btn btn-secondary', type: 'button', 'aria-label': `Test ${name} connection`, onclick: () => void testKey() } as never, 'Test connection'),
   336	        el('button', { class: 'btn btn-secondary', type: 'button', 'aria-label': `Change ${name} key`, onclick: () => { editing = true; status = null; draw(); } } as never, 'Change key'),
   337	        el('button', { class: 'btn btn-ghost', type: 'button', 'aria-label': `Remove ${name} key`, onclick: () => void removeKey() } as never, 'Remove key'),
   338	      );
   339	    }
   340	    container.replaceChildren(label, control);
   341	  };
   342	
   343	  /** The key changed: the model lists, the banner and the status button read the presence. */
   344	  const keysChanged = async (saved: boolean): Promise<boolean> => {
   345	    let reloaded = true;
   346	    try {
   347	      state.settings = await api.getSettings();
   348	    } catch (error) {
   349	      reloaded = false;
   350	      if (state.settings) state.settings = { ...state.settings, keys: { ...keys(), [provider]: saved } };
   351	      host.toast(`${saved ? 'Key saved' : 'Key removed'}, but the settings could not be reloaded. ${host.messageOf(error, '')}`.trim(), 'bad');
   352	    }
   353	    editing = false;
   354	    status = null;
   355	    draw();
   356	    redrawModels?.();
   357	    renderChrome();
   358	    return reloaded;
   359	  };
   360	
   361	  const saveKey = async (raw: string): Promise<void> => {
   362	    const value = raw.trim();
   363	    if (value.length === 0) {
   364	      status = { kind: 'bad', text: 'Paste a key first.' };
   365	      draw();
   366	      return;
   367	    }
   368	    try {
   369	      const result = await api.setProviderKey(provider, value);
   370	      if (!result.ok) {
   371	        status = { kind: 'bad', text: result.error ?? 'The key could not be saved.' };
   372	        draw();
   373	        return;
   374	      }
   375	    } catch (error) {
   376	      status = { kind: 'bad', text: host.messageOf(error, 'The key could not be saved.') };
   377	      draw();
   378	      return;
   379	    }
   380	    if (await keysChanged(true)) host.toast('Saved');
   381	  };
   382	
   383	  const testKey = async (): Promise<void> => {
   384	    status = { kind: 'busy', text: 'Checking…' };
   385	    draw();
   386	    try {
   387	      const result = await api.testProviderKey(provider);
   388	      if (result.ok) {
   389	        status = { kind: 'ok', text: result.message };
   390	      } else {
   391	        // A rejected key is replaced, not retried: open the field with the danger edge.
   392	        status = { kind: 'bad', text: result.message };
   393	        editing = true;
   394	      }
   395	    } catch (error) {
   396	      status = { kind: 'bad', text: host.messageOf(error, 'The key could not be checked.') };
   397	    }
   398	    draw();
   399	  };
   400	
   401	  const removeKey = async (): Promise<void> => {
   402	    try {
   403	      await api.clearProviderKey(provider);
   404	    } catch (error) {
   405	      host.toast(host.messageOf(error, 'The key could not be removed.'), 'bad');
   406	      return;
   407	    }
   408	    if (await keysChanged(false)) host.toast('Key removed');
   409	  };
   410	
   411	  keyRows.set(provider, {
   412	    edit: () => {
   413	      editing = true;
   414	      status = null;
   415	      draw();
   416	      container.scrollIntoView({ block: 'center', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
   417	    },
   418	  });
   419	  draw();
   420	  return container;
   421	}
     1	import { app, safeStorage } from 'electron';
     2	import path from 'node:path';
     3	import { DEFAULT_SETTINGS, type AppSettings } from '../core/models.js';
     4	import { normaliseSettings } from '../core/settings/settingsBounds.js';
     5	import { readJson, writeJsonAtomic } from '../core/settings/jsonStore.js';
     6	import { KEY_PROVIDER_INFO, type KeyProvider } from '../core/models/catalog.js';
     7	
     8	/**
     9	 * Where the API key is stored.
    10	 *
    11	 * On macOS the key lives in the Keychain. The Windows equivalent is DPAPI, which
    12	 * Electron exposes as `safeStorage`, so the key is encrypted with the *user's*
    13	 * credentials and is unreadable from another account or from a copy of the file
    14	 * moved to another machine. It is never written in plaintext, never logged, and
    15	 * never sent to the renderer.
    16	 */
    17	
    18	interface SettingsFile {
    19	  version: number;
    20	  settings: AppSettings;
    21	  /** Base64 of the DPAPI-encrypted API key. Absent when no key is configured. */
    22	  apiKeyEncrypted?: string;
    23	  /**
    24	   * Set only when the key had to be stored without OS encryption (no DPAPI
    25	   * available). The UI warns the user, because a plaintext key on disk is a real
    26	   * (if limited) exposure.
    27	   */
    28	  apiKeyPlaintextWarning?: boolean;
    29	  /** Set once the first-run setup has been finished or skipped, or was never needed. */
    30	  firstRunCompleted?: boolean;
    31	  /** The other providers' keys, encrypted the same way as the Deepgram key. */
    32	  providerKeys?: Partial<Record<ExtraKeyProvider, StoredKey>>;
    33	}
    34	
    35	/** The providers whose keys live in `providerKeys` (Deepgram's stays in `apiKeyEncrypted`). */
    36	export type ExtraKeyProvider = Exclude<KeyProvider, 'deepgram'>;
    37	const EXTRA_KEY_PROVIDERS: readonly ExtraKeyProvider[] = ['elevenlabs', 'gemini', 'anthropic'];
    38	
    39	interface StoredKey {
    40	  /** Base64 of the DPAPI-encrypted key (or of the text when `plaintext`). */
    41	  data: string;
    42	  plaintext?: boolean;
    43	}
    44	
    45	/** One extra key in memory: the key when it could be read, the blob when it could not. */
    46	interface ExtraKey {
    47	  key: string | null;
    48	  /** The stored blob as read, kept when it could not be decrypted so a save writes it back untouched. */
    49	  undecrypted: StoredKey | null;
    50	  onDisk: boolean;
    51	}
    52	
    53	const CURRENT_SETTINGS_VERSION = 1;
    54	
    55	export interface SaveStatus {
    56	  ok: boolean;
    57	  message?: string;
    58	}
    59	
    60	export class SettingsStore {
    61	  private settings: AppSettings = { ...DEFAULT_SETTINGS };
    62	  private apiKey: string | null = null;
    63	  private plaintextKeyWarning = false;
    64	  private loaded = false;
    65	  private lastSaveError: Error | null = null;
    66	  private completedFirstRun = false;
    67	  private keyOnDisk = false;
    68	  /** The stored key blob as read, kept when it could not be decrypted so a save writes it back untouched. */
    69	  private undecryptedBlob: string | null = null;
    70	  private frozen = false;
    71	  private readonly extraKeys = new Map<ExtraKeyProvider, ExtraKey>();
    72	  private readonly statusListeners = new Set<(status: SaveStatus) => void>();
    73	
    74	  private readonly filePath: string;
    75	
    76	  constructor(userDataDirectory: string) {
    77	    this.filePath = path.join(userDataDirectory, 'settings.json');
    78	  }
    79	
    80	  get path(): string {
    81	    return this.filePath;
    82	  }
    83	
    84	  async load(): Promise<void> {
    85	    const result = await readJson<SettingsFile>(this.filePath);
    86	    if (result.value && typeof result.value === 'object') {
    87	      const incoming = result.value;
    88	      // Merge over the defaults so a file written by an older build still
    89	      // produces a complete settings object rather than undefined fields.
    90	      this.settings = { ...DEFAULT_SETTINGS, ...(incoming.settings ?? {}) };
    91	      this.settings.hotkey = { ...DEFAULT_SETTINGS.hotkey, ...(incoming.settings?.hotkey ?? {}) };
    92	      // Correct out-of-range values on load as well as on update, so a file
    93	      // written by an older build (which offered a 900 s recording) is fixed at
    94	      // launch rather than honoured until the user next opens Settings.
    95	      this.settings = normaliseSettings(this.settings);
    96	      this.plaintextKeyWarning = incoming.apiKeyPlaintextWarning === true;
    97	      this.completedFirstRun = incoming.firstRunCompleted === true;
    98	      this.keyOnDisk = typeof incoming.apiKeyEncrypted === 'string' && incoming.apiKeyEncrypted.length > 0;
    99	      if (typeof incoming.apiKeyEncrypted === 'string' && incoming.apiKeyEncrypted.length > 0) {
   100	        this.apiKey = this.decrypt(incoming.apiKeyEncrypted, incoming.apiKeyPlaintextWarning === true);
   101	        if (this.apiKey === null) {
   102	          this.undecryptedBlob = incoming.apiKeyEncrypted;
   103	          // Decryption failed: the file was copied from another user or machine,
   104	          // or the OS profile changed. Report it rather than silently behaving as
   105	          // if no key were configured (which is what the macOS build did with a
   106	          // locked keychain: it told the user they were never set up).
   107	          this.lastSaveError = new Error(
   108	            'The stored API key could not be decrypted on this account. Re-enter your Deepgram key in Settings.',
   109	          );
   110	        }
   111	      }
   112	    }
   113	    if (result.value && typeof result.value === 'object') {
   114	      this.loadExtraKeys(result.value.providerKeys);
   115	    }
   116	    this.loaded = true;
   117	  }
   118	
   119	  private loadExtraKeys(stored: SettingsFile['providerKeys']): void {
   120	    for (const provider of EXTRA_KEY_PROVIDERS) {
   121	      const entry = stored?.[provider];
   122	      if (!entry || typeof entry.data !== 'string' || entry.data.length === 0) continue;
   123	      const key = this.decrypt(entry.data, entry.plaintext === true);
   124	      this.extraKeys.set(provider, { key, undecrypted: key === null ? entry : null, onDisk: true });
   125	      if (key === null) {
   126	        this.lastSaveError = new Error(
   127	          `The stored ${KEY_PROVIDER_INFO[provider].name} key could not be decrypted on this account. Re-enter it in Settings.`,
   128	        );
   129	      }
   130	    }
   131	  }
   132	
   133	  get isLoaded(): boolean {
   134	    return this.loaded;
   135	  }
   136	
   137	  get all(): AppSettings {
   138	    return this.settings;
   139	  }
   140	
   141	  get saveError(): Error | null {
   142	    return this.lastSaveError;
   143	  }
   144	
   145	  /** The first-run setup was finished or skipped. */
   146	  get firstRunCompleted(): boolean {
   147	    return this.completedFirstRun;
   148	  }
   149	
   150	  /**
   151	   * A key was stored, whether or not it can be read now. Presence only, so a key that
   152	   * fails to decrypt still counts as configured for the first-run gate.
   153	   */
