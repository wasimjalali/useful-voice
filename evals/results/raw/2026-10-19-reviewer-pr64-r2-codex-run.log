   251	        host.toast('The download failed. Try again.', 'bad');
   252	      } else if (info.status === 'notDownloaded') pendingVoiceModel = null;
   253	    }
   254	    if (container.isConnected) redraw();
   255	  });
   256	  return container;
   257	}
