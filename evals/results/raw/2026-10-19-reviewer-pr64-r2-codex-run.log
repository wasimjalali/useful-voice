   197	        next?.focus();
   198	      }
   199	    });
   200	    return row;
   201	  };
   202	
   203	  const list = (kind: 'voice' | 'language', title: string, models: readonly CatalogModel[], selectedId: string | null, withOff: boolean): HTMLElement => {
   204	    // One header row for both lists: the first list carries it, and the columns line up below.
   205	    const header =
   206	      kind === 'voice'
   207	        ? el('div', { class: 'm-columns', 'aria-hidden': 'true' }, el('span', {}), el('span', {}, 'Speed'), el('span', {}, 'Accuracy'), el('span', {}))
   208	        : null;
   209	    const titleId = `models-${kind}-title`;
   210	    const group = el('div', { class: 'm-list', role: 'radiogroup', 'aria-labelledby': titleId } as never);
   211	    const entries: Array<CatalogModel | null> = withOff ? [null, ...models] : [...models];
   212	    const known = entries.some((entry) => (entry?.id ?? null) === selectedId);
   213	    entries.forEach((entry, index) => {
   214	      const isSelected = (entry?.id ?? null) === selectedId;
   215	      group.append(modelRow(kind, entry, selectedId, known ? isSelected : index === 0));
   216	    });
   217	    return el('div', {}, el('h3', { class: 'm-title', id: titleId }, title), el('div', { class: 's-surface' }, header, group));
   218	  };
   219	
   220	  const redraw = (): void => {
   221	    const settings = state.settings;
   222	    if (!settings) return;
   223	    const focused = document.activeElement?.closest('.m-row');
   224	    const index = focused ? [...container.querySelectorAll('.m-row')].indexOf(focused) : -1;
   225	    container.replaceChildren(
   226	      list('voice', 'Voice model', VOICE_MODELS, settings.voiceModelId, false),
   227	      list('language', 'AI formatting', LANGUAGE_MODELS, settings.formatterId, true),
   228	    );
   229	    // A repaint must not cost a keyboard user their place.
   230	    if (index >= 0) container.querySelectorAll<HTMLElement>('.m-row .m-pick')[index]?.focus();
   231	  };
   232	  redrawModels = redraw;
   233	  redraw();
   234	
   235	  api.parakeetStates().then(
   236	    (states) => {
   237	      parakeetStates = states;
   238	      redraw();
   239	    },
   240	    () => undefined,
   241	  );
   242	  detachParakeet = api.onParakeetChanged((states) => {
   243	    parakeetStates = states;
   244	    const pending = pendingVoiceModel;
   245	    const version = pending ? parakeetVersionFromCatalogId(pending) : null;
   246	    if (pending && version) {
   247	      const info = states[version];
