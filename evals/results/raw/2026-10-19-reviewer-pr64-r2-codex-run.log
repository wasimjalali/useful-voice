    49	export function normaliseDetectedLanguage(code: unknown): string | null {
    50	  if (typeof code !== 'string') return null;
    51	  const lower = code.trim().toLowerCase().replace(/[^a-z-]/g, '');
    52	  if (lower.length === 0) return null;
    53	  return ISO3_TO_ISO1[lower] ?? lower;
