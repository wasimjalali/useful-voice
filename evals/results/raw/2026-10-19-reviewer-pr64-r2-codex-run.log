   361	  }
   362	
   363	  // MARK: paths and state
   364	
   365	  private modelsRoot(): string {
   366	    return path.join(this.dataDir, 'models');
   367	  }
   368	
   369	  private modelDir(version: ParakeetVersion): string {
   370	    return path.join(this.modelsRoot(), `parakeet-${version}`);
   371	  }
   372	
   373	  private partialPath(version: ParakeetVersion): string {
   374	    return path.join(this.modelsRoot(), `parakeet-${version}.partial`);
   375	  }
   376	
   377	  private set(version: ParakeetVersion, state: ParakeetState): void {
   378	    this.current = { ...this.current, [version]: state };
