    52	/** Read our 16 kHz mono 16-bit PCM WAV into Float32 samples in [-1, 1). */
    53	export function parseWavToFloat32(bytes: Uint8Array): ParsedWav {
    54	  const bad = (m: string) => new ProviderError('badRequest', `Can't read the recording: ${m}`, { provider: 'Parakeet' });
