    78	/** The transcript. A blocked prompt or silence is an empty one, which the caller reports as "no speech". */
    79	export function parseResponse(payload: unknown): Transcript {
    80	  if (typeof payload !== 'object' || payload === null) {
    81	    throw new ProviderError('malformedResponse', 'Gemini returned an unexpected response.', { provider: PROVIDER });
    82	  }
    83	  const text = parseGeminiResponse(payload).trim();
    84	  const outcome = geminiOutcome(payload);
    85	  // Only a finished answer (STOP) with no text is silence. A blocked prompt or a cut-off answer is
    86	  // a failure, so the audio is kept and Retry works.
    87	  if (text.length === 0 && (outcome.blocked || (outcome.finishReason !== null && outcome.finishReason !== 'STOP'))) {
    88	    throw new ProviderError('malformedResponse', "Gemini didn't return a transcript. Try again.", { provider: PROVIDER });
    89	  }
    90	  return { text, durationSeconds: null, detectedLanguage: null };
    91	}
