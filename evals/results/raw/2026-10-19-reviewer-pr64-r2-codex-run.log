   106	export interface TranscribeOptions {
   107	  audio: Uint8Array;
   108	  hint: TranscriptionHint;
   109	  config: GeminiTranscribeConfig;
   110	  fetchImpl?: typeof fetch;
   111	  signal?: AbortSignal;
   112	  maxAttempts?: number;
   113	  sleep?: (ms: number) => Promise<void>;
   114	}
   115	
   116	const MAX_ATTEMPTS = 3;
   117	
   118	export async function transcribe(options: TranscribeOptions): Promise<Transcript> {
   119	  const doFetch = options.fetchImpl ?? fetch;
   120	  const sleep = options.sleep ?? ((ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms)));
   121	  const maxAttempts = Math.max(1, options.maxAttempts ?? MAX_ATTEMPTS);
   122	  const request = buildRequest(options.audio, options.hint, options.config);
   123	  const body = JSON.stringify(request.body);
   124	
   125	  let lastError: ProviderError | undefined;
   126	  for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
   127	    if (options.signal?.aborted) throw new ProviderError('cancelled', 'Transcription was cancelled.', { provider: PROVIDER });
   128	    try {
   129	      return await attemptOnce(request, body, doFetch, options.signal, options.config.apiKey);
   130	    } catch (error) {
   131	      const providerError =
   132	        error instanceof ProviderError
   133	          ? error
   134	          : new ProviderError('transport', error instanceof Error ? error.message : String(error), { provider: PROVIDER });
   135	      lastError = providerError;
   136	      if (!providerError.isTransient || attempt === maxAttempts) throw providerError;
   137	      const delaySeconds = Math.min(providerError.retryAfterSeconds ?? 0.5 * 3 ** (attempt - 1), 8);
   138	      await sleep(delaySeconds * 1000);
   139	    }
   140	  }
   141	  throw lastError ?? new ProviderError('transport', 'Transcription failed.', { provider: PROVIDER });
   142	}
   143	
   144	async function attemptOnce(
   145	  request: GeminiTranscribeRequest,
   146	  body: string,
   147	  doFetch: typeof fetch,
   148	  signal: AbortSignal | undefined,
   149	  apiKey: string,
   150	): Promise<Transcript> {
   151	  const timeoutSignal = AbortSignal.timeout(request.deadlineSeconds * 1000);
   152	  const combined = signal ? AbortSignal.any([signal, timeoutSignal]) : timeoutSignal;
   153	
   154	  let response: Response;
   155	  try {
   156	    response = await doFetch(request.url, { method: 'POST', headers: request.headers, body, signal: combined });
   157	  } catch (error) {
   158	    if (signal?.aborted) throw new ProviderError('cancelled', 'Transcription was cancelled.', { provider: PROVIDER });
   159	    if (timeoutSignal.aborted) {
   160	      throw new ProviderError('timedOut', `Transcription timed out after ${request.deadlineSeconds}s.`, { provider: PROVIDER });
   161	    }
   162	    const reason = error instanceof Error ? error.message : String(error);
   163	    throw new ProviderError('transport', `Could not reach Gemini: ${reason.split(apiKey).join('[redacted]')}`, { provider: PROVIDER });
   164	  }
   165	
   166	  if (!response.ok) {
   167	    const text = await response.text().catch(() => '');
   168	    const error = classifyHttpError(response.status, text, apiKey);
   169	    if (error.kind === 'rateLimited') {
   170	      const retryAfter = parseRetryAfter(response.headers.get('retry-after'));
   171	      throw new ProviderError('rateLimited', error.message, {
   172	        status: response.status,
   173	        provider: PROVIDER,
   174	        ...(retryAfter !== undefined ? { retryAfterSeconds: retryAfter } : {}),
   175	      });
   176	    }
   177	    throw error;
   178	  }
   179	
   180	  let payload: unknown;
   181	  try {
   182	    payload = await response.json();
   183	  } catch {
   184	    throw new ProviderError('malformedResponse', 'Gemini returned invalid JSON.', { provider: PROVIDER });
   185	  }
   186	  return parseResponse(payload);
   187	}
