    83	/** Settings "Run setup again": always starts at Welcome and saves normally. */
    84	let opening = false;
    85	
    86	export async function runSetupAgain(): Promise<void> {
    87	  // Two quick presses must not mount two overlays: the state read is async.
    88	  if (flow || opening) return;
    89	  opening = true;
    90	  try {
    91	    const state = await api.firstRunState();
    92	    if (!flow) open({ ...state, step: null }, true);
    93	  } finally {
    94	    opening = false;
    95	  }
    96	}
