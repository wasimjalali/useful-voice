    25	export function currentVoiceModel(voiceModelId: string): CatalogModel {
    26	  return voiceModelById(voiceModelId) ?? (voiceModelById(DEFAULT_VOICE_MODEL_ID) as CatalogModel);
    27	}
    28	
    29	export function missingKeyMessage(model: CatalogModel): string {
    30	  const provider = keyProviderOf(model);
    31	  return provider ? `Add your ${KEY_PROVIDER_INFO[provider].name} key in Settings.` : 'Download the voice model in Settings.';
    32	}
    33	
    34	/** The key to check before a dictation, or 'local' for a model that needs none. Null means missing. */
    35	export function voiceCredential(model: CatalogModel, key: (provider: KeyProvider) => string | null): string | null {
    36	  const provider = keyProviderOf(model);
    37	  return provider ? key(provider) : 'local';
    38	}
    39	
    40	export function createTranscriber(deps: RouterDeps): TranscriberPort {
    41	  return {
    42	    async transcribe(request, signal) {
    43	      const model = currentVoiceModel(deps.voiceModelId());
    44	      const provider = keyProviderOf(model);
    45	      const apiKey = provider ? deps.key(provider) : null;
    46	      if (provider && !apiKey) {
    47	        throw new ProviderError('notConfigured', missingKeyMessage(model), { provider: KEY_PROVIDER_INFO[provider].name });
    48	      }
    49	      const common = { fetchImpl: deps.fetchImpl, sleep: deps.sleep, signal, maxAttempts: 3 };
    50	      const hint = { language: request.language, keyterms: request.keyterms };
    51	
    52	      if (model.provider === 'deepgram') {
    53	        return transcribeDeepgram({
    54	          audio: request.audio,
    55	          hint,
    56	          config: {
    57	            apiKey: apiKey ?? '',
    58	            model: model.apiModel,
    59	            smartFormat: request.smartFormat,
    60	            spokenPunctuation: request.spokenPunctuation,
    61	          },
    62	          ...common,
    63	        });
    64	      }
    65	      if (model.provider === 'elevenlabs') {
    66	        return transcribeScribe({ audio: request.audio, hint, config: { apiKey: apiKey ?? '', model: model.apiModel }, ...common });
    67	      }
    68	      if (model.provider === 'gemini') {
    69	        return transcribeGemini({ audio: request.audio, hint, config: { apiKey: apiKey ?? '', model: model.apiModel }, ...common });
    70	      }
    71	      const version = parakeetVersionFromCatalogId(model.id);
    72	      if (model.provider === 'nvidia' && version) {
    73	        const problem = parakeetLanguageProblem(version, request.language);
    74	        if (problem) throw new ProviderError('badRequest', problem, { provider: 'Parakeet' });
    75	        return deps.parakeet.transcribe(request.audio, version, signal, request.language);
    76	      }
    77	      throw new ProviderError('notConfigured', `${model.name} can't run here.`);
    78	    },
    79	  };
    80	}
