   333	  }
   334	
   335	  private failPending(reason: string): void {
   336	    console.warn(`Parakeet worker ended: ${reason}`);
   337	    const error = new ProviderError('transport', 'Parakeet stopped unexpectedly. Try again.', PARAKEET_PROVIDER);
   338	    for (const resolve of [...this.pending.values()]) resolve(error);
   339	  }
   340	
   341	  private stopWorker(): void {
   342	    this.clearIdle();
   343	    const worker = this.worker;
   344	    this.worker = null;
   345	    this.workerVersion = null;
   346	    if (worker) worker.kill();
   347	    if (this.pending.size > 0) this.failPending('stopped');
   348	  }
   349	
   350	  private armIdle(): void {
   351	    this.clearIdle();
   352	    if (!this.worker || this.pending.size > 0) return;
   353	    if (this.pinned !== null && this.pinned === this.workerVersion) return;
   354	    this.idleTimer = setTimeout(() => this.stopWorker(), this.idleMs);
