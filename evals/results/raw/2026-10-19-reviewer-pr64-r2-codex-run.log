    98	function open(state: FirstRunStateDTO, fromSettings: boolean): void {
    99	  const step = fromSettings ? null : state.step;
   100	  const jump = step ? jumpFor(step) : null;
   101	  flow = {
   102	    page: jump?.page ?? 'welcome',
   103	    forced: state.forced,
   104	    fromSettings,
   105	    frozen: step !== null,
   106	    step,
   107	    keySaved: state.keySaved || jump?.page === 'deepgramKey',
   108	    changingKey: false,
   109	    keyText: '',
   110	    keyCheck: 'idle',
   111	    keyMessage: '',
   112	    hotkey: state.hotkey,
   113	    language: state.language,
   114	    practiceText: '',
   115	    practiceWorked: false,
   116	  };
   117	  if (step === 'errKey') {
   118	    flow.keyText = '3f9a1c7e5b2d8a64f0c1';
   119	    flow.keyCheck = 'rejected';
   120	    flow.keyMessage = KEY_MESSAGES.rejected;
   121	  }
   122	  if (step === 'tryItDone') {
   123	    flow.practiceText = 'Hello from Useful Voice.';
   124	    flow.practiceWorked = true;
   125	  }
   126	
   127	  const drag = el('div', { class: 'fr-drag' });
   128	  stage = el('div', { class: 'fr-stage' });
   129	  live = el('div', { class: 'sr-only', role: 'status', 'aria-live': 'polite', 'aria-atomic': 'true' });
   130	  overlay = el('div', { class: 'fr', role: 'dialog', 'aria-modal': 'true', 'aria-label': 'Set up Useful Voice' } as never, drag, stage, live);
   131	  overlay.addEventListener('keydown', onKeydown);
   132	  document.body.append(overlay);
   133	  // The shell underneath stays out of the tab order and the accessibility tree.
   134	  document.getElementById('root')?.setAttribute('inert', '');
   135	  firstPaint = true;
   136	  void api.firstRunSetOpen(true);
   137	  show(flow.page);
   138	}
   139	
   140	function jumpFor(step: FirstRunStep): { page: Page } {
   141	  switch (step) {
   142	    case 'engine':
   143	    case 'errKey':
   144	      return { page: 'engine' };
   145	    case 'deepgramKey':
   146	      return { page: 'deepgramKey' };
   147	    case 'microphone':
   148	    case 'errMic':
   149	      return { page: 'microphone' };
   150	    case 'tryIt':
   151	    case 'tryItDone':
   152	      return { page: 'tryIt' };
   153	    case 'done':
   154	      return { page: 'done' };
   155	    default:
   156	      return { page: 'welcome' };
   157	  }
   158	}
