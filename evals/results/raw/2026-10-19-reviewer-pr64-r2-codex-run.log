   259	// ---- API keys ----------------------------------------------------------------------
   260	
   261	/** The API keys group: one row per provider. */
   262	export function keysGroup(host: ModelsHost): HTMLElement {
   263	  keyRows.clear();
   264	  const surface = el('div', { class: 's-surface' });
