    87	    url: config.endpoint ?? ELEVENLABS_ENDPOINT,
    88	    headers: { 'xi-api-key': config.apiKey },
    89	    form,
    90	    deadlineSeconds: deadlineForAudioBytes(audio.byteLength),
    91	  };
    92	}
