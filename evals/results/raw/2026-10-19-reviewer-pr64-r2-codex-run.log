   380	    const snapshot = this.states();
   381	    for (const listener of [...this.listeners]) listener(snapshot);
   382	  }
   383	
   384	  // MARK: download
   385	
   386	  private async runDownload(version: ParakeetVersion, signal: AbortSignal): Promise<void> {
   387	    const root = this.modelsRoot();
   388	    const partial = this.partialPath(version);
   389	    const tmp = path.join(root, `.parakeet-${version}.extract`);
   390	    this.set(version, { status: 'downloading', progress: null });
   391	    try {
   392	      await fsp.mkdir(root, { recursive: true });
   393	      await this.fetchArchive(version, partial, signal);
   394	      // Progress stays at the end while the archive unpacks.
   395	      await fsp.rm(tmp, { recursive: true, force: true });
   396	      await fsp.mkdir(tmp);
   397	      try {
   398	        await this.extractImpl(partial, tmp, signal);
   399	      } catch (e) {
   400	        if (signal.aborted) throw new Cancelled();
   401	        await fsp.rm(partial, { force: true });
   402	        throw new Error(`The download is damaged and was removed. Try again. (${errorMessage(e)})`);
   403	      }
   404	      if (signal.aborted) throw new Cancelled();
   405	      const source = await this.findModelFolder(tmp);
   406	      const manifest = await this.verify(source, version);
   407	      await fsp.writeFile(path.join(source, MANIFEST), JSON.stringify(manifest), 'utf8');
   408	      const final = this.modelDir(version);
   409	      await fsp.rm(final, { recursive: true, force: true });
   410	      await fsp.rename(source, final);
   411	      await fsp.rm(tmp, { recursive: true, force: true });
   412	      await fsp.rm(partial, { force: true });
   413	      this.set(version, readState(final, version));
   414	      this.preload(version);
   415	    } catch (error) {
   416	      await fsp.rm(tmp, { recursive: true, force: true }).catch(() => undefined);
   417	      if (error instanceof Cancelled || signal.aborted) {
   418	        this.set(version, readState(this.modelDir(version), version));
   419	      } else {
   420	        this.set(version, { status: 'failed', message: errorMessage(error) });
   421	      }
   422	    }
   423	  }
   424	
   425	  private async fetchArchive(version: ParakeetVersion, partial: string, signal: AbortSignal): Promise<void> {
   426	    let have = 0;
   427	    try {
   428	      have = (await fsp.stat(partial)).size;
   429	    } catch {
   430	      have = 0;
   431	    }
   432	    let response: Response;
   433	    try {
   434	      response = await this.fetchImpl(parakeetArchiveUrl(version), {
   435	        signal,
   436	        headers: have > 0 ? { Range: `bytes=${have}-` } : {},
   437	      });
   438	    } catch (e) {
   439	      if (signal.aborted) throw new Cancelled();
   440	      throw new Error(`Couldn't reach the download server. Check your connection and try again. (${errorMessage(e)})`);
   441	    }
   442	    if (response.status === 416 && have > 0) {
   443	      // The partial file is not usable for this archive; start over.
   444	      await fsp.rm(partial, { force: true });
   445	      return this.fetchArchive(version, partial, signal);
   446	    }
   447	    if (response.status !== 200 && response.status !== 206) {
   448	      throw new Error(`The download failed (HTTP ${response.status}). Try again later.`);
   449	    }
   450	    const resumed = response.status === 206 && have > 0;
   451	    if (!resumed) have = 0;
   452	    const length = Number(response.headers.get('content-length'));
   453	    const total = Number.isFinite(length) && length > 0 ? have + length : null;
   454	    if (!response.body) throw new Error('The download server sent no data.');
   455	
   456	    const handle = await fsp.open(partial, resumed ? 'a' : 'w');
   457	    let received = have;
   458	    let lastEmit = 0;
   459	    try {
   460	      const reader = response.body.getReader();
   461	      for (;;) {
   462	        const { done, value } = await reader.read();
   463	        if (done) break;
   464	        await handle.write(value);
   465	        received += value.byteLength;
   466	        const now = Date.now();
   467	        if (now - lastEmit >= 200) {
   468	          lastEmit = now;
   469	          this.set(version, { status: 'downloading', progress: total ? Math.min(1, received / total) : null });
   470	        }
   471	      }
   472	    } catch (e) {
   473	      if (signal.aborted) throw new Cancelled();
   474	      throw new Error(`The download was interrupted. Try again to continue. (${errorMessage(e)})`);
   475	    } finally {
   476	      await handle.close();
   477	    }
   478	    if (total !== null && received !== total) {
   479	      throw new Error('The download was cut short. Try again to continue.');
   480	    }
   481	    this.set(version, { status: 'downloading', progress: 1 });
   482	  }
   483	
   484	  /** The archive holds one folder; accept the files at the top level too. */
   485	  private async findModelFolder(tmp: string): Promise<string> {
   486	    const candidates = [tmp];
   487	    for (const entry of await fsp.readdir(tmp, { withFileTypes: true })) {
   488	      if (entry.isDirectory()) candidates.push(path.join(tmp, entry.name));
   489	    }
   490	    for (const dir of candidates) {
   491	      if (fs.existsSync(path.join(dir, PARAKEET_FILES[0]))) return dir;
   492	    }
   493	    throw new Error('The download is missing model files. Try again.');
   494	  }
   495	
   496	  private async verify(dir: string, version: ParakeetVersion): Promise<Manifest> {
   497	    const files: Record<string, number> = {};
   498	    for (const name of PARAKEET_FILES) {
   499	      let size = 0;
   500	      try {
   501	        size = (await fsp.stat(path.join(dir, name))).size;
   502	      } catch {
   503	        size = 0;
   504	      }
   505	      if (size <= 0) throw new Error(`The download is missing ${name}. Try again.`);
   506	      files[name] = size;
   507	    }
   508	    return { version, files };
   509	  }
   510	}

