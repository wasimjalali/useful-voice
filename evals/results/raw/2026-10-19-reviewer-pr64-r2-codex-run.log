   106	export interface TranscribeOptions {
   107	  audio: Uint8Array;
   108	  hint: TranscriptionHint;
   109	  config: GeminiTranscribeConfig;
   110	  fetchImpl?: typeof fetch;
   111	  signal?: AbortSignal;
