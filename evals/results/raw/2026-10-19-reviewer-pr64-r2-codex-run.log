   193	   * isn't downloaded. Honors `signal`. `language` is the person's pin ('auto' or a code); a
   194	   * language the model doesn't speak fails before any work.
   195	   */
   196	  async transcribe(
   197	    wav: Uint8Array,
   198	    version: ParakeetVersion,
   199	    signal?: AbortSignal,
   200	    language?: string,
   201	  ): Promise<Transcript> {
   202	    const pin = checkParakeetLanguage(version, language);
   203	    if (this.current[version].status !== 'ready') {
   204	      throw new ProviderError('notConfigured', 'Parakeet is not downloaded. Download it in Settings to use it.', PARAKEET_PROVIDER);
   205	    }
   206	    if (signal?.aborted) throw new ProviderError('cancelled', 'Transcription was cancelled.', PARAKEET_PROVIDER);
   207	    const audio = parseWavToFloat32(wav);
   208	    if (audio.samples.length === 0) return { text: '', durationSeconds: 0, detectedLanguage: pin };
   209	
   210	    // A preload in flight loads the model once; wait for it rather than loading twice.
   211	    if (this.preloading) await this.preloading;
   212	    const response = await this.exchange(version, audio.samples, audio.sampleRate, audio.durationSeconds, signal, false);
   213	    if (!response.ok) {
   214	      throw new ProviderError('transport', `Parakeet couldn't transcribe: ${response.error}`, PARAKEET_PROVIDER);
   215	    }
