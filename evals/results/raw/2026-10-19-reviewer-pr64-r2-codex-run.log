    31	/** The steps `--first-run-step=<step>` can jump to, with the sample data each needs. */
    32	export const FIRST_RUN_STEPS = [
    33	  'welcome',
    34	  'engine',
    35	  'errKey',
    36	  'deepgramKey',
    37	  'microphone',
    38	  'errMic',
    39	  'tryIt',
    40	  'tryItDone',
    41	  'done',
    42	] as const;
    43	
    44	export type FirstRunStep = (typeof FIRST_RUN_STEPS)[number];
    45	
    46	export interface FirstRunLaunch {
    47	  forced: boolean;
    48	  step: FirstRunStep | null;
    49	}
    50	
    51	/** `--force-first-run` and `--first-run-step=<step>` from the command line. */
    52	export function firstRunLaunch(argv: readonly string[]): FirstRunLaunch {
    53	  const forced = argv.includes('--force-first-run');
    54	  const prefix = '--first-run-step=';
    55	  const raw = argv.find((arg) => arg.startsWith(prefix))?.slice(prefix.length) ?? '';
    56	  const step = (FIRST_RUN_STEPS as readonly string[]).includes(raw) ? (raw as FirstRunStep) : null;
    57	  return { forced, step };
    58	}
    59	
    60	/**
    61	 * Whether the main window opens at launch. The app is tray-only, so without this a fresh
    62	 * install would never show the flow. A launch from the login entry opens nothing (nobody
    63	 * clicked, and a window should not jump in front of their work); the flow stays pending
    64	 * and shows the first time they open the window.
    65	 */
    66	export function shouldOpenAtLaunch({ pending, autoStarted }: { pending: boolean; autoStarted: boolean }): boolean {
    67	  return pending && !autoStarted;
    68	}
