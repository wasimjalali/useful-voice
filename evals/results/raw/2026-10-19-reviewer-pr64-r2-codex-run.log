    26	/** Keyterms Scribe accepts: at most 50, each under 50 characters and five words, none with markup characters. */
    27	export function selectKeyterms(terms: readonly string[]): string[] {
    28	  const chosen: string[] = [];
    29	  for (const raw of terms) {
    30	    const term = raw.trim();
    31	    if (term.length === 0 || term.length > MAX_KEYTERM_LENGTH) continue;
    32	    if (term.split(/\s+/).length > MAX_KEYTERM_WORDS) continue;
    33	    if (FORBIDDEN_IN_KEYTERM.test(term)) continue;
    34	    if (chosen.includes(term)) continue;
    35	    chosen.push(term);
    36	    if (chosen.length === MAX_KEYTERMS) break;
    37	  }
    38	  return chosen;
