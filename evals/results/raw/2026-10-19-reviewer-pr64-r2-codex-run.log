     2	 * Decides whether the first-run flow opens at launch. Pure: the caller reads the
     3	 * system state and passes it in, so every rule is unit-tested.
     4	 */
     5	
     6	export type FirstRunDecision =
     7	  /** Open the flow at Welcome. */
     8	  | 'show'
     9	  /** Normal launch. */
    10	  | 'skip'
    11	  /** Normal launch, and record that setup is done: an existing user upgrading with a key saved. */
    12	  | 'skipAndMarkCompleted';
    13	
    14	export interface FirstRunInput {
    15	  completed: boolean;
    16	  /**
    17	   * A Deepgram key is stored. Presence only: a key that cannot be decrypted right now
    18	   * still counts, so an upgrade never walks an existing user through setup.
    19	   */
    20	  keyStored: boolean;
    21	  forced: boolean;
    22	}
    23	
    24	export function decideFirstRun({ completed, keyStored, forced }: FirstRunInput): FirstRunDecision {
    25	  if (forced) return 'show';
    26	  if (completed) return 'skip';
    27	  if (keyStored) return 'skipAndMarkCompleted';
    28	  return 'show';
    29	}
