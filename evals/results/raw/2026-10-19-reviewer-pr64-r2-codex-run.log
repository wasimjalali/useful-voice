    80	      const available = bytes.length - body;
    81	      const length = Math.min(declared === 0 ? available : declared, available) & ~1;
    82	      const count = length / 2;
    83	      const samples = new Float32Array(count);
    84	      for (let i = 0; i < count; i += 1) samples[i] = view.getInt16(body + i * 2, true) / 32768;
