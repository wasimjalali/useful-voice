    45	  fin: 'fi', ces: 'cs', ell: 'el', heb: 'he', hun: 'hu', ind: 'id', ron: 'ro', bul: 'bg', hrv: 'hr', slk: 'sk',
    46	  slv: 'sl', cat: 'ca', fas: 'fa', vie: 'vi', tha: 'th', lit: 'lt', lav: 'lv', est: 'et', msa: 'ms', ben: 'bn',
    47	};
