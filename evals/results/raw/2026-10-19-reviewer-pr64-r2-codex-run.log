    56	  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
    57	  const tag = (o: number) => String.fromCharCode(bytes[o]!, bytes[o + 1]!, bytes[o + 2]!, bytes[o + 3]!);
    58	  if (tag(0) !== 'RIFF' || tag(8) !== 'WAVE') throw bad('it is not a WAV file.');
    59	
    60	  let format: { code: number; channels: number; rate: number; bits: number } | null = null;
    61	  let offset = 12;
    62	  while (offset + 8 <= bytes.length) {
    63	    const id = tag(offset);
    64	    const declared = view.getUint32(offset + 4, true);
    65	    const body = offset + 8;
    66	    if (id === 'fmt ') {
    67	      if (body + 16 > bytes.length) throw bad('the format header is cut off.');
    68	      format = {
    69	        code: view.getUint16(body, true),
    70	        channels: view.getUint16(body + 2, true),
    71	        rate: view.getUint32(body + 4, true),
    72	        bits: view.getUint16(body + 14, true),
    73	      };
    74	    } else if (id === 'data') {
    75	      if (!format) throw bad('the data comes before the format header.');
    76	      if (format.code !== 1 || format.bits !== 16) throw bad('only 16-bit PCM audio is supported.');
    77	      if (format.channels !== 1) throw bad('only mono audio is supported.');
    78	      if (format.rate !== 16000) throw bad('only 16 kHz audio is supported.');
