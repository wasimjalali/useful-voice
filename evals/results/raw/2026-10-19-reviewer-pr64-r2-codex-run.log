    93	export function classifyHttpError(status: number, body: string, apiKey?: string): ProviderError {
    94	  const detail = describeErrorBody(body, apiKey);
    95	  const suffix = detail.length > 0 ? `: ${detail}` : '';
    96	  const options = { status, provider: PROVIDER };
    97	  // Gemini answers a malformed key with 400 API_KEY_INVALID rather than 401.
    98	  if (status === 401 || status === 403 || (status === 400 && /API_KEY_INVALID|API key not valid/i.test(body))) {
    99	    return new ProviderError('unauthorized', `The Gemini API key was rejected${suffix}`, options);
   100	  }
   101	  if (status === 429) return new ProviderError('rateLimited', `Gemini rate limit reached${suffix}`, options);
   102	  if (status >= 500) return new ProviderError('serverError', `Gemini is having trouble (HTTP ${status})${suffix}`, options);
   103	  return new ProviderError('badRequest', `Transcription failed (HTTP ${status})${suffix}`, options);
   104	}
