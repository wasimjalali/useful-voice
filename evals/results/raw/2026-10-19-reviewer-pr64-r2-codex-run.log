   222	    void this.save();
   223	    return { ok: true };
   224	  }
   225	
   226	  clearKey(provider: KeyProvider): void {
   227	    if (provider === 'deepgram') {
   228	      this.clearApiKey();
   229	      return;
   230	    }
   231	    this.extraKeys.delete(provider);
   232	    void this.save();
   233	  }
   234	
   235	  onSaveStatus(listener: (status: SaveStatus) => void): () => void {
   236	    this.statusListeners.add(listener);
   237	    return () => this.statusListeners.delete(listener);
   238	  }
   239	
   240	  update(patch: Partial<AppSettings>): AppSettings {
   241	    this.settings = {
   242	      ...this.settings,
   243	      ...patch,
   244	      hotkey: { ...this.settings.hotkey, ...(patch.hotkey ?? {}) },
   245	    };
   246	    // Bring the values the UI can set back inside their supported ranges, so a
   247	    // bad value cannot produce an unresponsive recorder (a zero-second silence
   248	    // timeout, or a 15-hour cap). Shared with load, and pure, so the bounds
   249	    // themselves are unit-tested rather than assumed.
   250	    this.settings = normaliseSettings(this.settings);
   251	    void this.save();
   252	    return this.settings;
   253	  }
   254	
   255	  setApiKey(key: string): { ok: boolean; error?: string } {
   256	    const trimmed = key.trim();
   257	    if (trimmed.length === 0) return { ok: false, error: 'The API key is empty.' };
   258	    this.apiKey = trimmed;
   259	    this.undecryptedBlob = null;
   260	    this.keyOnDisk = true;
   261	    this.plaintextKeyWarning = false;
   262	    void this.save();
   263	    return { ok: true };
   264	  }
   265	
   266	  clearApiKey(): void {
   267	    this.apiKey = null;
   268	    this.undecryptedBlob = null;
   269	    this.keyOnDisk = false;
   270	    this.plaintextKeyWarning = false;
   271	    void this.save();
   272	  }
   273	
   274	  private encrypt(value: string): { data: string; plaintextFallback: boolean } {
   275	    if (safeStorage.isEncryptionAvailable()) {
   276	      return { data: safeStorage.encryptString(value).toString('base64'), plaintextFallback: false };
   277	    }
   278	    // No DPAPI (rare; some Windows Server and CI configurations). Store anyway so
   279	    // the app still works, but remember to tell the user, since a key in
   280	    // plaintext on disk is a real exposure.
   281	    return { data: Buffer.from(value, 'utf8').toString('base64'), plaintextFallback: true };
   282	  }
   283	
   284	  /**
   285	   * `storedAsPlaintext`: the file says the key was saved without encryption. Only then, or
   286	   * when encryption is unavailable now, is the blob read as text; while DPAPI works, a
   287	   * blob it cannot decrypt is not a key, and reading it as UTF-8 would invent a garbage one.
   288	   */
   289	  private decrypt(stored: string, storedAsPlaintext: boolean): string | null {
   290	    const buffer = Buffer.from(stored, 'base64');
   291	    if (storedAsPlaintext) {
   292	      // Saved without encryption (the file says so): it is text, and is read as text.
   293	      const text = buffer.toString('utf8');
   294	      return text.length > 0 ? text : null;
   295	    }
   296	    if (!safeStorage.isEncryptionAvailable()) return null;
   297	    try {
   298	      return safeStorage.decryptString(buffer);
   299	    } catch {
   300	      return null;
   301	    }
   302	  }
   303	
   304	  private saveChain: Promise<unknown> = Promise.resolve();
   305	
   306	  /**
   307	   * Persist settings and the key. Reports failure instead of swallowing it.
   308	   *
   309	   * Saves run one after another: two overlapping writes of the same file (a key save
   310	   * the settings page kicks off while another caller awaits its own) fight over the
   311	   * temp file and one of them fails.
   312	   */
   313	  save(): Promise<SaveStatus> {
   314	    const run = this.saveChain.then(() => this.write());
   315	    this.saveChain = run.catch(() => undefined);
   316	    return run;
   317	  }
   318	
   319	  private async write(): Promise<SaveStatus> {
   320	    if (this.frozen) return { ok: true };
   321	    const payload: SettingsFile = {
   322	      version: CURRENT_SETTINGS_VERSION,
   323	      settings: this.settings,
   324	      ...(this.completedFirstRun ? { firstRunCompleted: true } : {}),
   325	    };
   326	    if (this.apiKey !== null && this.apiKey.length > 0) {
   327	      const encrypted = this.encrypt(this.apiKey);
   328	      payload.apiKeyEncrypted = encrypted.data;
   329	      this.plaintextKeyWarning = encrypted.plaintextFallback;
   330	      payload.apiKeyPlaintextWarning = encrypted.plaintextFallback;
   331	    } else if (this.undecryptedBlob !== null) {
   332	      // Could not be read on this account: keep it as it was, for the account that can.
   333	      payload.apiKeyEncrypted = this.undecryptedBlob;
   334	    }
   335	
   336	    const providerKeys: Partial<Record<ExtraKeyProvider, StoredKey>> = {};
   337	    for (const [provider, entry] of this.extraKeys) {
   338	      if (entry.key !== null && entry.key.length > 0) {
   339	        const encrypted = this.encrypt(entry.key);
   340	        providerKeys[provider] = { data: encrypted.data, ...(encrypted.plaintextFallback ? { plaintext: true } : {}) };
   341	      } else if (entry.undecrypted) {
   342	        providerKeys[provider] = entry.undecrypted;
   343	      }
   344	    }
   345	    if (Object.keys(providerKeys).length > 0) payload.providerKeys = providerKeys;
   346	
   347	    try {
   348	      await writeJsonAtomic(this.filePath, payload);
   349	      this.lastSaveError = null;
   350	      const status: SaveStatus = { ok: true };
   351	      this.emitStatus(status);
   352	      return status;
   353	    } catch (error) {
   354	      const wrapped = error instanceof Error ? error : new Error(String(error));
   355	      this.lastSaveError = wrapped;
   356	      const status: SaveStatus = {
   357	        ok: false,
   358	        message: 'Your changes could not be saved. Check free disk space and folder permissions.',
   359	      };
   360	      this.emitStatus(status);
   361	      return status;
   362	    }
   363	  }
   364	
   365	  private emitStatus(status: SaveStatus): void {
   366	    for (const listener of this.statusListeners) {
   367	      try {
   368	        listener(status);
   369	      } catch {
   370	        // A failing listener must not break saving.
   371	      }
   372	    }
   373	  }
   374	}
