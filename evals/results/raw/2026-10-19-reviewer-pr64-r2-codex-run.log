     1	/* ==========================================================================
     2	   Settings > Models: the voice model and AI formatting lists.
     3	   One row per model: radio dot, monogram tile, name and badge, two 5-segment meters,
     4	   and a right column (Cloud, Add key, Download, progress, Delete). Wide rows share
     5	   columns, so the Speed and Accuracy header sits over both lists. Below 560 px the
     6	   meters drop under the name.
     7	   ========================================================================== */
     8	
     9	.m-lists {
    10	  display: flex;
    11	  flex-direction: column;
    12	  gap: 24px;
    13	  container-type: inline-size;
    14	}
    15	
    16	.m-title { margin: 0 0 8px; font-size: var(--fs-body); font-weight: 600; letter-spacing: -0.005em; }
    17	
    18	/* The grid every row and the header share. */
    19	.m-columns,
    20	.m-row {
    21	  --m-cols: 16px 28px minmax(0, 1fr) 72px 72px 160px;
    22	  display: grid;
    23	  grid-template-columns: var(--m-cols);
    24	  column-gap: 10px;
    25	  align-items: center;
    26	}
    27	
    28	.m-columns {
    29	  min-height: 34px;
    30	  padding: 0 16px;
    31	  border-bottom: 1px solid var(--line);
    32	  font-size: var(--fs-label);
    33	  font-weight: 600;
    34	  letter-spacing: 0.02em;
    35	  color: var(--ink-muted);
    36	}
    37	/* Speed and Accuracy sit over their meters: columns 4 and 5. */
    38	.m-columns > :nth-child(1) { grid-column: 1 / 4; }
    39	.m-columns > :nth-child(2) { grid-column: 4; }
    40	.m-columns > :nth-child(3) { grid-column: 5; }
    41	.m-columns > :nth-child(4) { grid-column: 6; }
    42	
    43	.m-list .m-row { padding: 0 16px; min-height: 52px; border-bottom: 1px solid var(--line); cursor: pointer; }
    44	.m-list .m-row:last-child { border-bottom: 0; }
    45	.m-list .m-row:hover { background: color-mix(in srgb, var(--sunken) 55%, transparent); }
    46	.m-list .m-row.is-selected { background: var(--sunken); }
    47	
    48	/* The focusable radio: it spans the left five columns and borrows their tracks. */
    49	.m-pick {
    50	  grid-column: 1 / 6;
    51	  display: grid;
    52	  grid-template-columns: subgrid;
    53	  align-items: center;
    54	  min-height: 52px;
    55	  outline: none;
    56	}
    57	.m-pick:focus-visible { box-shadow: inset 0 0 0 2px var(--ink); border-radius: var(--r-xs); }
    58	.m-pick[aria-disabled="true"] .m-name-text { color: var(--ink-muted); }
    59	.m-pick[aria-disabled="true"] .m-tile { opacity: 0.6; }
    60	.m-pick[aria-disabled="true"] .m-meter { opacity: 0.55; }
    61	
    62	.m-dot {
    63	  width: 16px;
    64	  height: 16px;
    65	  box-sizing: border-box;
    66	  border: 1.5px solid var(--control-edge);
    67	  border-radius: 50%;
    68	  background: var(--surface);
    69	  transition: border-color var(--dur-hover) var(--ease-out), background var(--dur-hover) var(--ease-out);
    70	}
    71	.is-selected .m-dot { border-color: var(--ink); background: radial-gradient(circle, var(--ink) 0 4px, var(--surface) 4.5px); }
    72	
    73	/* A monogram, not a vendor logo. */
    74	.m-tile {
    75	  display: grid;
    76	  place-items: center;
    77	  width: 28px;
    78	  height: 28px;
    79	  border-radius: var(--r-xs);
    80	  background: var(--sunken);
    81	  border: 1px solid var(--line-strong);
    82	  color: var(--ink);
    83	  font-size: var(--fs-label);
    84	  font-weight: 650;
    85	  letter-spacing: -0.01em;
    86	}
    87	.is-selected .m-tile { background: var(--ink); border-color: var(--ink); color: var(--surface); }
    88	
    89	.m-name { display: flex; align-items: center; gap: 8px; min-width: 0; }
    90	.m-name-text { font-size: var(--fs-body); font-weight: 550; color: var(--ink); min-width: 0; overflow-wrap: break-word; }
    91	.m-badge {
    92	  flex: none;
    93	  padding: 1px 6px;
    94	  border: 1px solid var(--line-strong);
    95	  border-radius: var(--r-pill);
    96	  font-size: 10px;
    97	  font-weight: 650;
    98	  letter-spacing: 0.04em;
    99	  color: var(--ink-muted);
   100	}
   101	
   102	/* display: contents keeps the two meters in the grid's columns 4 and 5. */
   103	.m-meters { display: contents; }
   104	.m-meter { display: inline-flex; gap: 2px; }
   105	.m-meter i {
   106	  width: 12px;
   107	  height: 6px;
   108	  border-radius: 2px;
   109	  background: var(--line-strong);
   110	}
   111	.m-meter i.on { background: var(--ink); }
   112	
   113	.m-side {
   114	  grid-column: 6;
   115	  display: flex;
   116	  align-items: center;
   117	  justify-content: flex-end;
   118	  gap: 8px;
   119	  padding: 8px 0;
   120	  font-size: var(--fs-meta);
   121	  color: var(--ink-muted);
   122	}
   123	.m-where { white-space: nowrap; }
   124	.m-bad { color: var(--danger); }
   125	
   126	.m-progress { display: block; width: 72px; height: 4px; border-radius: 2px; background: var(--line-strong); overflow: hidden; }
   127	.m-progress i { display: block; height: 100%; width: 0; background: var(--ink); transition: width var(--dur-hover) linear; }
   128	.m-progress.is-unknown i { width: 40%; animation: m-slide 1.1s var(--ease-out) infinite alternate; }
   129	@keyframes m-slide { from { transform: translateX(0); } to { transform: translateX(150%); } }
   130	@media (prefers-reduced-motion: reduce) {
   131	  .m-progress.is-unknown i { animation: none; width: 100%; opacity: 0.5; }
   132	}
   133	
   134	/* The Setup row sits under the keys with the same gap as between groups' rows. */
   135	.s-setup { margin-top: 12px; }
   136	
   137	/* Narrow: each row stacks. The name, then the two meters under it, then what the model needs. */
   138	@container (max-width: 560px) {
   139	  .m-columns { display: none; }
   140	  .m-list .m-row { display: flex; flex-wrap: wrap; align-items: center; padding: 6px 14px 8px; min-height: 0; }
   141	  .m-pick {
   142	    flex: 1 1 100%;
   143	    grid-template-columns: 16px 28px minmax(0, 1fr);
   144	    grid-template-rows: auto auto;
   145	    column-gap: 12px;
   146	    row-gap: 4px;
   147	    min-height: 44px;
   148	  }
   149	  .m-pick > .m-dot,
   150	  .m-pick > .m-tile { grid-row: 1; }
   151	  .m-pick > .m-name { grid-column: 3; grid-row: 1; }
   152	  .m-pick > .m-meters {
   153	    display: flex;
   154	    flex-wrap: wrap;
   155	    grid-column: 3;
   156	    grid-row: 2;
   157	    gap: 2px 14px;
   158	    align-items: center;
   159	  }
   160	  .m-meter { align-items: center; }
   161	  .m-meter::before { content: attr(data-label); display: inline-block; min-width: 54px; margin-right: 4px; font-size: var(--fs-label); color: var(--ink-muted); }
   162	  .m-side { flex: 1 1 100%; justify-content: flex-start; flex-wrap: wrap; padding: 2px 0 2px 68px; }
   163	  .m-progress { width: 64px; }
   164	}

