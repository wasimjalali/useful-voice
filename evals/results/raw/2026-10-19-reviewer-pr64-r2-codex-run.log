   142	      cell.append(
   143	        el('span', failed ? { class: 'm-where m-bad', title: info.message } : { class: 'm-where' }, failed ? 'Download failed' : PARAKEET_APPROX),
   144	        el(
   145	          'button',
   146	          { class: 'btn btn-secondary btn-sm', type: 'button', 'aria-label': `${failed ? 'Retry' : 'Download'} ${model.name}`, onclick: () => startDownload(model) } as never,
   147	          failed ? 'Retry' : 'Download',
   148	        ),
   149	      );
   150	    }
   151	    return cell;
   152	  };
   153	
   154	  const modelRow = (kind: 'voice' | 'language', model: CatalogModel | null, selectedId: string | null, tabbable: boolean): HTMLElement => {
   155	    const selected = (model?.id ?? null) === selectedId;
   156	    const row = el('div', { class: `m-row${selected ? ' is-selected' : ''}` });
   157	    const action = model ? pickAction(model, keys(), parakeetStates) : 'select';
   158	    const name = model ? model.name : 'Off';
   159	    const label = model ? `${name}, speed ${model.speed} of 5, accuracy ${model.accuracy} of 5` : name;
   160	    const radio = el('div', {
   161	      class: 'm-pick',
   162	      role: 'radio',
   163	      tabindex: tabbable ? 0 : -1,
   164	      'aria-checked': selected ? 'true' : 'false',
   165	      'aria-label': label,
   166	      ...(action === 'addKey' ? { 'aria-disabled': 'true' } : {}),
   167	    } as never);
   168	    radio.append(
   169	      el('span', { class: 'm-dot', 'aria-hidden': 'true' }),
   170	      el('span', { class: 'm-tile', 'aria-hidden': 'true' }, model ? MONOGRAMS[model.provider] : '–'),
   171	      el(
   172	        'span',
   173	        { class: 'm-name' },
   174	        el('span', { class: 'm-name-text' }, name),
   175	        model?.badge ? el('span', { class: 'm-badge' }, model.badge) : null,
   176	      ),
   177	    );
   178	    if (model) radio.append(el('span', { class: 'm-meters' }, meter('Speed', model.speed), meter('Accuracy', model.accuracy)));
   179	    row.append(radio);
   180	    if (model) row.append(side(model));
   181	
   182	    const choose = (): void => (model ? pick(kind, model) : void select(kind, null));
   183	    row.addEventListener('click', (event) => {
   184	      if ((event.target as HTMLElement).closest('button')) return;
   185	      choose();
   186	    });
   187	    radio.addEventListener('keydown', (event) => {
   188	      if (event.key === ' ' || event.key === 'Enter') {
   189	        event.preventDefault();
   190	        choose();
   191	      } else if (['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft'].includes(event.key)) {
   192	        event.preventDefault();
