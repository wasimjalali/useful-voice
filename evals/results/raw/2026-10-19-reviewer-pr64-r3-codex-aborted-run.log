   101	/// Builds and parses the Gemini and Anthropic formatting requests. Pure.
   102	public enum FormatterRequest {
   103	    public static let maximumVocabularyWords = 100
   104	
   105	    /// `<vocabulary>a, b</vocabulary>\n<dictation>\n{text}\n</dictation>`; the
   106	    /// vocabulary line only when there are words.
   107	    public static func userMessage(text: String, vocabulary: [String]) -> String {
   108	        let words = vocabulary
   109	            .map { $0.replacingOccurrences(of: "<", with: "").replacingOccurrences(of: ">", with: "")
   110	                .trimmingCharacters(in: .whitespacesAndNewlines) }
   111	            .filter { !$0.isEmpty }
   112	            .prefix(maximumVocabularyWords)
   113	        var message = ""
   114	        if !words.isEmpty { message += "<vocabulary>\(words.joined(separator: ", "))</vocabulary>\n" }
   115	        message += "<dictation>\n\(text)\n</dictation>"
   116	        return message
   117	    }
   118	
   119	    public static func deadline(for model: ModelEntry) -> TimeInterval {
   120	        model.apiModel == "claude-sonnet-5-5" ? 10 : 6
   121	    }
   122	
   123	    /// Twice the dictation plus room, within 512...8192. Counts the dictation only.
   124	    public static func maxTokens(forInput text: String) -> Int {
   125	        min(8192, max(512, text.utf16.count * 2 + 256))
   126	    }
   127	
   128	    /// 3.8 Flash rejects `minimal`, so its lowest level is `low`.
   129	    static func geminiThinkingLevel(_ apiModel: String) -> String { "low" }
   130	
   131	    static func gemini(model: ModelEntry, apiKey: String, text: String, vocabulary: [String]) throws -> URLRequest {
   132	        let url = URL(string: "https://generativelanguage.googleapis.com/v1beta/models/\(model.apiModel):generateContent")!
   133	        let level = geminiThinkingLevel(model.apiModel)
   134	        let body: [String: Any] = [
   135	            "systemInstruction": ["parts": [["text": FormatterPrompt.system]]],
   136	            "contents": [["role": "user", "parts": [["text": userMessage(text: text, vocabulary: vocabulary)]]]],
   137	            "generationConfig": ["thinkingConfig": ["thinkingLevel": level]],
   138	        ]
   139	        var request = URLRequest(url: url)
   140	        request.httpMethod = "POST"
   141	        request.setValue(apiKey, forHTTPHeaderField: "x-goog-api-key")
   142	        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
   143	        request.httpBody = try JSONSerialization.data(withJSONObject: body)
   144	        return request
   145	    }
   146	
   147	    static func anthropic(model: ModelEntry, apiKey: String, text: String, vocabulary: [String],
   148	                          includeThinkingField: Bool = true) throws -> URLRequest {
   149	        var body: [String: Any] = [
   150	            "model": model.apiModel,
   151	            "max_tokens": maxTokens(forInput: text),
   152	            "system": FormatterPrompt.system,
   153	            "messages": [["role": "user", "content": userMessage(text: text, vocabulary: vocabulary)]],
   154	        ]
   155	        // Thinking is on by default on 5.x and costs seconds, and sampling params are
   190	            let candidates: [Candidate]?
   191	            let promptFeedback: Feedback?
   192	        }
   193	        guard let decoded = try? JSONDecoder().decode(Response.self, from: data) else {
   194	            return .failure("unreadable response")
   195	        }
   196	        if decoded.promptFeedback?.blockReason != nil { return .failure("blocked") }
   197	        guard let candidate = decoded.candidates?.first else { return .failure("empty response") }
   198	        if candidate.finishReason != "STOP" {
   199	            switch candidate.finishReason {
   200	            case nil: return .failure("truncated")
   201	            case "MAX_TOKENS": return .failure("truncated")
   202	            case "SAFETY", "BLOCKLIST", "PROHIBITED_CONTENT", "SPII", "RECITATION", "IMAGE_SAFETY":
   203	                return .failure("blocked")
   204	            default: return .failure("stopped early")
   205	            }
   206	        }
   207	        let text = (candidate.content?.parts ?? []).filter { $0.thought != true }.compactMap(\.text).joined()
   208	        return text.isEmpty ? .failure("empty response") : .text(text)
   209	    }
   210	
   211	    /// Joined `text` blocks; never assumes `content[0]` is text. Anything but
   212	    /// `end_turn` (a `max_tokens` cut, a refusal) is a failure.
   213	    static func parseAnthropic(_ data: Data) -> Reply {
   214	        struct Response: Decodable {
   215	            struct Block: Decodable { let type: String; let text: String? }
   216	            let content: [Block]?
   217	            let stop_reason: String?
   218	        }
   219	        guard let decoded = try? JSONDecoder().decode(Response.self, from: data),
   220	              let blocks = decoded.content else { return .failure("unreadable response") }
   221	        if decoded.stop_reason != "end_turn" {
   222	            switch decoded.stop_reason {
   223	            case nil: return .failure("truncated")
   224	            case "max_tokens": return .failure("truncated")
   225	            case "refusal": return .failure("blocked")
   226	            default: return .failure("stopped early")
   227	            }
   228	        }
   229	        let text = blocks.filter { $0.type == "text" }.compactMap(\.text).joined()
   230	        return text.isEmpty ? .failure("empty response") : .text(text)
   231	    }
   232	}
