    69	/** Windows' own bsdtar reads .tar.bz2; elsewhere `tar` does the same. */
    70	export function defaultExtract(archive: string, destDir: string, signal: AbortSignal): Promise<void> {
    71	  const windowsTar = path.join(process.env.SystemRoot ?? 'C:\\Windows', 'System32', 'tar.exe');
    72	  const exe = process.platform === 'win32' && fs.existsSync(windowsTar) ? windowsTar : 'tar';
    73	  return new Promise((resolve, reject) => {
    74	    // Relative names and cwd keep a drive letter out of the arguments.
    75	    const child = spawn(exe, ['-xjf', path.basename(archive), '-C', path.basename(destDir)], {
    76	      cwd: path.dirname(archive),
    77	      windowsHide: true,
    78	      stdio: ['ignore', 'ignore', 'pipe'],
    79	    });
    80	    let stderr = '';
    81	    child.stderr.on('data', (d: Buffer) => (stderr = (stderr + d.toString()).slice(-500)));
    82	    const onAbort = () => child.kill();
    83	    signal.addEventListener('abort', onAbort, { once: true });
    84	    child.on('error', (e) => {
    85	      signal.removeEventListener('abort', onAbort);
    86	      reject(new Error(`Couldn't start tar: ${e.message}`));
    87	    });
    88	    child.on('close', (code) => {
    89	      signal.removeEventListener('abort', onAbort);
    90	      if (signal.aborted) reject(new Cancelled());
    91	      else if (code === 0) resolve();
    92	      else reject(new Error(`tar failed (${code}): ${stderr.trim()}`));
    93	    });
    94	  });
    95	}
