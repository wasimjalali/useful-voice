     5	/**
     6	 * A cheap authenticated call that tells whether a key works, for the three providers whose
     7	 * check is a plain GET (Deepgram's is a silent clip, run by the main process).
     8	 *
     9	 * The messages are fixed text by outcome, never the server's own: an error body can echo the key.
    10	 */
    11	export interface ProviderKeyCheck {
    12	  ok: boolean;
    13	  kind?: 'rejected' | 'network' | 'failed';
    14	  message: string;
    15	}
    16	
    17	const ANTHROPIC_MODELS_URL = ANTHROPIC_ENDPOINT.replace(/\/messages$/, '/models');
    18	const CHECK_DEADLINE_MS = 10_000;
    19	
    20	export function keyCheckRequest(provider: Exclude<KeyProvider, 'deepgram'>, apiKey: string): { url: string; headers: Record<string, string> } {
    21	  switch (provider) {
    22	    case 'elevenlabs':
    23	      return { url: ELEVENLABS_MODELS_ENDPOINT, headers: { 'xi-api-key': apiKey } };
    24	    case 'gemini': {
    25	      const model = LANGUAGE_MODELS.find((candidate) => candidate.provider === 'gemini');
    26	      return { url: `${GEMINI_ENDPOINT}/${model?.apiModel ?? 'gemini-3.8-flash'}`, headers: { 'x-goog-api-key': apiKey } };
    27	    }
    28	    case 'anthropic':
    29	      return { url: ANTHROPIC_MODELS_URL, headers: { 'x-api-key': apiKey, 'anthropic-version': ANTHROPIC_VERSION } };
    30	  }
    31	}
