   249	/// Runs the AI formatting step: one request to the chosen language model under a
   250	/// deadline, then the guard. Never throws; the dictation is never lost.
   251	public struct AIFormatter: Sendable {
   252	    public let model: ModelEntry
   253	    private let apiKey: @Sendable () -> String?
   254	    private let session: URLSession
   255	    private let diagnostics: Diagnostics
   256	
   257	    public init(model: ModelEntry,
   258	                apiKey: @escaping @Sendable () -> String?,
   259	                session: URLSession = .shared,
   260	                diagnostics: Diagnostics = .shared) {
   261	        self.model = model
   262	        self.apiKey = apiKey
   263	        self.session = session
   264	        self.diagnostics = diagnostics
   265	    }
   266	
   267	    /// Dictations under this many words are left alone.
   268	    public static let minimumWords = 3
   269	    /// Scripts written without spaces between words count characters instead.
   270	    public static let minimumUnspacedCharacters = 6
   271	
   272	    public static func shouldFormat(_ text: String) -> Bool {
   273	        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
   274	        if trimmed.unicodeScalars.contains(where: Self.isUnspacedScript) {
   275	            // Code points, not whitespace.
   276	            return trimmed.unicodeScalars.filter { !$0.properties.isWhitespace }.count >= minimumUnspacedCharacters
   277	        }
   278	        return trimmed.split(whereSeparator: { $0.isWhitespace }).count >= minimumWords
   279	    }
   280	
   281	    /// Han, Hiragana, Katakana, Thai, Lao, Khmer and Myanmar. Not Hangul: Korean is
   282	    /// written with spaces, so words apply.
   283	    static func isUnspacedScript(_ scalar: Unicode.Scalar) -> Bool {
   284	        switch scalar.value {
   285	        case 0x3040...0x30FF, 0x3400...0x4DBF, 0x4E00...0x9FFF, 0xF900...0xFAFF,
   286	             0x0E00...0x0EFF, 0x1000...0x109F, 0x1780...0x17FF, 0x20000...0x2FA1F:
   287	            return true
   288	        default:
   289	            return false
   290	        }
   291	    }
   292	
   293	    /// Formats `text`. Cancelling the calling task cancels the request.
   294	    public func format(_ text: String, vocabulary: [String]) async -> FormatterOutcome {
   295	        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
   296	        guard Self.shouldFormat(trimmed) else { return .skipped("short transcript") }
   297	        guard let key = apiKey()?.trimmingCharacters(in: .whitespacesAndNewlines), !key.isEmpty else {
   298	            return log(.skipped("no \(model.providerName) key"))
   299	        }
   300	        let timedOut = DeadlineFlag()
   301	        do {
   302	            let output = try await withDeadline(seconds: FormatterRequest.deadline(for: model),
   303	                                                timedOut: timedOut) {
   304	                try await self.run(text: trimmed, vocabulary: vocabulary, key: key)
   305	            }
   306	            guard let accepted = FormatterGuard.accept(input: trimmed, output: output) else {
   307	                return log(.failed("output rejected by the guard"))
   308	            }
   309	            return .formatted(accepted)
   310	        } catch where timedOut.isSet {
   311	            // The deadline fired: logged, unlike a cancel the person asked for.
   312	            return log(.failed("timeout"))
   313	        } catch is CancellationError {
   314	            return .failed("cancelled")
   315	        } catch let error as FormatterError {
   316	            return log(.failed(error.reason))
   317	        } catch let failure as HTTPFailure {
   318	            return log(.failed("HTTP \(failure.status)"))
   319	        } catch let urlError as URLError {
   320	            return log(.failed(urlError.code == .cancelled ? "cancelled"
   321	                               : urlError.code == .timedOut ? "timeout" : "network error \(urlError.code.rawValue)"))
   322	        } catch {
   323	            return log(.failed("unexpected error"))
   324	        }
   325	    }
   326	
   327	    private func log(_ outcome: FormatterOutcome) -> FormatterOutcome {
   328	        switch outcome {
   329	        case .skipped(let reason), .failed(let reason):
   330	            if reason != "short transcript", reason != "cancelled" {
   331	                // Provider, model and a fixed reason only: a response body can echo the dictation.
   332	                diagnostics.warning("formatter", "\(model.provider) \(model.apiModel): \(reason); delivered the unformatted text")
   333	            }
   334	        case .formatted: break
   335	        }
   336	        return outcome
   337	    }
