    97	/**
    98	 * Parakeet's download under `--e2e`: no request leaves the machine. The "server" answers a tiny
    99	 * archive, the "extraction" writes four one-byte files, and each URL asked for lands in e2e.log.
   100	 */
   101	export function parakeetE2eDeps(userData: string): {
   102	  fetch: typeof fetch;
   103	  extract: (archive: string, destDir: string) => Promise<void>;
   104	  spawnWorker: () => Promise<never>;
   105	} {
   106	  return {
   107	    fetch: (async (input: RequestInfo | URL) => {
   108	      const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
   109	      try {
   110	        appendFileSync(path.join(userData, 'e2e.log'), `${new Date().toISOString()} parakeet GET ${url}\n`);
   111	      } catch {
   112	        // The log is a diagnostic aid only.
   113	      }
   114	      return new Response(new Uint8Array(64), { status: 200, headers: { 'content-length': '64' } });
   115	    }) as typeof fetch,
   116	    extract: async (_archive, destDir) => {
   117	      for (const name of ['encoder.int8.onnx', 'decoder.int8.onnx', 'joiner.int8.onnx', 'tokens.txt']) {
   118	        writeFileSync(path.join(destDir, name), 'x');
   119	      }
   120	    },
   121	    // The one-byte "model" can't be loaded: no recognition process under --e2e.
   122	    spawnWorker: async () => {
   123	      throw new Error('no recognition worker under --e2e');
   124	    },
   125	  };
   126	}
