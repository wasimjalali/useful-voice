    33	export async function checkProviderKey(
    34	  provider: Exclude<KeyProvider, 'deepgram'>,
    35	  apiKey: string,
    36	  fetchImpl: typeof fetch = fetch,
    37	): Promise<ProviderKeyCheck> {
    38	  const name = KEY_PROVIDER_INFO[provider].name;
    39	  const request = keyCheckRequest(provider, apiKey);
    40	  let response: Response;
    41	  try {
    42	    response = await fetchImpl(request.url, { method: 'GET', headers: request.headers, signal: AbortSignal.timeout(CHECK_DEADLINE_MS) });
    43	  } catch {
    44	    return { ok: false, kind: 'network', message: `Could not reach ${name}.` };
    45	  }
    46	  if (response.ok) return { ok: true, message: 'The key works.' };
    47	  if (response.status === 401 || response.status === 403) return { ok: false, kind: 'rejected', message: `${name} rejected the key.` };
    48	  // Gemini answers a malformed key with 400 API_KEY_INVALID.
    49	  if (response.status === 400 && provider === 'gemini') return { ok: false, kind: 'rejected', message: `${name} rejected the key.` };
    50	  if (response.status === 429) return { ok: false, kind: 'failed', message: `${name} is busy. Try again in a moment.` };
    51	  if (response.status >= 500) return { ok: false, kind: 'failed', message: `${name} is having trouble. Try again in a moment.` };
    52	  return { ok: false, kind: 'failed', message: `${name} could not check the key.` };
    53	}
