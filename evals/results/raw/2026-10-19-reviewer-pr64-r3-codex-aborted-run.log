    81	    private static func stripFence(_ text: String) -> String {
    82	        guard text.hasPrefix("```"), text.hasSuffix("```"), text.count >= 6 else { return text }
    83	        var body = String(text.dropLast(3))
    84	        body.removeFirst(3)
    85	        // The opening fence may carry a language tag on its own line.
    86	        if let newline = body.firstIndex(of: "\n"),
    87	           body[body.startIndex..<newline].allSatisfy({ $0.isLetter || $0.isNumber }) {
    88	            body = String(body[body.index(after: newline)...])
    89	        }
    90	        return body.trimmingCharacters(in: .whitespacesAndNewlines)
    91	    }
