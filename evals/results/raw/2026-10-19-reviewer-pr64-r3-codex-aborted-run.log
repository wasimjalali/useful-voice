    46	function readState(dir: string, version: ParakeetVersion): ParakeetState {
    47	  try {
    48	    const manifest = JSON.parse(fs.readFileSync(path.join(dir, MANIFEST), 'utf8')) as Manifest;
    49	    if (manifest.version !== version) return { status: 'notDownloaded' };
    50	    let total = 0;
    51	    for (const name of PARAKEET_FILES) {
    52	      const expected = manifest.files?.[name];
    53	      const actual = fs.statSync(path.join(dir, name)).size;
    54	      if (typeof expected !== 'number' || expected <= 0 || actual !== expected) return { status: 'notDownloaded' };
    55	      total += actual;
    56	    }
    57	    return { status: 'ready', sizeBytes: total };
    58	  } catch {
    59	    return { status: 'notDownloaded' };
    60	  }
    61	}
