   234	/// The result of one formatting attempt. Anything but `.formatted` means the
   235	/// unformatted transcript is delivered.
   236	public enum FormatterOutcome: Equatable, Sendable {
   237	    case formatted(String)
   238	    /// Not attempted (too short, no key).
   239	    case skipped(String)
   240	    /// Attempted and unusable: error, timeout, guard reject.
   241	    case failed(String)
   242	
   243	    public var text: String? {
   244	        if case .formatted(let text) = self { return text }
   245	        return nil
   246	    }
   247	}
