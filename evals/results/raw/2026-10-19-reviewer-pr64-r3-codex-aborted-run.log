   484	  /** The archive holds one folder; accept the files at the top level too. */
   485	  private async findModelFolder(tmp: string): Promise<string> {
   486	    const candidates = [tmp];
   487	    for (const entry of await fsp.readdir(tmp, { withFileTypes: true })) {
   488	      if (entry.isDirectory()) candidates.push(path.join(tmp, entry.name));
   489	    }
   490	    for (const dir of candidates) {
   491	      if (fs.existsSync(path.join(dir, PARAKEET_FILES[0]))) return dir;
   492	    }
   493	    throw new Error('The download is missing model files. Try again.');
   494	  }
   495	
   496	  private async verify(dir: string, version: ParakeetVersion): Promise<Manifest> {
   497	    const files: Record<string, number> = {};
   498	    for (const name of PARAKEET_FILES) {
   499	      let size = 0;
   500	      try {
   501	        size = (await fsp.stat(path.join(dir, name))).size;
   502	      } catch {
   503	        size = 0;
   504	      }
   505	      if (size <= 0) throw new Error(`The download is missing ${name}. Try again.`);
   506	      files[name] = size;
   507	    }
   508	    return { version, files };
   509	  }
   510	}
     1	/**
     2	 * Runs Parakeet recognition inside an Electron utilityProcess so the 600+ MB model never
     3	 * blocks the main process. Started by parakeet.ts; one request at a time, answered in order.
     4	 */
     5	import { createRequire } from 'node:module';
     6	import os from 'node:os';
     7	import path from 'node:path';
     8	import type { ParakeetWorkerRequest, ParakeetWorkerResponse } from '../core/models/parakeetProtocol.js';
     9	
    10	interface Port {
    11	  on(event: 'message', listener: (event: { data: unknown }) => void): void;
    12	  postMessage(message: unknown): void;
    13	}
    14	
    15	interface Recognizer {
    16	  createStream(): { acceptWaveform(w: { sampleRate: number; samples: Float32Array }): void };
    17	  decode(stream: unknown): void;
    18	  getResult(stream: unknown): { text: string };
    19	}
    20	
    21	const loadModule = createRequire(import.meta.url);
    22	const port = (process as unknown as { parentPort?: Port }).parentPort;
    23	
    24	let loaded: { dir: string; recognizer: Recognizer } | null = null;
    25	
    26	function recognizerFor(dir: string): Recognizer {
    27	  if (loaded?.dir === dir) return loaded.recognizer;
    28	  loaded = null;
    29	  const sherpa = loadModule('sherpa-onnx-node') as {
    30	    OfflineRecognizer: new (config: unknown) => Recognizer;
    31	  };
    32	  const recognizer = new sherpa.OfflineRecognizer({
    33	    featConfig: { sampleRate: 16000, featureDim: 80 },
    34	    modelConfig: {
    35	      transducer: {
    36	        encoder: path.join(dir, 'encoder.int8.onnx'),
    37	        decoder: path.join(dir, 'decoder.int8.onnx'),
    38	        joiner: path.join(dir, 'joiner.int8.onnx'),
    39	      },
    40	      tokens: path.join(dir, 'tokens.txt'),
    41	      numThreads: Math.max(1, Math.min(4, os.cpus().length)),
    42	      provider: 'cpu',
    43	      debug: 0,
    44	      modelType: 'nemo_transducer',
    45	    },
    46	  });
    47	  loaded = { dir, recognizer };
    48	  return recognizer;
    49	}
    50	
    51	function handle(request: ParakeetWorkerRequest): ParakeetWorkerResponse {
    52	  try {
    53	    const t0 = Date.now();
    54	    const recognizer = recognizerFor(request.modelDir);
    55	    const t1 = Date.now();
    56	    if (request.loadOnly) return { id: request.id, ok: true, text: '', loadMs: t1 - t0, decodeMs: 0 };
    57	    const stream = recognizer.createStream();
    58	    stream.acceptWaveform({ sampleRate: request.sampleRate, samples: request.samples });
    59	    recognizer.decode(stream);
    60	    const text = recognizer.getResult(stream).text.trim();
    61	    return { id: request.id, ok: true, text, loadMs: t1 - t0, decodeMs: Date.now() - t1 };
    62	  } catch (error) {
    63	    return { id: request.id, ok: false, error: error instanceof Error ? error.message : String(error) };
    64	  }
    65	}
    66	
    67	if (port) {
    68	  port.on('message', (event) => {
    69	    port.postMessage(handle(event.data as ParakeetWorkerRequest));
    70	  });
    71	}

