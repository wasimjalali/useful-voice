   984	
   985	export function describeRecordingFailure(error: unknown): string {
   986	  const raw = describe(error).toLowerCase();
   987	  if (raw.includes('permission') || raw.includes('denied') || raw.includes('notallowed')) {
   988	    return 'Microphone access is blocked. Turn it on in Windows Settings > Privacy & security > Microphone.';
   989	  }
   990	  if (raw.includes('notfound') || raw.includes('devicenotfound')) {
   991	    return 'No microphone was found. Connect one and check Windows Settings > System > Sound > Input.';
   992	  }
   993	  if (raw.includes('notreadable') || raw.includes('trackstarterror')) {
   994	    return 'The microphone is in use by another app. Close it, or pick a different input device.';
   995	  }
   996	  return `Recording could not start: ${describe(error)}`;
   997	}
