   425	  private async fetchArchive(version: ParakeetVersion, partial: string, signal: AbortSignal): Promise<void> {
   426	    let have = 0;
   427	    try {
   428	      have = (await fsp.stat(partial)).size;
   429	    } catch {
   430	      have = 0;
   431	    }
   432	    let response: Response;
   433	    try {
   434	      response = await this.fetchImpl(parakeetArchiveUrl(version), {
   435	        signal,
   436	        headers: have > 0 ? { Range: `bytes=${have}-` } : {},
   437	      });
   438	    } catch (e) {
   439	      if (signal.aborted) throw new Cancelled();
   440	      throw new Error(`Couldn't reach the download server. Check your connection and try again. (${errorMessage(e)})`);
   441	    }
   442	    if (response.status === 416 && have > 0) {
   443	      // The partial file is not usable for this archive; start over.
   444	      await fsp.rm(partial, { force: true });
   445	      return this.fetchArchive(version, partial, signal);
   446	    }
   447	    if (response.status !== 200 && response.status !== 206) {
   448	      throw new Error(`The download failed (HTTP ${response.status}). Try again later.`);
   449	    }
   450	    const resumed = response.status === 206 && have > 0;
   451	    if (!resumed) have = 0;
   452	    const length = Number(response.headers.get('content-length'));
   453	    const total = Number.isFinite(length) && length > 0 ? have + length : null;
   454	    if (!response.body) throw new Error('The download server sent no data.');
   455	
   456	    const handle = await fsp.open(partial, resumed ? 'a' : 'w');
   457	    let received = have;
   458	    let lastEmit = 0;
   459	    try {
   460	      const reader = response.body.getReader();
   461	      for (;;) {
   462	        const { done, value } = await reader.read();
   463	        if (done) break;
   464	        await handle.write(value);
   465	        received += value.byteLength;
   466	        const now = Date.now();
   467	        if (now - lastEmit >= 200) {
   468	          lastEmit = now;
   469	          this.set(version, { status: 'downloading', progress: total ? Math.min(1, received / total) : null });
   470	        }
   471	      }
   472	    } catch (e) {
   473	      if (signal.aborted) throw new Cancelled();
   474	      throw new Error(`The download was interrupted. Try again to continue. (${errorMessage(e)})`);
   475	    } finally {
   476	      await handle.close();
   477	    }
   478	    if (total !== null && received !== total) {
   479	      throw new Error('The download was cut short. Try again to continue.');
   480	    }
   481	    this.set(version, { status: 'downloading', progress: 1 });
   482	  }
