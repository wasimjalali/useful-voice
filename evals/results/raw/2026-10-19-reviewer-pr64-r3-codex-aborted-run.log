   980	export function classifyRecordingFailure(error: unknown): DictationError {
   981	  // Every way the microphone can fail to start is fixed in the same place.
   982	  return { kind: 'micUnavailable', message: describeRecordingFailure(error), fix: 'openMicrophoneSettings' };
