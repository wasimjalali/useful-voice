    62	        text.replacingOccurrences(of: "\u{2019}", with: "'").replacingOccurrences(of: "\u{2018}", with: "'")
    63	    }
    64	
    65	    /// "um, sure ..." -> "sure ...": the filler the formatter would drop anyway.
    66	    private static func withoutLeadingFillers(_ text: String) -> String {
    67	        var rest = Substring(text.trimmingCharacters(in: .whitespacesAndNewlines))
    68	        var changed = true
    69	        while changed {
    70	            changed = false
    71	            for filler in leadingFillers where rest.hasPrefix(filler) {
    72	                let after = rest.dropFirst(filler.count)
    73	                guard after.first.map({ !$0.isLetter && !$0.isNumber }) ?? true else { continue }
    74	                rest = after.drop(while: { $0 == "," || $0 == "." || $0.isWhitespace })
    75	                changed = true
    76	            }
    77	        }
    78	        return String(rest)
    79	    }
