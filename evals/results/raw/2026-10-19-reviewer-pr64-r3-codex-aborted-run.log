   128	export function installProviderStubs(userData: string): void {
   129	  const real = globalThis.fetch.bind(globalThis);
   130	  const log = (host: StubHost, line: string): void => {
   131	    try {
   132	      appendFileSync(path.join(userData, 'e2e.log'), `${new Date().toISOString()} ${host} ${line}\n`);
   133	    } catch {
   134	      // The log is a diagnostic aid only.
   135	    }
   136	  };
   137	  globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {
   138	    const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
   139	    const host = HOSTS.find(([prefix]) => url.startsWith(prefix))?.[1];
   140	    if (!host) return real(input, init);
   141	    const key = keyOf(host, new Headers(init?.headers));
   142	    log(host, `${(init?.method ?? 'GET').toUpperCase()} ${url}`);
   143	    if (key.startsWith('offline')) throw new TypeError('fetch failed');
   144	    if (key.startsWith('slow')) await new Promise((resolve) => setTimeout(resolve, 1500));
   145	    if (!key.startsWith('valid') && !key.startsWith('slow')) return refused(host);
   146	    return answer(host, init);
   147	  }) as typeof fetch;
   148	}
