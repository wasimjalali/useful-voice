    53	    /// `text` begins with `phrase` as whole words: "i have" matches "I have it" but not
    54	    /// "I haven't", and "sure" matches "Sure, ok" but not "Surely".
    55	    private static func startsWithPhrase(_ text: String, _ phrase: String) -> Bool {
    56	        guard text.hasPrefix(phrase) else { return false }
    57	        guard let next = text.dropFirst(phrase.count).first else { return true }
    58	        return !(next.isLetter || next.isNumber || next == "'")
    59	    }
