   339	    struct FormatterError: Error { let reason: String }
   340	
   341	    private func run(text: String, vocabulary: [String], key: String) async throws -> String {
   342	        switch model.provider {
   343	        case "gemini":
   344	            let request = try FormatterRequest.gemini(model: model, apiKey: key, text: text, vocabulary: vocabulary)
   345	            let data = try await send(request)
   346	            return try Self.unwrap(FormatterRequest.parseGemini(data))
   347	        case "anthropic":
   348	            var request = try FormatterRequest.anthropic(model: model, apiKey: key, text: text, vocabulary: vocabulary)
   349	            do {
   350	                let data = try await send(request)
   351	                return try Self.unwrap(FormatterRequest.parseAnthropic(data))
   352	            } catch let error as HTTPFailure where error.status == 400 && error.body.lowercased().contains("thinking") {
   353	                // The model rejected the thinking field: once more without it.
   354	                request = try FormatterRequest.anthropic(model: model, apiKey: key, text: text,
   355	                                                         vocabulary: vocabulary, includeThinkingField: false)
   356	                let data = try await send(request)
   357	                return try Self.unwrap(FormatterRequest.parseAnthropic(data))
   358	            } catch let error as HTTPFailure {
   359	                throw FormatterError(reason: "HTTP \(error.status)")
   360	            }
   361	        default:
   362	            throw FormatterError(reason: "unknown provider")
   363	        }
   364	    }
   365	
   366	    private static func unwrap(_ reply: FormatterRequest.Reply) throws -> String {
   367	        switch reply {
   368	        case .text(let text): return text
   369	        case .failure(let reason): throw FormatterError(reason: reason)
   370	        }
   371	    }
   372	
   373	    struct HTTPFailure: Error { let status: Int; let body: String }
   374	
   375	    private func send(_ request: URLRequest) async throws -> Data {
   376	        let (data, response) = try await session.data(for: request)
   377	        guard let http = response as? HTTPURLResponse else { throw FormatterError(reason: "bad response") }
   378	        guard (200..<300).contains(http.statusCode) else {
   379	            throw HTTPFailure(status: http.statusCode, body: String(decoding: data.prefix(2000), as: UTF8.self))
   380	        }
   381	        return data
   382	    }
   383	
   384	    /// A wall-clock deadline that also passes the caller's cancellation down.
   385	    private func withDeadline<T: Sendable>(seconds: TimeInterval, timedOut: DeadlineFlag,
   386	                                           _ work: @escaping @Sendable () async throws -> T) async throws -> T {
   387	        let task = Task<T, Error> { try await work() }
   388	        let timer = Task<Void, Never> {
   389	            try? await Task.sleep(nanoseconds: UInt64(seconds * 1_000_000_000))
   390	            guard !Task.isCancelled else { return }
   391	            timedOut.set()
   392	            task.cancel()
   393	        }
   394	        defer { timer.cancel() }
   395	        return try await withTaskCancellationHandler {
   396	            try await task.value
   397	        } onCancel: {
   398	            task.cancel()
   399	        }
   400	    }
   401	}
   402	
   403	/// Set when the deadline (not the person) ended the request.
   404	final class DeadlineFlag: @unchecked Sendable {
   405	    private let lock = NSLock()
   406	    private var value = false
   407	    var isSet: Bool { lock.lock(); defer { lock.unlock() }; return value }
   408	    func set() { lock.lock(); value = true; lock.unlock() }
   409	}

