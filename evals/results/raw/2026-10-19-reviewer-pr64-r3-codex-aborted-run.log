    15	const PATTERNS: RegExp[] = [
    16	  /\bsk-[A-Za-z0-9_-]{8,}/g,
    17	  /\bAIza[0-9A-Za-z_-]{16,}/g,
    18	  /\bxi-[A-Za-z0-9_-]{8,}/g,
    19	  /\bBearer\s+[A-Za-z0-9._~+/=-]{8,}/gi,
    20	  /\b[A-Za-z0-9_-]{32,}\b/g,
