   434	
   435	  let lastError: ProviderError | undefined;
   436	  for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
   437	    if (options.signal?.aborted) {
   438	      throw new ProviderError('cancelled', 'Transcription was cancelled.');
   439	    }
   440	    try {
   441	      return await attemptOnce(request, audio, doFetch, options.signal, config.smartFormat ? hint.language : null);
   442	    } catch (error) {
   443	      const providerError = toProviderError(error);
   444	      lastError = providerError;
   445	      if (!providerError.isTransient || attempt === maxAttempts) throw providerError;
   446	      // Cap the server's own guidance so a large Retry-After cannot stall the
   447	      // user's dictation for minutes.
   448	      const delaySeconds = Math.min(providerError.retryAfterSeconds ?? 0.5 * 3 ** (attempt - 1), 8);
   449	      await sleep(delaySeconds * 1000);
   450	    }
   451	  }
   452	  throw lastError ?? new ProviderError('transport', 'Transcription failed.');
   453	}
