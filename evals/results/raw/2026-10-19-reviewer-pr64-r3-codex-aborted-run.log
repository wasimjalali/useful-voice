    97	async function defaultSpawnWorker(): Promise<ParakeetWorkerHandle> {
    98	  const { utilityProcess } = await import('electron');
    99	  const script = path.join(path.dirname(fileURLToPath(import.meta.url)), 'parakeetWorker.js');
   100	  const child = utilityProcess.fork(script, [], { serviceName: 'Parakeet' });
   101	  return {
   102	    postMessage: (m) => child.postMessage(m),
   103	    onMessage: (l) => child.on('message', (m: ParakeetWorkerResponse) => l(m)),
   104	    onExit: (l) => child.once('exit', (code) => l(`exit code ${code}`)),
   105	    kill: () => void child.kill(),
   106	  };
   107	}
