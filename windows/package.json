{
  "name": "useful-voice-windows",
  "productName": "Useful Voice",
  "version": "0.1.0",
  "description": "Voice-to-text dictation for Windows, powered by Deepgram Nova-3.",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "author": {
    "name": "Useful Build"
  },
  "license": "SEE LICENSE IN ../LICENSE",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:icon": "node scripts/make-icon.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build && electron .",
    "self-test": "npm run build && electron . --self-test --report=self-test-report.txt",
    "e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm test && npm run build && npm run self-test",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.2",
    "electron": "43.7.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "ai.useful.voice",
    "productName": "Useful Voice",
    "copyright": "Copyright © Useful Build",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/@node-llama-cpp/*/bins/**/*",
      "node_modules/@node-llama-cpp/win-x64/bins/**/*",
      "!node_modules/node-llama-cpp/llama/localBuilds/**/*",
      "!node_modules/node-llama-cpp/llama/gitRelease.bundle"
    ],
    "extraResources": [
      {
        "from": "build/tray",
        "to": "tray"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "wasimjalali",
        "repo": "useful-voice-releases",
        "releaseType": "release"
      }
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "publisherName": "Useful Build"
      },
      "legalTrademarks": "Useful Voice",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "guid": "cfa29547-fa82-5f74-b344-dfe1c5823243",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Useful Voice",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/bins/**/*",
      "node_modules/@node-llama-cpp/*/bins/**/*"
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "node-llama-cpp": "3.22.1"
  }
}
