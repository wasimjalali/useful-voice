{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["src/main/**/*.ts", "src/core/**/*.ts"],
  "exclude": ["src/renderer/**", "src/preload/**"]
}
